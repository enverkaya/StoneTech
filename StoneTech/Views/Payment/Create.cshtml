@using StoneTech.Models.Payment
@using StoneTech.Enums
@model PaymentCreateViewModel

@{
    ViewData["Title"] = "Ödeme Al";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>
                <h1>Ödeme Al</h1>

                <p class="subtitle">
                    İş emrine ait müşteri ödemesini kaydedin.
                </p>
            </div>

            <div class="page-header__actions">

                @if (User.IsInRole("Accountant"))
                {
                    <a asp-controller="Customer"
                       asp-action="Debtors"
                       class="m-btn m-btn--ghost">
                        <i class="fa-solid fa-arrow-left"></i>
                        Borçlu Müşteriler
                    </a>
                }
                else
                {
                    <a asp-controller="WorkOrder"
                       asp-action="Details"
                       asp-route-id="@Model.WorkOrderId"
                       class="m-btn m-btn--ghost">
                        <i class="fa-solid fa-arrow-left"></i>
                        İş Emrine Dön
                    </a>
                }

            </div>

        </div>

        <!-- Form doğrulama hataları -->
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <form asp-controller="Payment"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <!-- İş emrinin veritabanı kimliği -->
            <input asp-for="WorkOrderId"
                   type="hidden" />

            <div class="row">

                <!-- Sol taraf -->
                <div class="col-lg-8">

                    <!-- Ödeme bilgileri -->
                    <div class="m-card mb-4">

                        <div class="card-header">
                            <strong>Ödeme Bilgileri</strong>
                        </div>

                        <div class="card-body">

                            <div class="row">

                                <!-- Ödeme tutarı -->
                                <div class="col-md-6 mb-3">

                                    <label asp-for="Amount"
                                           class="form-control-label">
                                        Ödeme Tutarı
                                    </label>

                                    <div class="input-group">

                                        <input asp-for="Amount"
                                               type="number"
                                               step="0.01"
                                               min="0.01"
                                               class="form-control"
                                               placeholder="0,00" />

                                        <span class="input-group-text">
                                            ₺
                                        </span>

                                    </div>

                                    <span asp-validation-for="Amount"
                                          class="text-danger">
                                    </span>

                                </div>

                                <!-- Ödeme tarihi -->
                                <div class="col-md-6 mb-3">

                                    <label asp-for="PaymentDate"
                                           class="form-control-label">
                                        Ödeme Tarihi
                                    </label>

                                    <input asp-for="PaymentDate"
                                           type="date"
                                           class="form-control" />

                                    <span asp-validation-for="PaymentDate"
                                          class="text-danger">
                                    </span>

                                </div>

                                <!-- Ödeme yöntemi -->
                                <div class="col-md-6 mb-3">

                                    <label asp-for="PaymentMethod"
                                           class="form-control-label">
                                        Ödeme Yöntemi
                                    </label>

                                    <select asp-for="PaymentMethod"
                                            class="form-select">

                                        <option value="@((int)PaymentMethod.Cash)">
                                            Nakit
                                        </option>

                                        <option value="@((int)PaymentMethod.CreditCard)">
                                            Kredi / Banka Kartı
                                        </option>

                                        <option value="@((int)PaymentMethod.BankTransfer)">
                                            Havale / EFT
                                        </option>

                                    </select>

                                    <span asp-validation-for="PaymentMethod"
                                          class="text-danger">
                                    </span>

                                </div>

                                <!-- Açıklama -->
                                <div class="col-12 mb-3">

                                    <label asp-for="Description"
                                           class="form-control-label">
                                        Açıklama
                                    </label>

                                    <textarea asp-for="Description"
                                              class="form-control"
                                              rows="4"
                                              maxlength="500"
                                              placeholder="Ödemeyle ilgili açıklama..."></textarea>

                                    <span asp-validation-for="Description"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Sağ taraf -->
                <div class="col-lg-4">

                    <!-- İş emri özeti -->
                    <div class="m-card mb-4">

                        <div class="card-header">
                            <strong>İş Emri Özeti</strong>
                        </div>

                        <div class="card-body">

                            <!-- İş emri numarası -->
                            <div class="mb-3">

                                <small class="text-muted">
                                    İş Emri No
                                </small>

                                <div>
                                    <strong>
                                        @Model.WorkOrderNumber
                                    </strong>
                                </div>

                            </div>

                            <!-- Müşteri -->
                            <div class="mb-3">

                                <small class="text-muted">
                                    Müşteri
                                </small>

                                <div>
                                    <strong>
                                        @Model.CustomerName
                                    </strong>
                                </div>

                            </div>

                            <hr />

                            <!-- İş emri toplamı -->
                            <div class="d-flex justify-content-between mb-3">

                                <span>
                                    Genel Toplam
                                </span>

                                <strong>
                                    @Model.WorkOrderTotal.ToString("N2") ₺
                                </strong>

                            </div>

                            <!-- Ödenen -->
                            <div class="d-flex justify-content-between mb-3">

                                <span>
                                    Ödenen
                                </span>

                                <strong class="text-success">
                                    @Model.TotalPaid.ToString("N2") ₺
                                </strong>

                            </div>

                            <!-- Kalan borç -->
                            <div class="d-flex justify-content-between">

                                <span>
                                    Kalan Borç
                                </span>

                                <strong class="text-danger">
                                    @Model.RemainingAmount.ToString("N2") ₺
                                </strong>

                            </div>

                        </div>

                    </div>

                    <!-- İşlem -->
                    <div class="m-card">

                        <div class="card-header">
                            <strong>İşlem</strong>
                        </div>

                        <div class="card-body">

                            <button type="submit"
                                    class="m-btn m-btn--primary w-100">

                                <i class="fa-solid fa-money-bill-wave"></i>
                                Ödemeyi Kaydet

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </form>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
