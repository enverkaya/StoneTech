@using StoneTech.Models.Employee
@using StoneTech.Enums
@model EmployeeDetailsViewModel

@{
    ViewData["Title"] = "Personel Detayı";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>

                <h1>Personel Detayı</h1>

                <p class="subtitle">
                    Personelin kayıt, çalışma ve sistem hesabı bilgilerini görüntüleyin.
                </p>

            </div>

            <div class="page-header__actions">

                <a asp-controller="Employee"
                   asp-action="Index"
                   class="m-btn m-btn--ghost">

                    <i class="fa-solid fa-arrow-left"></i>
                    Personellere Dön

                </a>

                <a asp-controller="Employee"
                   asp-action="Edit"
                   asp-route-id="@Model.EmployeeId"
                   class="m-btn m-btn--primary">

                    <i class="fa-solid fa-pen-to-square"></i>
                    Düzenle

                </a>

            </div>

        </div>

        <!-- Başarı mesajı -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Hata mesajı -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="row">

            <!-- Personel bilgileri -->
            <div class="col-lg-8">

                <section class="m-card"
                         style="padding: 20px; margin-bottom: 20px;">

                    <div class="mb-4">

                        <h4 style="margin-bottom: 5px;">
                            Personel Bilgileri
                        </h4>

                        <p class="text-muted"
                           style="margin-bottom: 0;">
                            Personelin temel iletişim ve çalışma bilgileri.
                        </p>

                    </div>

                    <div class="row">

                        <!-- Ad soyad -->
                        <div class="col-md-6">

                            <div class="mb-4">

                                <span class="text-muted"
                                      style="display: block;
                                             font-size: 12px;
                                             margin-bottom: 5px;">
                                    Ad Soyad
                                </span>

                                <strong>
                                    @Model.FullName
                                </strong>

                            </div>

                        </div>

                        <!-- Görev -->
                        <div class="col-md-6">

                            <div class="mb-4">

                                <span class="text-muted"
                                      style="display: block;
                                             font-size: 12px;
                                             margin-bottom: 5px;">
                                    Görev
                                </span>

                                <strong>
                                    @Model.Position
                                </strong>

                            </div>

                        </div>

                        <!-- Telefon -->
                        <div class="col-md-6">

                            <div class="mb-4">

                                <span class="text-muted"
                                      style="display: block;
                                             font-size: 12px;
                                             margin-bottom: 5px;">
                                    Telefon
                                </span>

                                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                                {
                                    <span>
                                        @Model.Phone
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }

                            </div>

                        </div>

                        <!-- E-posta -->
                        <div class="col-md-6">

                            <div class="mb-4">

                                <span class="text-muted"
                                      style="display: block;
                                             font-size: 12px;
                                             margin-bottom: 5px;">
                                    E-posta
                                </span>

                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                {
                                    <span>
                                        @Model.Email
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }

                            </div>

                        </div>

                        <!-- İşe giriş tarihi -->
                        <div class="col-md-6">

                            <div class="mb-4">

                                <span class="text-muted"
                                      style="display: block;
                                             font-size: 12px;
                                             margin-bottom: 5px;">
                                    İşe Giriş Tarihi
                                </span>

                                <span>
                                    @Model.HireDate.ToString("dd.MM.yyyy")
                                </span>

                            </div>

                        </div>

                        <!-- İşten ayrılma tarihi -->
                        <div class="col-md-6">

                            <div class="mb-4">

                                <span class="text-muted"
                                      style="display: block;
                                             font-size: 12px;
                                             margin-bottom: 5px;">
                                    İşten Ayrılma Tarihi
                                </span>

                                @if (Model.TerminationDate.HasValue)
                                {
                                    <span>
                                        @Model.TerminationDate.Value.ToString("dd.MM.yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }

                            </div>

                        </div>

                        <!-- Sisteme kayıt tarihi -->
                        <div class="col-md-6">

                            <div class="mb-4">

                                <span class="text-muted"
                                      style="display: block;
                                             font-size: 12px;
                                             margin-bottom: 5px;">
                                    Kayıt Tarihi
                                </span>

                                <span>
                                    @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                                </span>

                            </div>

                        </div>

                        <!-- Personel durumu -->
                        <div class="col-md-6">

                            <div class="mb-4">

                                <span class="text-muted"
                                      style="display: block;
                                             font-size: 12px;
                                             margin-bottom: 5px;">
                                    Personel Durumu
                                </span>

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Pasif
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                    <!-- Personel notu -->
                    <div>

                        <span class="text-muted"
                              style="display: block;
                                     font-size: 12px;
                                     margin-bottom: 8px;">
                            Not
                        </span>

                        @if (!string.IsNullOrWhiteSpace(Model.Note))
                        {
                            <div style="white-space: pre-wrap;">
                                @Model.Note
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">
                                Personelle ilgili not bulunmuyor.
                            </span>
                        }

                    </div>

                </section>

                <!-- Sistem hesabı -->
                <section class="m-card"
                         style="padding: 20px;">

                    <div class="mb-4">

                        <h4 style="margin-bottom: 5px;">
                            Sistem Hesabı
                        </h4>

                        <p class="text-muted"
                           style="margin-bottom: 0;">
                            Personelin StoneTech sistemine giriş hesabı bilgileri.
                        </p>

                    </div>

                    @if (Model.HasUserAccount)
                    {
                        <div class="row">

                            <!-- Kullanıcı adı -->
                            <div class="col-md-6">

                                <div class="mb-4">

                                    <span class="text-muted"
                                          style="display: block;
                                                     font-size: 12px;
                                                     margin-bottom: 5px;">
                                        Kullanıcı Adı
                                    </span>

                                    <strong>
                                        @Model.Username
                                    </strong>

                                </div>

                            </div>

                            <!-- Kullanıcı hesabı durumu -->
                            <div class="col-md-6">

                                <div class="mb-4">

                                    <span class="text-muted"
                                          style="display: block;
                                                     font-size: 12px;
                                                     margin-bottom: 5px;">
                                        Hesap Durumu
                                    </span>

                                    @if (Model.IsUserActive == true)
                                    {
                                        <span class="badge bg-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Pasif
                                        </span>
                                    }

                                </div>

                            </div>

                            <!-- Kullanıcı rolü -->
                            <div class="col-md-6">

                                <div class="mb-0">

                                    <span class="text-muted"
                                          style="display: block;
                                                     font-size: 12px;
                                                     margin-bottom: 5px;">
                                        Sistem Rolü
                                    </span>

                                    @if (Model.Role.HasValue)
                                    {
                                        switch (Model.Role.Value)
                                        {
                                            case UserRole.Admin:
                                                <span class="badge bg-danger">
                                                    Admin
                                                </span>
                                                break;

                                            case UserRole.Manager:
                                                <span class="badge bg-primary">
                                                    Yönetici
                                                </span>
                                                break;

                                            case UserRole.Sales:
                                                <span class="badge bg-info">
                                                    Satış
                                                </span>
                                                break;

                                            case UserRole.Accountant:
                                                <span class="badge bg-warning text-dark">
                                                    Muhasebe
                                                </span>
                                                break;

                                            case UserRole.Workshop:
                                                <span class="badge bg-secondary">
                                                    Atölye
                                                </span>
                                                break;
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </div>

                            </div>

                            <!-- Son giriş tarihi -->
                            <div class="col-md-6">

                                <div class="mb-0">

                                    <span class="text-muted"
                                          style="display: block;
                                                     font-size: 12px;
                                                     margin-bottom: 5px;">
                                        Son Giriş
                                    </span>

                                    @if (Model.LastLoginDate.HasValue)
                                    {
                                        <span>
                                            @Model.LastLoginDate.Value.ToString("dd.MM.yyyy HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Henüz giriş yapılmadı
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>
                    }
                    else
                    {
                        <!-- Personele henüz kullanıcı hesabı açılmamışsa gösterilir -->
                        <div class="empty-state">

                            <span class="empty-state__icon">

                                <i class="fa-solid fa-user-lock"></i>

                            </span>

                            <h3 class="empty-state__title">
                                Sistem hesabı bulunmuyor
                            </h3>

                            <p class="empty-state__text">
                                Bu personel için henüz StoneTech kullanıcı hesabı oluşturulmamış.
                            </p>

                        </div>
                    }

                </section>

            </div>

            <!-- Personel profil alanı -->
            <div class="col-lg-4">

                <section class="m-card"
                         style="padding: 20px;
                                margin-bottom: 20px;
                                text-align: center;">

                    <!-- Profil fotoğrafı -->
                    <div style="display: flex;
                                justify-content: center;
                                margin-bottom: 15px;">

                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 alt="@Model.FullName"
                                 style="width: 150px;
                                            height: 150px;
                                            border-radius: 50%;
                                            object-fit: cover;">
                        }
                        else
                        {
                            <div style="width: 150px;
                                            height: 150px;
                                            border-radius: 50%;
                                            background: #f1f3f5;
                                            display: flex;
                                            align-items: center;
                                            justify-content: center;
                                            font-size: 50px;
                                            color: #8b95a1;">

                                <i class="fa-solid fa-user"></i>

                            </div>
                        }

                    </div>

                    <!-- Personel adı -->
                    <h3 style="margin-bottom: 5px;">
                        @Model.FullName
                    </h3>

                    <!-- Personel görevi -->
                    <p class="text-muted"
                       style="margin-bottom: 15px;">
                        @Model.Position
                    </p>

                    <!-- Personel aktiflik durumu -->
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">
                            Aktif Personel
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Pasif Personel
                        </span>
                    }

                </section>

                <!-- Çalışma özeti -->
                <section class="m-card"
                         style="padding: 20px;">

                    <h4 style="margin-bottom: 20px;">
                        Çalışma Bilgisi
                    </h4>

                    <!-- İşe giriş -->
                    <div style="display: flex;
                                justify-content: space-between;
                                align-items: center;
                                margin-bottom: 15px;">

                        <span class="text-muted">
                            İşe Giriş
                        </span>

                        <strong>
                            @Model.HireDate.ToString("dd.MM.yyyy")
                        </strong>

                    </div>

                    <!-- İşten ayrılma -->
                    <div style="display: flex;
                                justify-content: space-between;
                                align-items: center;
                                margin-bottom: 15px;">

                        <span class="text-muted">
                            İşten Ayrılma
                        </span>

                        @if (Model.TerminationDate.HasValue)
                        {
                            <strong>
                                @Model.TerminationDate.Value.ToString("dd.MM.yyyy")
                            </strong>
                        }
                        else
                        {
                            <span class="text-muted">
                                -
                            </span>
                        }

                    </div>

                    <!-- Sistem hesabı -->
                    <div style="display: flex;
                                justify-content: space-between;
                                align-items: center;">

                        <span class="text-muted">
                            Sistem Hesabı
                        </span>

                        @if (Model.HasUserAccount)
                        {
                            <span class="badge bg-primary">
                                Var
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Yok
                            </span>
                        }

                    </div>

                </section>

            </div>

        </div>

    </div>
</div>