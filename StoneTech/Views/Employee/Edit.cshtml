@using StoneTech.Models.Employee
@model EmployeeEditViewModel

@{
    ViewData["Title"] = "Personel Düzenle";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>

                <h1>Personel Düzenle</h1>

                <p class="subtitle">
                    Personelin kayıtlı bilgilerini güncelleyin.
                </p>

            </div>

            <div class="page-header__actions">

                <a asp-controller="Employee"
                   asp-action="Index"
                   class="m-btn m-btn--ghost">

                    <i class="fa-solid fa-arrow-left"></i>
                    Personellere Dön

                </a>

            </div>

        </div>

        <!-- Personel düzenleme formu -->
        <form asp-controller="Employee"
              asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <!-- Düzenlenecek personelin Id bilgisi -->
            <input asp-for="EmployeeId"
                   type="hidden" />

            <!-- Mevcut profil fotoğrafının yolu -->
            <input asp-for="CurrentImageUrl"
                   type="hidden" />

            <!-- Genel doğrulama hataları -->
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>

            <div class="row">

                <!-- Personel bilgileri -->
                <div class="col-lg-8">

                    <section class="m-card"
                             style="padding: 20px; margin-bottom: 20px;">

                        <div class="mb-4">

                            <h4 style="margin-bottom: 5px;">
                                Personel Bilgileri
                            </h4>

                            <p class="text-muted"
                               style="margin-bottom: 0;">
                                Personelin iletişim, görev ve çalışma bilgilerini güncelleyin.
                            </p>

                        </div>

                        <div class="row">

                            <!-- Ad soyad -->
                            <div class="col-md-6">

                                <div class="mb-3">

                                    <label asp-for="FullName"
                                           class="form-label">

                                        Ad Soyad
                                        <span class="text-danger">*</span>

                                    </label>

                                    <input asp-for="FullName"
                                           class="form-control"
                                           autocomplete="off" />

                                    <span asp-validation-for="FullName"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                            <!-- Görev -->
                            <div class="col-md-6">

                                <div class="mb-3">

                                    <label asp-for="Position"
                                           class="form-label">

                                        Görev
                                        <span class="text-danger">*</span>

                                    </label>

                                    <input asp-for="Position"
                                           class="form-control"
                                           placeholder="Örn: Usta, Satış Personeli"
                                           autocomplete="off" />

                                    <span asp-validation-for="Position"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                            <!-- Telefon -->
                            <div class="col-md-6">

                                <div class="mb-3">

                                    <label asp-for="Phone"
                                           class="form-label">
                                        Telefon
                                    </label>

                                    <input asp-for="Phone"
                                           class="form-control"
                                           placeholder="05xx xxx xx xx"
                                           autocomplete="off" />

                                    <span asp-validation-for="Phone"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                            <!-- E-posta -->
                            <div class="col-md-6">

                                <div class="mb-3">

                                    <label asp-for="Email"
                                           class="form-label">
                                        E-posta
                                    </label>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control"
                                           placeholder="personel@ornek.com"
                                           autocomplete="off" />

                                    <span asp-validation-for="Email"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                            <!-- İşe giriş tarihi -->
                            <div class="col-md-6">

                                <div class="mb-3">

                                    <label asp-for="HireDate"
                                           class="form-label">

                                        İşe Giriş Tarihi
                                        <span class="text-danger">*</span>

                                    </label>

                                    <input asp-for="HireDate"
                                           type="date"
                                           class="form-control" />

                                    <span asp-validation-for="HireDate"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                            <!-- İşten ayrılma tarihi -->
                            <div class="col-md-6">

                                <div class="mb-3">

                                    <label asp-for="TerminationDate"
                                           class="form-label">
                                        İşten Ayrılma Tarihi
                                    </label>

                                    <input asp-for="TerminationDate"
                                           type="date"
                                           class="form-control" />

                                    <span asp-validation-for="TerminationDate"
                                          class="text-danger">
                                    </span>

                                    <small class="text-muted">
                                        Ayrılma tarihi girildiğinde personel otomatik olarak pasife alınır.
                                    </small>

                                </div>

                            </div>

                            <!-- Personel durumu -->
                            <div class="col-12">

                                <div class="mb-3">

                                    <label class="form-label">
                                        Personel Durumu
                                    </label>

                                    <div class="form-check">

                                        <input asp-for="IsActive"
                                               class="form-check-input"
                                               type="checkbox" />

                                        <label asp-for="IsActive"
                                               class="form-check-label">
                                            Personel aktif olarak çalışıyor
                                        </label>

                                    </div>

                                </div>

                            </div>

                            <!-- Not -->
                            <div class="col-12">

                                <div class="mb-0">

                                    <label asp-for="Note"
                                           class="form-label">
                                        Not
                                    </label>

                                    <textarea asp-for="Note"
                                              class="form-control"
                                              rows="4"
                                              placeholder="Personelle ilgili eklemek istediğiniz notları yazabilirsiniz..."></textarea>

                                    <span asp-validation-for="Note"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>

                    </section>

                </div>

                <!-- Profil fotoğrafı -->
                <div class="col-lg-4">

                    <section class="m-card"
                             style="padding: 20px; margin-bottom: 20px;">

                        <div class="mb-4">

                            <h4 style="margin-bottom: 5px;">
                                Profil Fotoğrafı
                            </h4>

                            <p class="text-muted"
                               style="margin-bottom: 0;">
                                Mevcut fotoğrafı görüntüleyebilir veya yeni bir fotoğraf yükleyebilirsiniz.
                            </p>

                        </div>

                        <!-- Profil fotoğrafı önizleme -->
                        <div style="display: flex;
                                    justify-content: center;
                                    margin-bottom: 20px;">

                            <div style="width: 150px;
                                        height: 150px;
                                        border-radius: 50%;
                                        background: #f1f3f5;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        font-size: 50px;
                                        color: #8b95a1;
                                        overflow: hidden;">

                                @if (!string.IsNullOrWhiteSpace(Model.CurrentImageUrl))
                                {
                                    <i id="placeholderIcon"
                                       class="fa-solid fa-user"
                                       style="display: none;">
                                    </i>

                                    <img id="imagePreview"
                                         src="@Model.CurrentImageUrl"
                                         alt="@Model.FullName"
                                         style="width: 100%;
                                                    height: 100%;
                                                    object-fit: cover;
                                                    display: block;" />
                                }
                                else
                                {
                                    <i id="placeholderIcon"
                                       class="fa-solid fa-user">
                                    </i>

                                    <img id="imagePreview"
                                         src=""
                                         alt="Profil fotoğrafı önizleme"
                                         style="width: 100%;
                                                    height: 100%;
                                                    object-fit: cover;
                                                    display: none;" />
                                }

                            </div>

                        </div>

                        <!-- Yeni fotoğraf seçimi -->
                        <div class="mb-2">

                            <label asp-for="ImageFile"
                                   class="form-label">
                                Yeni Fotoğraf Seç
                            </label>

                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                            <span asp-validation-for="ImageFile"
                                  class="text-danger">
                            </span>

                        </div>

                        <small class="text-muted">
                            Yeni fotoğraf seçmezseniz mevcut fotoğraf korunur.
                            JPG, JPEG, PNG veya WEBP formatında, en fazla 5 MB.
                        </small>

                    </section>

                    <!-- Personel durumu bilgisi -->
                    <section class="m-card"
                             style="padding: 20px;">

                        <h4 style="margin-bottom: 15px;">
                            Kayıt Durumu
                        </h4>

                        <div style="display: flex;
                                    justify-content: space-between;
                                    align-items: center;">

                            <span>Personel</span>

                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">
                                    Aktif
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Pasif
                                </span>
                            }

                        </div>

                        @if (Model.TerminationDate.HasValue)
                        {
                            <hr />

                            <div style="display: flex;
                                            justify-content: space-between;
                                            align-items: center;">

                                <span>Ayrılma Tarihi</span>

                                <strong>
                                    @Model.TerminationDate.Value.ToString("dd.MM.yyyy")
                                </strong>

                            </div>
                        }

                    </section>

                </div>

            </div>

            <!-- Form işlemleri -->
            <section class="m-card"
                     style="padding: 20px; margin-top: 20px;">

                <div style="display: flex;
                            justify-content: flex-end;
                            align-items: center;
                            gap: 10px;">

                    <a asp-controller="Employee"
                       asp-action="Details"
                       asp-route-id="@Model.EmployeeId"
                       class="m-btn m-btn--ghost">

                        Vazgeç

                    </a>

                    <button type="submit"
                            class="m-btn m-btn--primary">

                        <i class="fa-solid fa-floppy-disk"></i>
                        Değişiklikleri Kaydet

                    </button>

                </div>

            </section>

        </form>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Yeni fotoğraf seçme alanını bulur
            const imageInput = document.getElementById("ImageFile");

            // Profil fotoğrafı önizleme alanını bulur
            const imagePreview = document.getElementById("imagePreview");

            // Fotoğraf bulunmadığında gösterilecek kullanıcı ikonunu bulur
            const placeholderIcon = document.getElementById("placeholderIcon");

            if (!imageInput || !imagePreview || !placeholderIcon) {
                return;
            }

            // Kullanıcı yeni profil fotoğrafı seçtiğinde çalışır
            imageInput.addEventListener("change", function () {

                const file = this.files && this.files.length > 0
                    ? this.files[0]
                    : null;

                // Yeni dosya seçilmediyse mevcut görünümü değiştirmez
                if (!file) {
                    return;
                }

                // Seçilen dosya görsel değilse önizleme yapmaz
                if (!file.type.startsWith("image/")) {
                    return;
                }

                const reader = new FileReader();

                // Yeni fotoğraf okunduğunda önizleme alanında gösterir
                reader.onload = function (event) {

                    imagePreview.src = event.target.result;
                    imagePreview.style.display = "block";
                    placeholderIcon.style.display = "none";

                };

                reader.readAsDataURL(file);
            });

        });
    </script>
}