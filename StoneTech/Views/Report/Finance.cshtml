@using StoneTech.Models.Report
@model FinanceReportViewModel

@{
    ViewData["Title"] = "Finans Raporu";
}

<section class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>
                <h2 class="page-header__title">
                    Finans Raporu
                </h2>

                <p class="page-header__subtitle">
                    Tahsilatları, kalan alacakları ve müşteri bazlı finansal durumu görüntüleyin.
                </p>
            </div>

            <div style="display:flex; gap:8px; flex-wrap:wrap;">

                <a asp-controller="Report"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Raporlama Merkezi

                </a>

                <!-- Excel -->
                <a asp-action="Export" asp-route-report="Finance" asp-route-format="Excel"
                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                   asp-route-search="@Model.Search" class="btn btn-success">

                    <i class="fa-solid fa-file-excel me-1"></i>
                    Excel

                </a>

                <!-- PDF -->
                <a asp-action="Export" asp-route-report="Finance" asp-route-format="Pdf"
                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                   asp-route-search="@Model.Search" class="btn btn-danger">

                    <i class="fa-solid fa-file-pdf me-1"></i>
                    PDF

                </a>

            </div>

        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Rapor filtreleri -->
        <div class="m-card mb-4"
             style="padding:20px;">

            <div class="m-card__header mb-3">

                <div>
                    <h4 class="m-card__title">
                        Rapor Filtreleri
                    </h4>

                    <p class="m-card__subtitle">
                        Tarih veya müşteri adına göre finans kayıtlarını filtreleyin.
                    </p>
                </div>

            </div>

            <form asp-controller="Report"
                  asp-action="Finance"
                  method="get">

                <div class="row align-items-end">

                    <!-- Başlangıç tarihi -->
                    <div class="col-lg-3 col-md-6 mb-3">

                        <label class="form-label">
                            Başlangıç Tarihi
                        </label>

                        <input type="date"
                               name="startDate"
                               class="form-control"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />

                    </div>

                    <!-- Bitiş tarihi -->
                    <div class="col-lg-3 col-md-6 mb-3">

                        <label class="form-label">
                            Bitiş Tarihi
                        </label>

                        <input type="date"
                               name="endDate"
                               class="form-control"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />

                    </div>

                    <!-- Müşteri arama -->
                    <div class="col-lg-3 col-md-6 mb-3">

                        <label class="form-label">
                            Müşteri
                        </label>

                        <input type="text"
                               name="search"
                               class="form-control"
                               value="@Model.Search"
                               placeholder="Müşteri adı..." />

                    </div>

                    <!-- Filtre butonları -->
                    <div class="col-lg-3 col-md-6 mb-3">

                        <div style="display:flex; gap:8px;">

                            <button type="submit"
                                    class="btn btn-primary flex-fill">

                                <i class="fa-solid fa-filter me-1"></i>
                                Filtrele

                            </button>

                            <a asp-controller="Report"
                               asp-action="Finance"
                               class="btn btn-outline-secondary flex-fill">

                                <i class="fa-solid fa-rotate-left me-1"></i>
                                Temizle

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

        <!-- KPI kartları -->
        <div class="row row-tight mb-4">

            <!-- Toplam iş tutarı -->
            <div class="col-sm-6 col-xl">

                <article class="stat-card">

                    <div class="stat-card__head">

                        <span class="stat-card__label">
                            Toplam İş Tutarı
                        </span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-turkish-lira-sign"></i>
                        </span>

                    </div>

                    <div class="stat-card__value">
                        @Model.TotalWorkOrderAmount.ToString("N2") ₺
                    </div>

                    <div class="stat-card__meta">
                        Finans raporundaki toplam iş değeri
                    </div>

                </article>

            </div>

            <!-- Toplam tahsilat -->
            <div class="col-sm-6 col-xl">

                <article class="stat-card">

                    <div class="stat-card__head">

                        <span class="stat-card__label">
                            Toplam Tahsilat
                        </span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-money-bill-transfer"></i>
                        </span>

                    </div>

                    <div class="stat-card__value">
                        @Model.TotalPaidAmount.ToString("N2") ₺
                    </div>

                    <div class="stat-card__meta">
                        İş emirlerinden tahsil edilen tutar
                    </div>

                </article>

            </div>

            <!-- Toplam alacak -->
            <div class="col-sm-6 col-xl">

                <article class="stat-card">

                    <div class="stat-card__head">

                        <span class="stat-card__label">
                            Toplam Alacak
                        </span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-wallet"></i>
                        </span>

                    </div>

                    <div class="stat-card__value">
                        @Model.TotalRemainingAmount.ToString("N2") ₺
                    </div>

                    <div class="stat-card__meta">
                        Henüz tahsil edilmemiş toplam tutar
                    </div>

                </article>

            </div>

            <!-- Tahsilat oranı -->
            <div class="col-sm-6 col-xl">

                <article class="stat-card">

                    <div class="stat-card__head">

                        <span class="stat-card__label">
                            Tahsilat Oranı
                        </span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-percent"></i>
                        </span>

                    </div>

                    <div class="stat-card__value">
                        %@Model.CollectionRate.ToString("N1")
                    </div>

                    <div class="stat-card__meta">
                        Toplam iş tutarının tahsil edilen oranı
                    </div>

                </article>

            </div>

        </div>

        <!-- Müşteri finans detayları -->
        <div class="m-card"
             style="padding:20px;">

            <div class="m-card__header mb-3">

                <div>

                    <h4 class="m-card__title">
                        Müşteri Finans Detayları
                    </h4>

                    <p class="m-card__subtitle">
                        Müşterilerin iş tutarı, tahsilat ve kalan alacak bilgileri.
                    </p>

                </div>

                @if (Model.Items.Any())
                {
                    <div class="text-muted"
                         style="font-size:13px;">

                        <strong>@Model.Items.Count</strong>
                        müşteri

                    </div>
                }

            </div>

            <div class="table-responsive">

                <table class="table m-table dt-table align-middle">

                    <thead>

                        <tr>

                            <th>
                                Müşteri
                            </th>

                            <th class="text-center">
                                İş Emri Sayısı
                            </th>

                            <th class="text-end">
                                Toplam Tutar
                            </th>

                            <th class="text-end">
                                Ödenen
                            </th>

                            <th class="text-end">
                                Kalan Alacak
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>

                                    <!-- Müşteri -->
                                    <td>
                                        <strong>
                                            @item.CustomerName
                                        </strong>
                                    </td>

                                    <!-- İş emri sayısı -->
                                    <td class="text-center">
                                        @item.WorkOrderCount
                                    </td>

                                    <!-- Toplam tutar -->
                                    <td class="text-end">

                                        <strong>
                                            @item.TotalAmount.ToString("N2") ₺
                                        </strong>

                                    </td>

                                    <!-- Ödenen -->
                                    <td class="text-end">

                                        <span class="text-success">
                                            @item.TotalPaid.ToString("N2") ₺
                                        </span>

                                    </td>

                                    <!-- Kalan alacak -->
                                    <td class="text-end">

                                        @if (item.RemainingAmount > 0)
                                        {
                                            <strong class="text-danger">
                                                @item.RemainingAmount.ToString("N2") ₺
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong class="text-success">
                                                0,00 ₺
                                            </strong>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center py-5 text-muted">

                                    <i class="fa-solid fa-folder-open fa-2x mb-3"></i>

                                    <div>
                                        Seçilen filtrelere uygun finans kaydı bulunamadı.
                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (Model.Items.Any())
            {
                <div class="mt-3 text-muted"
                     style="font-size:13px;">

                    Toplam
                    <strong>@Model.Items.Count</strong>
                    müşteri listeleniyor.

                </div>
            }

        </div>

    </div>
</section>
