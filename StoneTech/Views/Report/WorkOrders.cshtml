@using StoneTech.Enums
@using StoneTech.Models.Report
@model WorkOrderReportViewModel

@{
    ViewData["Title"] = "İş Emri Raporları";

    string GetStatusText(WorkOrderStatus status)
    {
        return status switch
        {
            WorkOrderStatus.PendingApproval => "Onay Bekliyor",
            WorkOrderStatus.Approved => "Onaylandı",
            WorkOrderStatus.InWorkshop => "Atölyede",
            WorkOrderStatus.Completed => "Tamamlandı",
            WorkOrderStatus.Rejected => "Reddedildi",
            WorkOrderStatus.Cancelled => "İptal",
            _ => status.ToString()
        };
    }

    string GetStatusClass(WorkOrderStatus status)
    {
        return status switch
        {
            WorkOrderStatus.PendingApproval => "badge-warning",
            WorkOrderStatus.Approved => "badge-primary",
            WorkOrderStatus.InWorkshop => "badge-info",
            WorkOrderStatus.Completed => "badge-success",
            WorkOrderStatus.Rejected => "badge-danger",
            WorkOrderStatus.Cancelled => "badge-secondary",
            _ => "badge-secondary"
        };
    }
}

<section class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>
                <h2 class="page-header__title">
                    İş Emri Raporları
                </h2>

                <p class="page-header__subtitle">
                    İş emirlerinin finansal ve operasyonel analizini görüntüleyin.
                </p>
            </div>

            <div style="display:flex; gap:8px; flex-wrap:wrap;">

                <a asp-controller="Report"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Raporlama Merkezi

                </a>

                <!-- EXCEL -->
                <a asp-controller="Report"
                   asp-action="Export"
                   asp-route-report="WorkOrders"
                   asp-route-format="Excel"
                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                   asp-route-status="@Model.Status"
                   asp-route-search="@Model.Search"
                   class="btn btn-success">

                    <i class="fa-solid fa-file-excel me-1"></i>
                    Excel

                </a>
                <!-- PDF -->
                <a asp-controller="Report"
                   asp-action="Export"
                   asp-route-report="WorkOrders"
                   asp-route-format="Pdf"
                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                   asp-route-status="@Model.Status"
                   asp-route-search="@Model.Search"
                   class="btn btn-danger">

                    <i class="fa-solid fa-file-pdf me-1"></i>
                    PDF

                </a>

            </div>

        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Rapor filtreleri -->
        <div class="m-card mb-4"
             style="padding:20px;">

            <div class="m-card__header mb-3">

                <div>

                    <h4 class="m-card__title">
                        Rapor Filtreleri
                    </h4>

                    <p class="m-card__subtitle">
                        Tarih, durum, müşteri veya iş emri numarasına göre filtreleyin.
                    </p>

                </div>

            </div>

            <form asp-controller="Report"
                  asp-action="WorkOrders"
                  method="get">

                <div class="row align-items-end">

                    <!-- Başlangıç tarihi -->
                    <div class="col-lg-2 col-md-6 mb-3">

                        <label class="form-label">
                            Başlangıç Tarihi
                        </label>

                        <input type="date"
                               name="startDate"
                               class="form-control"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />

                    </div>

                    <!-- Bitiş tarihi -->
                    <div class="col-lg-2 col-md-6 mb-3">

                        <label class="form-label">
                            Bitiş Tarihi
                        </label>

                        <input type="date"
                               name="endDate"
                               class="form-control"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />

                    </div>

                    <!-- Durum -->
                    <div class="col-lg-2 col-md-6 mb-3">

                        <label class="form-label">
                            Durum
                        </label>

                        <select name="status"
                                class="form-control">

                            <option value="">
                                Tüm Durumlar
                            </option>

                            @foreach (WorkOrderStatus item in Enum.GetValues(typeof(WorkOrderStatus)))
                            {
                                if (Model.Status == item)
                                {
                                    <option value="@((int)item)" selected>
                                        @GetStatusText(item)
                                    </option>
                                }
                                else
                                {
                                    <option value="@((int)item)">
                                        @GetStatusText(item)
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <!-- Müşteri / İş Emri arama -->
                    <div class="col-lg-3 col-md-6 mb-3">

                        <label class="form-label">
                            Müşteri / İş Emri No
                        </label>

                        <input type="text"
                               name="search"
                               class="form-control"
                               value="@Model.Search"
                               placeholder="Müşteri veya IE-2026-..." />

                    </div>

                    <!-- Filtre butonları -->
                    <div class="col-lg-3 col-md-12 mb-3">

                        <div style="display:flex; gap:8px;">

                            <button type="submit"
                                    class="btn btn-primary flex-fill">

                                <i class="fa-solid fa-filter me-1"></i>
                                Filtrele

                            </button>

                            <a asp-controller="Report"
                               asp-action="WorkOrders"
                               class="btn btn-outline-secondary flex-fill">

                                <i class="fa-solid fa-rotate-left me-1"></i>
                                Temizle

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

        <!-- KPI kartları -->
        <div class="row row-tight mb-4">

            <!-- İş emri sayısı -->
            <div class="col-sm-6 col-xl">

                <article class="stat-card">

                    <div class="stat-card__head">

                        <span class="stat-card__label">
                            İş Emri
                        </span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-clipboard-list"></i>
                        </span>

                    </div>

                    <div class="stat-card__value">
                        @Model.TotalWorkOrderCount
                    </div>

                    <div class="stat-card__meta">
                        Filtreye uyan toplam iş
                    </div>

                </article>

            </div>

            <!-- Toplam tutar -->
            <div class="col-sm-6 col-xl">

                <article class="stat-card">

                    <div class="stat-card__head">

                        <span class="stat-card__label">
                            Toplam Tutar
                        </span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-turkish-lira-sign"></i>
                        </span>

                    </div>

                    <div class="stat-card__value">
                        @Model.TotalWorkOrderAmount.ToString("N2") ₺
                    </div>

                    <div class="stat-card__meta">
                        İş emirlerinin toplam değeri
                    </div>

                </article>

            </div>

            <!-- Ortalama iş -->
            <div class="col-sm-6 col-xl">

                <article class="stat-card">

                    <div class="stat-card__head">

                        <span class="stat-card__label">
                            Ortalama İş
                        </span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-chart-line"></i>
                        </span>

                    </div>

                    <div class="stat-card__value">
                        @Model.AverageWorkOrderAmount.ToString("N2") ₺
                    </div>

                    <div class="stat-card__meta">
                        Ortalama iş emri tutarı
                    </div>

                </article>

            </div>

            <!-- Tahsilat -->
            <div class="col-sm-6 col-xl">

                <article class="stat-card">

                    <div class="stat-card__head">

                        <span class="stat-card__label">
                            Tahsilat
                        </span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-money-bill-transfer"></i>
                        </span>

                    </div>

                    <div class="stat-card__value">
                        @Model.TotalPaidAmount.ToString("N2") ₺
                    </div>

                    <div class="stat-card__meta">
                        İş emirlerinden tahsil edilen
                    </div>

                </article>

            </div>

            <!-- Kalan alacak -->
            <div class="col-sm-6 col-xl">

                <article class="stat-card">

                    <div class="stat-card__head">

                        <span class="stat-card__label">
                            Kalan Alacak
                        </span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-wallet"></i>
                        </span>

                    </div>

                    <div class="stat-card__value">
                        @Model.TotalRemainingAmount.ToString("N2") ₺
                    </div>

                    <div class="stat-card__meta">
                        Henüz tahsil edilmemiş tutar
                    </div>

                </article>

            </div>

        </div>

        <!-- İş emri detayları -->
        <div class="m-card"
             style="padding:20px;">

            <div class="m-card__header mb-3">

                <div>

                    <h4 class="m-card__title">
                        İş Emri Detayları
                    </h4>

                    <p class="m-card__subtitle">
                        Filtrelenen iş emirlerinin detaylı raporu.
                    </p>

                </div>

                @if (Model.WorkOrders.Any())
                {
                    <div class="text-muted"
                         style="font-size:13px;">

                        <strong>@Model.TotalWorkOrderCount</strong>
                        iş emri

                    </div>
                }

            </div>

            <div class="table-responsive">

                <table class="table m-table dt-table align-middle">

                    <thead>

                        <tr>

                            <th>
                                İş Emri No
                            </th>

                            <th>
                                Müşteri
                            </th>

                            <th>
                                Tarih
                            </th>

                            <th>
                                Durum
                            </th>

                            <th class="text-end">
                                Plaka
                            </th>

                            <th class="text-end">
                                Kesim
                            </th>

                            <th class="text-end">
                                Toplam
                            </th>

                            <th class="text-end">
                                Ödenen
                            </th>

                            <th class="text-end">
                                Kalan
                            </th>

                            <th class="text-center">
                                İşlem
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.WorkOrders.Any())
                        {
                            foreach (var item in Model.WorkOrders)
                            {
                                <tr>

                                    <!-- İş emri numarası -->
                                    <td>

                                        <strong>
                                            @item.WorkOrderNumber
                                        </strong>

                                    </td>

                                    <!-- Müşteri -->
                                    <td>
                                        @item.CustomerName
                                    </td>

                                    <!-- Tarih -->
                                    <td>
                                        @item.CreatedDate.ToString("dd.MM.yyyy")
                                    </td>

                                    <!-- Durum -->
                                    <td>

                                        <span class="badge @GetStatusClass(item.Status)">
                                            @GetStatusText(item.Status)
                                        </span>

                                    </td>

                                    <!-- Plaka -->
                                    <td class="text-end">
                                        @item.TotalStoneQuantity
                                    </td>

                                    <!-- Kesim -->
                                    <td class="text-end">
                                        @item.CuttingMeter.ToString("N2") m
                                    </td>

                                    <!-- Toplam -->
                                    <td class="text-end">

                                        <strong>
                                            @item.TotalAmount.ToString("N2") ₺
                                        </strong>

                                    </td>

                                    <!-- Ödenen -->
                                    <td class="text-end">
                                        @item.TotalPaid.ToString("N2") ₺
                                    </td>

                                    <!-- Kalan -->
                                    <td class="text-end">

                                        @if (item.RemainingAmount > 0)
                                        {
                                            <strong class="text-danger">
                                                @item.RemainingAmount.ToString("N2") ₺
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong class="text-success">
                                                0,00 ₺
                                            </strong>
                                        }

                                    </td>

                                    <!-- İşlem -->
                                    <td class="text-center">

                                        <div class="table-data-feature"
                                             style="justify-content:center;">

                                            <a asp-controller="WorkOrder"
                                               asp-action="Details"
                                               asp-route-id="@item.WorkOrderId"
                                               class="item"
                                               title="İş Emrini Görüntüle">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="10"
                                    class="text-center py-5 text-muted">

                                    <i class="fa-solid fa-folder-open fa-2x mb-3"></i>

                                    <div>
                                        Seçilen filtrelere uygun iş emri bulunamadı.
                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (Model.WorkOrders.Any())
            {
                <div class="mt-3 text-muted"
                     style="font-size:13px;">

                    Toplam
                    <strong>@Model.TotalWorkOrderCount</strong>
                    iş emri listeleniyor.

                </div>
            }

        </div>

    </div>
</section>
