@using StoneTech.Models.Report
@model StockReportViewModel

@{
    ViewData["Title"] = "Stok Raporu";
}

<section class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">
            <div>
                <h2 class="page-header__title">Stok Raporu</h2>

                <p class="page-header__subtitle">
                    Plaka bazlı güncel stokları ve dönem hareketlerini görüntüleyin.
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Raporlama Merkezi
                </a>

                <a asp-action="Export"
                   asp-route-report="Stock"
                   asp-route-format="Excel"
                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                   asp-route-search="@Model.Search"
                   asp-route-isActive="@Model.IsActive"
                   class="btn btn-success">
                    <i class="fa-solid fa-file-excel me-1"></i>
                    Excel
                </a>

                <a asp-action="Export"
                   asp-route-report="Stock"
                   asp-route-format="Pdf"
                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                   asp-route-search="@Model.Search"
                   asp-route-isActive="@Model.IsActive"
                   class="btn btn-danger">
                    <i class="fa-solid fa-file-pdf me-1"></i>
                    PDF
                </a>
            </div>
        </div>

        <!-- Hata mesajı -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Rapor filtreleri -->
        <div class="m-card mb-4 p-4">
            <div class="m-card__header mb-3">
                <div>
                    <h4 class="m-card__title">Rapor Filtreleri</h4>

                    <p class="m-card__subtitle">
                        Hareket dönemini, taş adını, rengi veya kayıt durumunu filtreleyin.
                    </p>
                </div>
            </div>

            <form asp-action="Stock" method="get">
                <div class="row align-items-end">

                    <!-- Başlangıç tarihi -->
                    <div class="col-lg-2 col-md-6 mb-3">
                        <label class="form-label">Başlangıç Tarihi</label>

                        <input type="date"
                               name="startDate"
                               class="form-control"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- Bitiş tarihi -->
                    <div class="col-lg-2 col-md-6 mb-3">
                        <label class="form-label">Bitiş Tarihi</label>

                        <input type="date"
                               name="endDate"
                               class="form-control"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- Taş / renk arama -->
                    <div class="col-lg-3 col-md-6 mb-3">
                        <label class="form-label">Taş / Renk</label>

                        <input type="text"
                               name="search"
                               class="form-control"
                               value="@Model.Search"
                               placeholder="Taş adı veya renk..." />
                    </div>

                    <!-- Durum filtresi -->
                    <div class="col-lg-2 col-md-6 mb-3">
                        <label class="form-label">Durum</label>

                        <select name="isActive" class="form-control">
                            <option value="">Tümü</option>

                            @if (Model.IsActive == true)
                            {
                                <option value="true" selected>Aktif</option>
                            }
                            else
                            {
                                <option value="true">Aktif</option>
                            }

                            @if (Model.IsActive == false)
                            {
                                <option value="false" selected>Pasif</option>
                            }
                            else
                            {
                                <option value="false">Pasif</option>
                            }
                        </select>
                    </div>

                    <!-- Filtre butonları -->
                    <div class="col-lg-3 col-md-12 mb-3">
                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary flex-fill">
                                <i class="fa-solid fa-filter me-1"></i>
                                Filtrele
                            </button>

                            <a asp-action="Stock"
                               class="btn btn-outline-secondary flex-fill">
                                <i class="fa-solid fa-rotate-left me-1"></i>
                                Temizle
                            </a>
                        </div>
                    </div>

                </div>
            </form>
        </div>

        <!-- KPI kartları -->
        <div class="row row-tight mb-4">

            <!-- Taş çeşidi -->
            <div class="col-sm-6 col-xl">
                <article class="stat-card">
                    <div class="stat-card__head">
                        <span class="stat-card__label">Taş Çeşidi</span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-gem"></i>
                        </span>
                    </div>

                    <div class="stat-card__value">
                        @Model.StoneCount
                    </div>

                    <div class="stat-card__meta">
                        Filtreye uyan taş
                    </div>
                </article>
            </div>

            <!-- Mevcut stok -->
            <div class="col-sm-6 col-xl">
                <article class="stat-card">
                    <div class="stat-card__head">
                        <span class="stat-card__label">Mevcut Stok</span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </span>
                    </div>

                    <div class="stat-card__value">
                        @Model.TotalCurrentStock
                    </div>

                    <div class="stat-card__meta">
                        Güncel plaka adedi
                    </div>
                </article>
            </div>

            <!-- Dönem girişi -->
            <div class="col-sm-6 col-xl">
                <article class="stat-card">
                    <div class="stat-card__head">
                        <span class="stat-card__label">Dönem Girişi</span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-arrow-down"></i>
                        </span>
                    </div>

                    <div class="stat-card__value">
                        @Model.TotalEntries
                    </div>

                    <div class="stat-card__meta">
                        Alımlardan giren plaka
                    </div>
                </article>
            </div>

            <!-- Dönem çıkışı -->
            <div class="col-sm-6 col-xl">
                <article class="stat-card">
                    <div class="stat-card__head">
                        <span class="stat-card__label">Dönem Çıkışı</span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-arrow-up"></i>
                        </span>
                    </div>

                    <div class="stat-card__value">
                        @Model.TotalExits
                    </div>

                    <div class="stat-card__meta">
                        İş emirlerinde kullanılan
                    </div>
                </article>
            </div>

            <!-- İş emri iadeleri -->
            <div class="col-sm-6 col-xl">
                <article class="stat-card">
                    <div class="stat-card__head">
                        <span class="stat-card__label">İade</span>

                        <span class="stat-card__icon">
                            <i class="fa-solid fa-rotate-left"></i>
                        </span>
                    </div>

                    <div class="stat-card__value">
                        @Model.TotalReturns
                    </div>

                    <div class="stat-card__meta">
                        İş emri iadeleri
                    </div>
                </article>
            </div>

        </div>

        <!-- Stok detayları -->
        <div class="m-card p-4">
            <div class="m-card__header mb-3">
                <div>
                    <h4 class="m-card__title">Stok Detayları</h4>

                    <p class="m-card__subtitle">
                        Güncel stok tüm hareketlerden, giriş ve çıkış değerleri seçilen dönemden hesaplanır.
                    </p>
                </div>

                @if (Model.Items.Any())
                {
                    <div class="text-muted">
                        <strong>@Model.Items.Count</strong> taş
                    </div>
                }
            </div>

            <div class="table-responsive">
                <table class="table m-table dt-table align-middle">
                    <thead>
                        <tr>
                            <th>Taş</th>
                            <th>Renk</th>

                            <th class="text-end">
                                Mevcut Stok
                            </th>

                            <th class="text-end">
                                Dönem Girişi
                            </th>

                            <th class="text-end">
                                Dönem Çıkışı
                            </th>

                            <th class="text-center">
                                Detay
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>

                                    <!-- Taş -->
                                    <td>
                                        <strong>@item.StoneName</strong>
                                    </td>

                                    <!-- Renk -->
                                    <td>
                                        @(item.Color ?? "-")
                                    </td>

                                    <!-- Güncel stok -->
                                    <td class="text-end">
                                        <strong>@item.CurrentStock</strong>
                                    </td>

                                    <!-- Seçilen dönemdeki stok girişi -->
                                    <td class="text-end">
                                        @item.TotalEntry
                                    </td>

                                    <!-- Seçilen dönemdeki stok çıkışı -->
                                    <td class="text-end">
                                        @item.TotalExit
                                    </td>

                                    <!-- Taşın stok hareketleri -->
                                    <td class="text-center">
                                        <a asp-controller="Stock"
                                           asp-action="Movements"
                                           asp-route-id="@item.StoneId"
                                           class="text-secondary"
                                           title="Stok Hareketlerini Görüntüle">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center py-5 text-muted">

                                    <i class="fa-solid fa-folder-open fa-2x mb-3"></i>

                                    <div>
                                        Seçilen filtrelere uygun stok kaydı bulunamadı.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Items.Any())
            {
                <div class="mt-3 text-muted">
                    Toplam <strong>@Model.Items.Count</strong> taş listeleniyor.
                </div>
            }
        </div>

    </div>
</section>