@using StoneTech.Models.Supplier
@model SupplierEditViewModel

@{
    ViewData["Title"] = "Tedarikçi Düzenle";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <div class="page-header">
            <div>
                <h1>Tedarikçi Düzenle</h1>
                <p class="subtitle">
                    Tedarikçi bilgilerini güncelleyin.
                </p>
            </div>

            <div class="page-header__actions">
                <a asp-controller="Supplier"
                   asp-action="Index"
                   class="m-btn m-btn--ghost">
                    <i class="fa-solid fa-arrow-left"></i>
                    Tedarikçilere Dön
                </a>
            </div>
        </div>

        <section class="m-card" style="padding: 24px;">

            <form asp-controller="Supplier"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Güncellenecek tedarikçinin Id bilgisi -->
                <input asp-for="SupplierId"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- Tedarikçi Adı -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="SupplierName"
                               class="form-label">
                            Tedarikçi Adı
                        </label>

                        <input asp-for="SupplierName"
                               class="form-control"
                               placeholder="Örn: ABC Mermer" />

                        <span asp-validation-for="SupplierName"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Telefon -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="Phone"
                               class="form-label">
                            Telefon
                        </label>

                        <input asp-for="Phone"
                               type="tel"
                               class="form-control"
                               placeholder="Örn: 0258 000 00 00" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Adres -->
                    <div class="col-12 mb-4">

                        <label asp-for="Address"
                               class="form-label">
                            Adres
                        </label>

                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Tedarikçinin adresini girin..."></textarea>

                        <span asp-validation-for="Address"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Not -->
                    <div class="col-12 mb-4">

                        <label asp-for="Note"
                               class="form-label">
                            Not
                        </label>

                        <textarea asp-for="Note"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Tedarikçi hakkında not..."></textarea>

                        <span asp-validation-for="Note"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Aktif / Pasif -->
                    <div class="col-md-6 mb-4">

                        <label class="form-label">
                            Durum
                        </label>

                        <div class="form-check form-switch"
                             style="margin-top: 8px;">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox"
                                   role="switch" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Tedarikçi aktif
                            </label>

                        </div>

                    </div>

                </div>

                <!-- Form Butonları -->
                <div style="display: flex;
                            justify-content: flex-end;
                            gap: 10px;
                            margin-top: 10px;">

                    <a asp-controller="Supplier"
                       asp-action="Index"
                       class="m-btn m-btn--ghost">
                        İptal
                    </a>

                    <button type="submit"
                            class="m-btn m-btn--primary">

                        <i class="fa-solid fa-floppy-disk"></i>
                        Değişiklikleri Kaydet

                    </button>

                </div>

            </form>

        </section>

    </div>
</div>