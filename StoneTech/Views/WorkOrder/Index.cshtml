@using StoneTech.Models.WorkOrder
@using StoneTech.Enums
@model IEnumerable<WorkOrderListViewModel>

@{
    ViewData["Title"] = "İş Emirleri";

    string search = ViewBag.Search ?? "";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalCount = ViewBag.TotalCount ?? 0;

    int firstItem = totalCount == 0
        ? 0
        : ((page - 1) * pageSize) + 1;

    int lastItem = Math.Min(
        page * pageSize,
        totalCount
    );
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>

                <h1>İş Emirleri</h1>

                <p class="subtitle">
                    Müşteri iş emirlerini, toplam tutarları, iş süreçlerini ve ödeme durumlarını yönetin.
                </p>

            </div>

            <div class="page-header__actions">

                @if (User.IsInRole("Admin") ||
                                User.IsInRole("Manager") ||
                                User.IsInRole("Sales"))
                {
                    <a asp-controller="WorkOrder"
                       asp-action="Create"
                       class="m-btn m-btn--primary">

                        <i class="fa-solid fa-plus"></i>
                        Yeni İş Emri

                    </a>
                }

            </div>

        </div>

        <!-- Başarı mesajı -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Hata mesajı -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- İş emirleri tablosu -->
        <section class="m-card" style="padding: 20px;">

            <!-- Arama ve sayfa başına kayıt -->
            <form asp-controller="WorkOrder"
                  asp-action="Index"
                  method="get">

                <div class="dt-toolbar">

                    <!-- Arama -->
                    <div class="dt-search">

                        <i class="fa-solid fa-magnifying-glass"
                           aria-hidden="true"></i>

                        <input type="search"
                               name="search"
                               value="@search"
                               placeholder="İş emri no, müşteri veya telefon ara..."
                               aria-label="İş emri ara">

                    </div>

                    <!-- Sayfa başına kayıt -->
                    <div style="display: flex;
                                gap: 8px;
                                align-items: center;">

                        <label style="font-size: 12.5px;
                                      color: var(--m-text-muted);
                                      display: inline-flex;
                                      align-items: center;
                                      gap: 8px;">

                            Göster

                            <select name="pageSize"
                                    class="form-select"
                                    style="width: 80px;
                                           height: 32px;
                                           padding: 0 24px 0 10px;
                                           font-size: 12.5px;"
                                    onchange="this.form.submit()">

                                <option value="5"
                                        selected="@(pageSize == 5)">
                                    5
                                </option>

                                <option value="10"
                                        selected="@(pageSize == 10)">
                                    10
                                </option>

                                <option value="20"
                                        selected="@(pageSize == 20)">
                                    20
                                </option>

                                <option value="50"
                                        selected="@(pageSize == 50)">
                                    50
                                </option>

                            </select>

                            kayıt

                        </label>

                    </div>

                </div>

            </form>

            <!-- Tablo -->
            <div class="table-responsive">

                <table class="m-table dt-table"
                       id="dt-table">

                    <thead>

                        <tr>

                            <th>İş Emri</th>
                            <th>Müşteri</th>
                            <th>Tarih</th>
                            <th>KDV Dahil Toplam</th>
                            <th>Ödenen</th>
                            <th>Kalan</th>
                            <th>İş Durumu</th>
                            <th>Ödeme Durumu</th>
                            <th></th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="9">

                                    <div class="empty-state">

                                        <span class="empty-state__icon">

                                            <i class="fa-solid fa-clipboard-list"></i>

                                        </span>

                                        <h3 class="empty-state__title">
                                            İş emri bulunamadı
                                        </h3>

                                        <p class="empty-state__text">

                                            @if (!string.IsNullOrWhiteSpace(search))
                                            {
                                                @:Aramanızla eşleşen iş emri bulunamadı.
                                            }
                                            else
                                            {
                                                @:Henüz sistemde oluşturulmuş bir iş emri bulunmuyor.
                                            }

                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(search))
                                        {
                                            <div class="empty-state__actions">

                                                <a asp-controller="WorkOrder"
                                                   asp-action="Index"
                                                   class="m-btn m-btn--ghost">

                                                    Aramayı temizle

                                                </a>

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="empty-state__actions">

                                                <a asp-controller="WorkOrder"
                                                   asp-action="Create"
                                                   class="m-btn m-btn--primary">

                                                    <i class="fa-solid fa-plus"></i>
                                                    Yeni İş Emri

                                                </a>

                                            </div>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                string statusText;
                                string statusClass;

                                switch (item.Status)
                                {
                                    case WorkOrderStatus.PendingApproval:
                                        statusText = "Onay Bekliyor";
                                        statusClass = "badge bg-warning text-dark";
                                        break;

                                    case WorkOrderStatus.Approved:
                                        statusText = "Onaylandı";
                                        statusClass = "badge bg-info text-dark";
                                        break;

                                    case WorkOrderStatus.InWorkshop:
                                        statusText = "Atölyede";
                                        statusClass = "badge bg-primary";
                                        break;

                                    case WorkOrderStatus.Completed:
                                        statusText = "Tamamlandı";
                                        statusClass = "badge bg-success";
                                        break;

                                    case WorkOrderStatus.Rejected:
                                        statusText = "Reddedildi";
                                        statusClass = "badge bg-danger";
                                        break;

                                    case WorkOrderStatus.Cancelled:
                                        statusText = "İptal Edildi";
                                        statusClass = "badge bg-secondary";
                                        break;

                                    default:
                                        statusText = item.Status.ToString();
                                        statusClass = "badge bg-secondary";
                                        break;
                                }

                                string paymentStatusText;
                                string paymentStatusClass;

                                if (item.Status == WorkOrderStatus.Cancelled)
                                {
                                    paymentStatusText = "İptal";
                                    paymentStatusClass = "badge bg-secondary";
                                }
                                else if (item.Status == WorkOrderStatus.Rejected)
                                {
                                    paymentStatusText = "Reddedildi";
                                    paymentStatusClass = "badge bg-secondary";
                                }
                                else if (item.RemainingAmount <= 0)
                                {
                                    paymentStatusText = "Ödendi";
                                    paymentStatusClass = "badge bg-success";
                                }
                                else if (item.TotalPaid > 0)
                                {
                                    paymentStatusText = "Kısmi Ödendi";
                                    paymentStatusClass = "badge bg-warning text-dark";
                                }
                                else
                                {
                                    paymentStatusText = "Ödeme Bekliyor";
                                    paymentStatusClass = "badge bg-danger";
                                }

                                <tr>

                                    <!-- İş emri numarası -->
                                    <td>

                                        <span class="name">
                                            @item.WorkOrderNumber
                                        </span>

                                    </td>

                                    <!-- Müşteri -->
                                    <td>

                                        <span class="name">
                                            @item.CustomerName
                                        </span>

                                    </td>

                                    <!-- Tarih -->
                                    <td>

                                        @item.CreatedDate.ToString("dd.MM.yyyy")

                                    </td>

                                    <!-- KDV dahil toplam -->
                                    <td>

                                        <strong>
                                            @item.TotalAmount.ToString("N2") ₺
                                        </strong>

                                    </td>

                                    <!-- Ödenen -->
                                    <td>

                                        @if (item.TotalPaid > 0)
                                        {
                                            <span class="text-success">
                                                @item.TotalPaid.ToString("N2") ₺
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                0,00 ₺
                                            </span>
                                        }

                                    </td>

                                    <!-- Kalan borç -->
                                    <td>

                                        @if (item.RemainingAmount > 0)
                                        {
                                            <strong class="text-danger">
                                                @item.RemainingAmount.ToString("N2") ₺
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="text-success">
                                                0,00 ₺
                                            </span>
                                        }

                                    </td>

                                    <!-- İş durumu -->
                                    <td>

                                        <span class="@statusClass">
                                            @statusText
                                        </span>

                                    </td>

                                    <!-- Ödeme durumu -->
                                    <td>

                                        <span class="@paymentStatusClass">
                                            @paymentStatusText
                                        </span>

                                    </td>

                                    <!-- İşlemler -->
                                    <td>

                                        <div class="table-data-feature">

                                            <!-- İş emri detayını görüntüle -->
                                            <a asp-controller="WorkOrder"
                                               asp-action="Details"
                                               asp-route-id="@item.WorkOrderId"
                                               class="item"
                                               data-bs-toggle="tooltip"
                                               title="İş Emri Detayı">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                            @if (item.Status == WorkOrderStatus.PendingApproval &&
                                                            (User.IsInRole("Admin") ||
                                                             User.IsInRole("Manager") ||
                                                             User.IsInRole("Sales")))
                                            {
                                                <!-- İş emrini düzenle -->
                                                <a asp-controller="WorkOrder"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.WorkOrderId"
                                                   class="item"
                                                   data-bs-toggle="tooltip"
                                                   title="İş Emrini Düzenle">

                                                    <i class="fa-solid fa-pen-to-square"></i>

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <!-- Sayfalama -->
            <div class="dt-pagination">

                <!-- Gösterilen kayıt bilgisi -->
                <span class="dt-pagination__info">

                    @if (totalCount == 0)
                    {
                        @:Sonuç yok
                    }
                    else
                    {
                        @:@firstItem–@lastItem / @totalCount kayıt
                    }

                </span>

                <!-- Sayfa navigasyonu -->
                <div class="dt-pagination__nav">

                    <!-- Önceki sayfa -->
                    @if (page > 1)
                    {
                        <a asp-controller="WorkOrder"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page - 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-left"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                disabled>

                            <i class="fa-solid fa-chevron-left"></i>

                        </button>
                    }

                    <!-- Sayfa numaraları -->
                    @if (totalPages > 0)
                    {
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            @if (i == page)
                            {
                                <button type="button"
                                        class="is-active"
                                        disabled>

                                    @i

                                </button>
                            }
                            else
                            {
                                <a asp-controller="WorkOrder"
                                   asp-action="Index"
                                   asp-route-search="@search"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@pageSize">

                                    @i

                                </a>
                            }
                        }
                    }

                    <!-- Sonraki sayfa -->
                    @if (totalPages > 0 && page < totalPages)
                    {
                        <a asp-controller="WorkOrder"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page + 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                disabled>

                            <i class="fa-solid fa-chevron-right"></i>

                        </button>
                    }

                </div>

            </div>

        </section>

    </div>
</div>
