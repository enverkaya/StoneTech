@model StoneTech.Models.WorkOrder.WorkOrderDetailsViewModel
@using StoneTech.Enums

@{
    ViewData["Title"] = "İş Emri Detayı";

    string statusText;
    string statusClass;

    switch (Model.Status)
    {
        case WorkOrderStatus.PendingApproval:
            statusText = "Onay Bekliyor";
            statusClass = "badge bg-warning text-dark";
            break;

        case WorkOrderStatus.Approved:
            statusText = "Onaylandı";
            statusClass = "badge bg-info text-dark";
            break;

        case WorkOrderStatus.InWorkshop:
            statusText = "Atölyede";
            statusClass = "badge bg-primary";
            break;

        case WorkOrderStatus.Completed:
            statusText = "Tamamlandı";
            statusClass = "badge bg-success";
            break;

        case WorkOrderStatus.Rejected:
            statusText = "Reddedildi";
            statusClass = "badge bg-danger";
            break;

        case WorkOrderStatus.Cancelled:
            statusText = "İptal Edildi";
            statusClass = "badge bg-secondary";
            break;

        default:
            statusText = Model.Status.ToString();
            statusClass = "badge bg-secondary";
            break;
    }

    string paymentStatusText;
    string paymentStatusClass;

    if (Model.Status == WorkOrderStatus.Cancelled)
    {
        paymentStatusText = "İş Emri İptal";
        paymentStatusClass = "badge bg-secondary";
    }
    else if (Model.Status == WorkOrderStatus.Rejected)
    {
        paymentStatusText = "İş Emri Reddedildi";
        paymentStatusClass = "badge bg-secondary";
    }
    else if (Model.RemainingAmount <= 0)
    {
        paymentStatusText = "Ödendi";
        paymentStatusClass = "badge bg-success";
    }
    else if (Model.TotalPaid > 0)
    {
        paymentStatusText = "Kısmi Ödendi";
        paymentStatusClass = "badge bg-warning text-dark";
    }
    else
    {
        paymentStatusText = "Ödeme Bekliyor";
        paymentStatusClass = "badge bg-danger";
    }
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>

                <h1>İş Emri @Model.WorkOrderNumber</h1>

                <p class="subtitle">
                    İş emrine ait müşteri, taş, işçilik, KDV ve ödeme bilgileri.
                </p>

            </div>

            <div class="page-header__actions">

                <a asp-controller="WorkOrder"
                   asp-action="Index"
                   class="m-btn m-btn--ghost">

                    <i class="fa-solid fa-arrow-left"></i>
                    İş Emirleri

                </a>

                @if (Model.Status == WorkOrderStatus.PendingApproval)
                {
                    <!-- Sales iş emrini düzenleyebilir -->
                    @if (User.IsInRole("Admin") ||
                                    User.IsInRole("Manager") ||
                                    User.IsInRole("Sales"))
                    {
                        <a asp-controller="WorkOrder"
                           asp-action="Edit"
                           asp-route-id="@Model.WorkOrderId"
                           class="m-btn m-btn--ghost">

                            <i class="fa-solid fa-pen-to-square"></i>
                            Düzenle

                        </a>
                    }

                    <!-- İş emrini yalnızca Admin ve Manager onaylayabilir veya reddedebilir -->
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <form asp-controller="WorkOrder"
                              asp-action="Approve"
                              asp-route-id="@Model.WorkOrderId"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="m-btn m-btn--primary">

                                <i class="fa-solid fa-check"></i>
                                Onayla

                            </button>

                        </form>

                        <form asp-controller="WorkOrder"
                              asp-action="Reject"
                              asp-route-id="@Model.WorkOrderId"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Bu iş emrini reddetmek istediğinize emin misiniz?');">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="m-btn m-btn--ghost">

                                <i class="fa-solid fa-xmark"></i>
                                Reddet

                            </button>

                        </form>
                    }
                }
                @if (Model.Status == WorkOrderStatus.Approved &&
                                (User.IsInRole("Admin") ||
                                 User.IsInRole("Manager") ||
                                 User.IsInRole("Workshop")))
                {
                    <form asp-controller="WorkOrder"
                          asp-action="StartWorkshop"
                          asp-route-id="@Model.WorkOrderId"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('İş emri atölyede işleme alınacak ve kullanılan plakalar stoktan düşülecek. Devam edilsin mi?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="m-btn m-btn--primary">

                            <i class="fa-solid fa-hammer"></i>
                            İşleme Al

                        </button>

                    </form>
                }

                @if (Model.Status == WorkOrderStatus.InWorkshop &&
                                (User.IsInRole("Admin") ||
                                 User.IsInRole("Manager") ||
                                 User.IsInRole("Workshop")))
                {
                    <form asp-controller="WorkOrder"
                          asp-action="Complete"
                          asp-route-id="@Model.WorkOrderId"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Bu iş emrini tamamlamak istediğinize emin misiniz?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="m-btn m-btn--primary">

                            <i class="fa-solid fa-circle-check"></i>
                            Tamamla

                        </button>

                    </form>
                }

                @if (Model.Status == WorkOrderStatus.Completed &&
                                (User.IsInRole("Admin") ||
                                User.IsInRole("Manager") ||
                                User.IsInRole("Accountant")))
                {
                    <a asp-controller="Invoice"
                       asp-action="Create"
                       asp-route-workOrderId="@Model.WorkOrderId"
                       class="m-btn m-btn--primary">

                        <i class="fa-solid fa-file-invoice"></i>
                        Fatura Oluştur

                    </a>
                }

                @if ((User.IsInRole("Admin") ||
                                User.IsInRole("Manager") ||
                                User.IsInRole("Sales") ||
                                User.IsInRole("Accountant")) &&
                                Model.Status != WorkOrderStatus.Cancelled &&
                                Model.Status != WorkOrderStatus.Rejected &&
                                Model.RemainingAmount > 0)
                {
                    <a asp-controller="Payment"
                       asp-action="Create"
                       asp-route-workOrderId="@Model.WorkOrderId"
                       class="m-btn m-btn--primary">

                        <i class="fa-solid fa-money-bill-wave"></i>
                        Ödeme Al

                    </a>
                }

                @if ((User.IsInRole("Admin") || User.IsInRole("Manager")) &&
                                (Model.Status == WorkOrderStatus.PendingApproval ||
                                 Model.Status == WorkOrderStatus.Approved ||
                                 Model.Status == WorkOrderStatus.InWorkshop) &&
                                Model.TotalPaid <= 0)
                {
                    <form asp-controller="WorkOrder"
                          asp-action="Cancel"
                          asp-route-id="@Model.WorkOrderId"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Bu iş emrini iptal etmek istediğinize emin misiniz?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="m-btn m-btn--ghost">

                            <i class="fa-solid fa-ban"></i>
                            İptal Et

                        </button>

                    </form>
                }

            </div>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="row">

            <!-- Sol alan -->
            <div class="col-lg-8">

                <!-- İş emri bilgileri -->
                <div class="m-card mb-4">

                    <div class="card-header">
                        <strong>İş Emri Bilgileri</strong>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    İş Emri No
                                </small>

                                <div>
                                    <strong>
                                        @Model.WorkOrderNumber
                                    </strong>
                                </div>

                            </div>

                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    Durum
                                </small>

                                <div>
                                    <span class="@statusClass">
                                        @statusText
                                    </span>
                                </div>

                            </div>

                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    Müşteri
                                </small>

                                <div>

                                    <a asp-controller="Customer"
                                       asp-action="Details"
                                       asp-route-id="@Model.CustomerId">

                                        <strong>
                                            @Model.CustomerName
                                        </strong>

                                    </a>

                                </div>

                            </div>

                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    Telefon
                                </small>

                                <div>
                                    @Model.Phone
                                </div>

                            </div>

                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    İş Emri Tarihi
                                </small>

                                <div>
                                    @Model.CreatedDate.ToString("dd.MM.yyyy")
                                </div>

                            </div>

                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    Ödeme Durumu
                                </small>

                                <div>
                                    <span class="@paymentStatusClass">
                                        @paymentStatusText
                                    </span>
                                </div>

                            </div>

                            <div class="col-12">

                                <small class="text-muted">
                                    Açıklama
                                </small>

                                <div>

                                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                                    {
                                        @Model.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Açıklama bulunmuyor.
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Kullanılacak taşlar -->
                <div class="m-card mb-4">

                    <div class="card-header">

                        <strong>
                            Kullanılacak Taşlar
                        </strong>

                    </div>

                    <div class="card-body p-0">

                        <div class="table-responsive">

                            <table class="m-table dt-table">

                                <thead>

                                    <tr>
                                        <th>Taş</th>
                                        <th>Plaka</th>
                                        <th>Birim Fiyat</th>
                                        <th>Toplam</th>
                                        <th>Ölçü / İşlem</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @if (Model.Details.Count > 0)
                                    {
                                        foreach (var detail in Model.Details)
                                        {
                                            <tr>

                                                <td>
                                                    <strong>
                                                        @detail.StoneName
                                                    </strong>
                                                </td>

                                                <td>
                                                    @detail.Quantity plaka
                                                </td>

                                                <td>
                                                    @detail.UnitPrice.ToString("N2") ₺
                                                </td>

                                                <td>
                                                    <strong>
                                                        @detail.LineTotal.ToString("N2") ₺
                                                    </strong>
                                                </td>

                                                <td>

                                                    @if (!string.IsNullOrWhiteSpace(detail.Description))
                                                    {
                                                        @detail.Description
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">
                                                            -
                                                        </span>
                                                    }

                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>

                                            <td colspan="5">

                                                <div class="empty-state">

                                                    <i class="fa-solid fa-layer-group"></i>

                                                    <p>
                                                        Bu iş emrinde taş bulunmuyor.
                                                    </p>

                                                </div>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

                <!-- Kesim işçiliği -->
                <div class="m-card mb-4">

                    <div class="card-header">
                        <strong>Kesim İşçiliği</strong>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            <div class="col-md-4 mb-3">

                                <small class="text-muted">
                                    Kesim Metresi
                                </small>

                                <div>
                                    <strong>
                                        @Model.CuttingMeter.ToString("N2") metre
                                    </strong>
                                </div>

                            </div>

                            <div class="col-md-4 mb-3">

                                <small class="text-muted">
                                    Metre Fiyatı
                                </small>

                                <div>
                                    <strong>
                                        @Model.CuttingPricePerMeter.ToString("N2") ₺
                                    </strong>
                                </div>

                            </div>

                            <div class="col-md-4 mb-3">

                                <small class="text-muted">
                                    İşçilik Toplamı
                                </small>

                                <div>
                                    <strong>
                                        @Model.CuttingTotal.ToString("N2") ₺
                                    </strong>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Ödeme geçmişi -->
                <div class="m-card mb-4">

                    <div class="card-header d-flex justify-content-between align-items-center">

                        <strong>
                            Ödeme Geçmişi
                        </strong>

                        @if (Model.TotalPaid > 0)
                        {
                            <span class="badge bg-success">
                                @Model.TotalPaid.ToString("N2") ₺ Tahsil Edildi
                            </span>
                        }

                    </div>

                    <div class="card-body p-0">

                        <div class="table-responsive">

                            <table class="m-table dt-table">

                                <thead>

                                    <tr>
                                        <th>Tarih</th>
                                        <th>Ödeme Yöntemi</th>
                                        <th>Tutar</th>
                                        <th>Açıklama</th>
                                        <th>İşlem</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @if (Model.Payments.Count > 0)
                                    {
                                        foreach (var payment in Model.Payments)
                                        {
                                            string paymentMethodText;

                                            switch (payment.PaymentMethod)
                                            {
                                                case PaymentMethod.Cash:
                                                    paymentMethodText = "Nakit";
                                                    break;

                                                case PaymentMethod.CreditCard:
                                                    paymentMethodText = "Kredi / Banka Kartı";
                                                    break;

                                                case PaymentMethod.BankTransfer:
                                                    paymentMethodText = "Havale / EFT";
                                                    break;

                                                default:
                                                    paymentMethodText =
                                                    payment.PaymentMethod.ToString();
                                                    break;
                                            }

                                            <tr>

                                                <td>
                                                    @payment.PaymentDate.ToString("dd.MM.yyyy")
                                                </td>

                                                <td>
                                                    @paymentMethodText
                                                </td>

                                                <td>

                                                    <strong class="text-success">
                                                        @payment.Amount.ToString("N2") ₺
                                                    </strong>

                                                </td>

                                                <td>

                                                    @if (!string.IsNullOrWhiteSpace(payment.Description))
                                                    {
                                                        @payment.Description
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">
                                                            -
                                                        </span>
                                                    }

                                                </td>

                                                <td>

                                                    <div class="table-data-feature">

                                                        <a asp-controller="Payment"
                                                           asp-action="Details"
                                                           asp-route-id="@payment.PaymentId"
                                                           class="item"
                                                           title="Ödeme Detayı">

                                                            <i class="fa-solid fa-eye"></i>

                                                        </a>

                                                    </div>

                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>

                                            <td colspan="5">

                                                <div class="empty-state">

                                                    <i class="fa-solid fa-money-bill-wave"></i>

                                                    <p>
                                                        Bu iş emrine henüz ödeme yapılmadı.
                                                    </p>

                                                </div>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Sağ alan -->
            <div class="col-lg-4">

                <!-- Tutar özeti -->
                <div class="m-card mb-4">

                    <div class="card-header">
                        <strong>Tutar Özeti</strong>
                    </div>

                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                Taş Toplamı
                            </span>

                            <strong>
                                @Model.StoneTotal.ToString("N2") ₺
                            </strong>

                        </div>

                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                Kesim İşçiliği
                            </span>

                            <strong>
                                @Model.CuttingTotal.ToString("N2") ₺
                            </strong>

                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                KDV Hariç Ara Toplam
                            </span>

                            <strong>
                                @Model.SubTotal.ToString("N2") ₺
                            </strong>

                        </div>

                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                KDV (@Model.VatRate.ToString("N2")%)
                            </span>

                            <strong>
                                @Model.VatAmount.ToString("N2") ₺
                            </strong>

                        </div>

                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                KDV Dahil Genel Toplam
                            </span>

                            <strong class="fs-5">
                                @Model.TotalAmount.ToString("N2") ₺
                            </strong>

                        </div>

                    </div>

                </div>

                <!-- Ödeme özeti -->
                <div class="m-card mb-4">

                    <div class="card-header d-flex justify-content-between align-items-center">

                        <strong>
                            Ödeme Özeti
                        </strong>

                        <span class="@paymentStatusClass">
                            @paymentStatusText
                        </span>

                    </div>

                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                Toplam Tutar
                            </span>

                            <strong>
                                @Model.TotalAmount.ToString("N2") ₺
                            </strong>

                        </div>

                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                Toplam Ödenen
                            </span>

                            @if (Model.TotalPaid > 0)
                            {
                                <strong class="text-success">
                                    @Model.TotalPaid.ToString("N2") ₺
                                </strong>
                            }
                            else
                            {
                                <strong>
                                    0,00 ₺
                                </strong>
                            }

                        </div>

                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                Kalan Borç
                            </span>

                            @if (Model.RemainingAmount > 0)
                            {
                                <strong class="text-danger">
                                    @Model.RemainingAmount.ToString("N2") ₺
                                </strong>
                            }
                            else
                            {
                                <strong class="text-success">
                                    0,00 ₺
                                </strong>
                            }

                        </div>

                        @if (Model.Status == WorkOrderStatus.Cancelled)
                        {
                            <div class="alert alert-danger mb-0">
                                <i class="fa-solid fa-ban"></i>
                                Bu iş emri iptal edilmiştir.
                            </div>
                        }
                        else if (Model.Status == WorkOrderStatus.Rejected)
                        {
                            <div class="alert alert-danger mb-0">
                                <i class="fa-solid fa-xmark"></i>
                                Bu iş emri reddedilmiştir.
                            </div>
                        }
                        else if (Model.RemainingAmount <= 0)
                        {
                            <div class="alert alert-success mb-0">

                                <i class="fa-solid fa-circle-check"></i>
                                Bu iş emrinin ödemesi tamamlandı.

                            </div>
                        }
                        else if (Model.TotalPaid > 0)
                        {
                            <div class="alert alert-warning mb-3">
                                Kısmi ödeme alındı.
                            </div>

                            @if (User.IsInRole("Admin") ||
                                                    User.IsInRole("Manager") ||
                                                    User.IsInRole("Sales") ||
                                                    User.IsInRole("Accountant"))
                            {
                                <a asp-controller="Payment"
                                   asp-action="Create"
                                   asp-route-workOrderId="@Model.WorkOrderId"
                                   class="m-btn m-btn--primary w-100">

                                    <i class="fa-solid fa-money-bill-wave"></i>
                                    Kalan Ödemeyi Al

                                </a>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning mb-3">
                                Henüz ödeme alınmadı.
                            </div>

                            @if (User.IsInRole("Admin") ||
                                                    User.IsInRole("Manager") ||
                                                    User.IsInRole("Sales") ||
                                                    User.IsInRole("Accountant"))
                            {
                                <a asp-controller="Payment"
                                   asp-action="Create"
                                   asp-route-workOrderId="@Model.WorkOrderId"
                                   class="m-btn m-btn--primary w-100">

                                    <i class="fa-solid fa-money-bill-wave"></i>
                                    Ödeme Al

                                </a>
                            }
                        }

                    </div>

                </div>

                <!-- Hesaplama detayı -->
                <div class="m-card">

                    <div class="card-header">
                        <strong>Hesaplama Detayı</strong>
                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <small class="text-muted">
                                Taş Bedeli
                            </small>

                            <div>
                                @Model.StoneTotal.ToString("N2") ₺
                            </div>

                        </div>

                        <div class="mb-3">

                            <small class="text-muted">
                                Kesim Hesabı
                            </small>

                            <div>
                                @Model.CuttingMeter.ToString("N2")
                                metre ×
                                @Model.CuttingPricePerMeter.ToString("N2")
                                ₺
                            </div>

                        </div>

                        <div class="mb-3">

                            <small class="text-muted">
                                İşçilik Bedeli
                            </small>

                            <div>
                                @Model.CuttingTotal.ToString("N2") ₺
                            </div>

                        </div>

                        <div class="mb-3">

                            <small class="text-muted">
                                KDV Hariç Toplam
                            </small>

                            <div>
                                @Model.SubTotal.ToString("N2") ₺
                            </div>

                        </div>

                        <div class="mb-3">

                            <small class="text-muted">
                                KDV Hesabı
                            </small>

                            <div>
                                @Model.SubTotal.ToString("N2") ₺ ×
                                %@Model.VatRate.ToString("N2")
                            </div>

                        </div>

                        <div>

                            <small class="text-muted">
                                KDV Tutarı
                            </small>

                            <div>
                                <strong>
                                    @Model.VatAmount.ToString("N2") ₺
                                </strong>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>
