@model StoneTech.Models.Invoice.InvoiceDetailsViewModel
@using StoneTech.Enums

@{
    ViewData["Title"] = "Fatura Detayı";

    string statusText;
    string statusClass;

    switch (Model.Status)
    {
        case InvoiceStatus.Draft:
            statusText = "Taslak";
            statusClass = "badge bg-warning text-dark";
            break;

        case InvoiceStatus.Issued:
            statusText = "Düzenlendi";
            statusClass = "badge bg-success";
            break;

        case InvoiceStatus.Cancelled:
            statusText = "İptal Edildi";
            statusClass = "badge bg-secondary";
            break;

        default:
            statusText = Model.Status.ToString();
            statusClass = "badge bg-secondary";
            break;
    }

    string customerTypeText =
        Model.CustomerType == CustomerType.Corporate
            ? "Kurumsal"
            : "Bireysel";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>

                <h1>Fatura @Model.InvoiceNumber</h1>

                <p class="subtitle">
                    Faturaya ait müşteri, iş emri, kalem ve tutar bilgileri.
                </p>

            </div>

            <div class="page-header__actions">

                <!-- Fatura listesine dön -->
                <a asp-controller="Invoice"
                   asp-action="Index"
                   class="m-btn m-btn--ghost">

                    <i class="fa-solid fa-arrow-left"></i>
                    Faturalar

                </a>

                <!-- Taslak faturayı kesinleştir -->
                @if (Model.Status == InvoiceStatus.Draft &&
                                (User.IsInRole("Admin") ||
                                 User.IsInRole("Manager") ||
                                 User.IsInRole("Accountant")))
                {
                    <form asp-controller="Invoice"
                          asp-action="Issue"
                          asp-route-id="@Model.InvoiceId"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Bu faturayı düzenlenmiş olarak kesinleştirmek istediğinize emin misiniz?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="m-btn m-btn--primary">

                            <i class="fa-solid fa-circle-check"></i>
                            Faturayı Kesinleştir

                        </button>

                    </form>
                }

                <!-- Yalnızca kesinleştirilmiş faturada PDF butonu gösterilir -->
                @if (Model.Status == InvoiceStatus.Issued)
                {
                    <a asp-controller="Invoice"
                       asp-action="Pdf"
                       asp-route-id="@Model.InvoiceId"
                       class="m-btn m-btn--primary"
                       target="_blank">

                        <i class="fa-solid fa-file-pdf"></i>
                        Fatura PDF

                    </a>
                }

                <!-- İptal edilmemiş faturalar iptal edilebilir -->
                @if (Model.Status != InvoiceStatus.Cancelled &&
                                (User.IsInRole("Admin") ||
                                 User.IsInRole("Manager") ||
                                 User.IsInRole("Accountant")))
                {
                    <button type="button"
                            class="m-btn m-btn--ghost"
                            data-bs-toggle="modal"
                            data-bs-target="#cancelInvoiceModal">

                        <i class="fa-solid fa-ban"></i>
                        İptal Et

                    </button>
                }

            </div>

        </div>

        <!-- Başarı mesajı -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Hata mesajı -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="row">

            <!-- Sol alan -->
            <div class="col-lg-8">

                <!-- Fatura bilgileri -->
                <div class="m-card mb-4">

                    <div class="card-header">
                        <strong>Fatura Bilgileri</strong>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            <!-- Fatura numarası -->
                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    Fatura No
                                </small>

                                <div>
                                    <strong>
                                        @Model.InvoiceNumber
                                    </strong>
                                </div>

                            </div>

                            <!-- Durum -->
                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    Durum
                                </small>

                                <div>
                                    <span class="@statusClass">
                                        @statusText
                                    </span>
                                </div>

                            </div>

                            <!-- Fatura tarihi -->
                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    Fatura Tarihi
                                </small>

                                <div>
                                    @Model.InvoiceDate.ToString("dd.MM.yyyy")
                                </div>

                            </div>

                            <!-- Oluşturulma tarihi -->
                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    Sisteme Kayıt Tarihi
                                </small>

                                <div>
                                    @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                                </div>

                            </div>

                            <!-- Bağlı iş emri -->
                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    İş Emri
                                </small>

                                <div>

                                    @if (User.IsInRole("Accountant"))
                                    {
                                        <strong>@Model.WorkOrderNumber</strong>
                                    }
                                    else
                                    {
                                        <a asp-controller="WorkOrder"
                                           asp-action="Details"
                                           asp-route-id="@Model.WorkOrderId">
                                            <strong>@Model.WorkOrderNumber</strong>
                                        </a>
                                    }

                                </div>

                            </div>

                            <!-- Açıklama -->
                            <div class="col-12">

                                <small class="text-muted">
                                    Açıklama
                                </small>

                                <div>

                                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                                    {
                                        @Model.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Açıklama bulunmuyor.
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Müşteri bilgileri -->
                <div class="m-card mb-4">

                    <div class="card-header">
                        <strong>Müşteri Bilgileri</strong>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            <!-- Müşteri / firma -->
                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    Müşteri / Firma
                                </small>

                                <div>
                                    <strong>
                                        @Model.CustomerName
                                    </strong>
                                </div>

                            </div>

                            <!-- Müşteri tipi -->
                            <div class="col-md-6 mb-3">

                                <small class="text-muted">
                                    Müşteri Tipi
                                </small>

                                <div>

                                    @if (Model.CustomerType == CustomerType.Corporate)
                                    {
                                        <span class="badge bg-primary">
                                            @customerTypeText
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">
                                            @customerTypeText
                                        </span>
                                    }

                                </div>

                            </div>

                            @if (Model.CustomerType == CustomerType.Corporate)
                            {
                                <!-- Vergi numarası -->
                                <div class="col-md-6 mb-3">

                                    <small class="text-muted">
                                        Vergi Numarası
                                    </small>

                                    <div>
                                        @(string.IsNullOrWhiteSpace(Model.TaxNumber)
                                                                            ? "-"
                                                                            : Model.TaxNumber)
                                                                                          </div>

                                </div>

                                <!-- Vergi dairesi -->
                                <div class="col-md-6 mb-3">

                                    <small class="text-muted">
                                        Vergi Dairesi
                                    </small>

                                    <div>
                                        @(string.IsNullOrWhiteSpace(Model.TaxOffice)
                                                                            ? "-"
                                                                            : Model.TaxOffice)
                                </div>

                                </div>
                                                        }
                            else
                            {
                                <!-- T.C. kimlik numarası -->
                                <div class="col-md-6 mb-3">

                                    <small class="text-muted">
                                        T.C. Kimlik Numarası
                                    </small>

                                    <div>
                                        @(string.IsNullOrWhiteSpace(Model.IdentityNumber)
                                                                            ? "-"
                                                                            : Model.IdentityNumber)
                                </div>

                                </div>
                                                        }

                            <!-- Adres -->
                            <div class="col-12">

                                <small class="text-muted">
                                    Adres
                                </small>

                                <div>

                                    @if (!string.IsNullOrWhiteSpace(Model.Address))
                                    {
                                        @Model.Address
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Adres bilgisi bulunmuyor.
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Fatura kalemleri -->
                <div class="m-card mb-4">

                    <div class="card-header">

                        <strong>
                            Fatura Kalemleri
                        </strong>

                    </div>

                    <div class="card-body p-0">

                        <div class="table-responsive">

                            <table class="m-table dt-table">

                                <thead>

                                    <tr>

                                        <th>Açıklama</th>
                                        <th>Miktar</th>
                                        <th>Birim</th>
                                        <th>Birim Fiyat</th>
                                        <th>Ara Toplam</th>
                                        <th>KDV</th>
                                        <th>Toplam</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @if (Model.Details.Count > 0)
                                    {
                                        foreach (var detail in Model.Details)
                                        {
                                            <tr>

                                                <!-- Açıklama -->
                                                <td>
                                                    <strong>
                                                        @detail.Description
                                                    </strong>
                                                </td>

                                                <!-- Miktar -->
                                                <td>
                                                    @detail.Quantity.ToString("N2")
                                                </td>

                                                <!-- Birim -->
                                                <td>
                                                    @detail.Unit
                                                </td>

                                                <!-- Birim fiyat -->
                                                <td class="text-nowrap">
                                                    @detail.UnitPrice.ToString("N2") ₺
                                                </td>

                                                <!-- KDV hariç satır toplamı -->
                                                <td class="text-nowrap">
                                                    @detail.SubTotal.ToString("N2") ₺
                                                </td>

                                                <!-- KDV -->
                                                <td class="text-nowrap">

                                                    %@detail.VatRate.ToString("N2")

                                                    <div class="text-muted small">
                                                        @detail.VatAmount.ToString("N2") ₺
                                                    </div>

                                                </td>

                                                <!-- KDV dahil satır toplamı -->
                                                <td class="text-nowrap">

                                                    <strong>
                                                        @detail.TotalAmount.ToString("N2") ₺
                                                    </strong>

                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>

                                            <td colspan="7">

                                                <div class="empty-state">

                                                    <i class="fa-solid fa-file-invoice"></i>

                                                    <p>
                                                        Bu faturada kalem bulunmuyor.
                                                    </p>

                                                </div>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Sağ alan -->
            <div class="col-lg-4">

                <!-- Tutar özeti -->
                <div class="m-card mb-4">

                    <div class="card-header">
                        <strong>Fatura Özeti</strong>
                    </div>

                    <div class="card-body">

                        <!-- Ara toplam -->
                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                KDV Hariç Ara Toplam
                            </span>

                            <strong>
                                @Model.SubTotal.ToString("N2") ₺
                            </strong>

                        </div>

                        <!-- KDV -->
                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                KDV (@Model.VatRate.ToString("N2")%)
                            </span>

                            <strong>
                                @Model.VatAmount.ToString("N2") ₺
                            </strong>

                        </div>

                        <hr />

                        <!-- Genel toplam -->
                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                KDV Dahil Genel Toplam
                            </span>

                            <strong class="fs-4 text-primary">
                                @Model.TotalAmount.ToString("N2") ₺
                            </strong>

                        </div>

                    </div>

                </div>

                <!-- Fatura durumu -->
                <div class="m-card mb-4">

                    <div class="card-header d-flex justify-content-between align-items-center">

                        <strong>
                            Fatura Durumu
                        </strong>

                        <span class="@statusClass">
                            @statusText
                        </span>

                    </div>

                    <div class="card-body">

                        @if (Model.Status == InvoiceStatus.Draft &&
                                        (User.IsInRole("Admin") ||
                                         User.IsInRole("Manager") ||
                                         User.IsInRole("Accountant")))
                        {
                            <div class="alert alert-warning mb-3">

                                <i class="fa-solid fa-clock"></i>
                                Bu fatura henüz taslak durumundadır.

                            </div>

                            <form asp-controller="Invoice"
                                  asp-action="Issue"
                                  asp-route-id="@Model.InvoiceId"
                                  method="post"
                                  onsubmit="return confirm('Bu faturayı düzenlenmiş olarak kesinleştirmek istediğinize emin misiniz?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="m-btn m-btn--primary w-100">

                                    <i class="fa-solid fa-circle-check"></i>
                                    Faturayı Kesinleştir

                                </button>

                            </form>
                        }
                        else if (Model.Status == InvoiceStatus.Issued)
                        {
                            <div class="alert alert-success mb-3">

                                <i class="fa-solid fa-circle-check"></i>
                                Fatura düzenlenmiş ve kesinleştirilmiştir.

                            </div>

                            <!-- Kesinleştirilmiş faturanın PDF belgesini açar -->
                            <a asp-controller="Invoice"
                               asp-action="Pdf"
                               asp-route-id="@Model.InvoiceId"
                               class="m-btn m-btn--primary w-100"
                               target="_blank">

                                <i class="fa-solid fa-file-pdf"></i>
                                Fatura PDF

                            </a>
                        }
                        else if (Model.Status == InvoiceStatus.Cancelled)
                        {
                            <div class="alert alert-danger mb-3">

                                <i class="fa-solid fa-ban"></i>
                                <strong>Bu fatura iptal edilmiştir.</strong>

                            </div>

                            <!-- Faturanın iptal edilme nedenini gösterir -->
                            <div>

                                <small class="text-muted">
                                    İptal Nedeni
                                </small>

                                <div class="mt-1">

                                    @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                                    {
                                        @Model.CancellationReason
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            İptal nedeni bulunmuyor.
                                        </span>
                                    }

                                </div>

                            </div>
                        }

                    </div>

                </div>

                <!-- Bağlı iş emri -->
                <div class="m-card">

                    <div class="card-header">
                        <strong>Bağlı İş Emri</strong>
                    </div>

                    <div class="card-body">

                        <small class="text-muted">
                            İş Emri No
                        </small>

                        <div class="mb-3">

                            <strong>
                                @Model.WorkOrderNumber
                            </strong>

                        </div>

                        @if (!User.IsInRole("Accountant"))
                        {
                            <a asp-controller="WorkOrder"
                               asp-action="Details"
                               asp-route-id="@Model.WorkOrderId"
                               class="m-btn m-btn--ghost w-100">
                                <i class="fa-solid fa-eye"></i>
                                İş Emrini Görüntüle
                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>

<!-- FATURA İPTAL MODALI -->
@if (Model.Status != InvoiceStatus.Cancelled &&
    (User.IsInRole("Admin") ||
     User.IsInRole("Manager") ||
     User.IsInRole("Accountant")))
{
    <div class="modal fade" id="cancelInvoiceModal" tabindex="-1" aria-labelledby="cancelInvoiceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cancelInvoiceModalLabel">Faturayı İptal Et</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <form asp-controller="Invoice" asp-action="Cancel" asp-route-id="@Model.InvoiceId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="alert alert-warning">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <strong>@Model.InvoiceNumber</strong> numaralı faturayı iptal etmek üzeresiniz.
                        </div>
                        <div class="mb-3">
                            <label for="cancellationReason" class="form-label">İptal Nedeni</label>
                            <textarea id="cancellationReason" name="cancellationReason" class="form-control" rows="4" maxlength="500" required placeholder="Faturanın neden iptal edildiğini yazınız..."></textarea>
                            <small class="text-muted">En fazla 500 karakter yazabilirsiniz.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="m-btn m-btn--ghost" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="m-btn m-btn--primary">
                            <i class="fa-solid fa-ban"></i> Faturayı İptal Et
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Fatura iptal modalını tema kapsayıcılarının
            // z-index etkisinden çıkarmak için body altına taşır
            const cancelInvoiceModal =
                document.getElementById("cancelInvoiceModal");

            if (cancelInvoiceModal) {
                document.body.appendChild(cancelInvoiceModal);
            }

        });
    </script>
}
