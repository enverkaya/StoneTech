@using StoneTech.Models.Invoice
@using StoneTech.Enums
@model IEnumerable<InvoiceListViewModel>

@{
    ViewData["Title"] = "Faturalar";

    string search = ViewBag.Search ?? "";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalCount = ViewBag.TotalCount ?? 0;

    int firstItem = totalCount == 0
        ? 0
        : ((page - 1) * pageSize) + 1;

    int lastItem = Math.Min(
        page * pageSize,
        totalCount
    );
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>

                <h1>Faturalar</h1>

                <p class="subtitle">
                    Tamamlanmış iş emirlerinden oluşturulan faturaları görüntüleyin ve yönetin.
                </p>

            </div>

        </div>

        <!-- Başarı mesajı -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Hata mesajı -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Faturalar tablosu -->
        <section class="m-card" style="padding: 20px;">

            <!-- Arama ve sayfa başına kayıt -->
            <form asp-controller="Invoice"
                  asp-action="Index"
                  method="get">

                <div class="dt-toolbar">

                    <!-- Arama -->
                    <div class="dt-search">

                        <i class="fa-solid fa-magnifying-glass"
                           aria-hidden="true"></i>

                        <input type="search"
                               name="search"
                               value="@search"
                               placeholder="Fatura no, iş emri no veya müşteri ara..."
                               aria-label="Fatura ara">

                    </div>

                    <!-- Sayfa başına kayıt -->
                    <div style="display: flex;
                                gap: 8px;
                                align-items: center;">

                        <label style="font-size: 12.5px;
                                      color: var(--m-text-muted);
                                      display: inline-flex;
                                      align-items: center;
                                      gap: 8px;">

                            Göster

                            <select name="pageSize"
                                    class="form-select"
                                    style="width: 80px;
                                           height: 32px;
                                           padding: 0 24px 0 10px;
                                           font-size: 12.5px;"
                                    onchange="this.form.submit()">

                                <option value="5"
                                        selected="@(pageSize == 5)">
                                    5
                                </option>

                                <option value="10"
                                        selected="@(pageSize == 10)">
                                    10
                                </option>

                                <option value="20"
                                        selected="@(pageSize == 20)">
                                    20
                                </option>

                                <option value="50"
                                        selected="@(pageSize == 50)">
                                    50
                                </option>

                            </select>

                            kayıt

                        </label>

                    </div>

                </div>

            </form>

            <!-- Tablo -->
            <div class="table-responsive">

                <table class="m-table dt-table"
                       id="dt-table">

                    <thead>

                        <tr>

                            <th>Fatura No</th>
                            <th>İş Emri</th>
                            <th>Müşteri</th>
                            <th>Fatura Tarihi</th>
                            <th>Ara Toplam</th>
                            <th>KDV</th>
                            <th>Genel Toplam</th>
                            <th>Durum</th>
                            <th></th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="9">

                                    <div class="empty-state">

                                        <span class="empty-state__icon">

                                            <i class="fa-solid fa-file-invoice"></i>

                                        </span>

                                        <h3 class="empty-state__title">
                                            Fatura bulunamadı
                                        </h3>

                                        <p class="empty-state__text">

                                            @if (!string.IsNullOrWhiteSpace(search))
                                            {
                                                @:Aramanızla eşleşen fatura bulunamadı.
                                            }
                                            else
                                            {
                                                @:Henüz sistemde oluşturulmuş bir fatura bulunmuyor.
                                            }

                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(search))
                                        {
                                            <div class="empty-state__actions">

                                                <a asp-controller="Invoice"
                                                   asp-action="Index"
                                                   class="m-btn m-btn--ghost">

                                                    Aramayı temizle

                                                </a>

                                            </div>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                string statusText;
                                string statusClass;

                                switch (item.Status)
                                {
                                    case InvoiceStatus.Draft:
                                        statusText = "Taslak";
                                        statusClass = "badge bg-warning text-dark";
                                        break;

                                    case InvoiceStatus.Issued:
                                        statusText = "Düzenlendi";
                                        statusClass = "badge bg-success";
                                        break;

                                    case InvoiceStatus.Cancelled:
                                        statusText = "İptal Edildi";
                                        statusClass = "badge bg-secondary";
                                        break;

                                    default:
                                        statusText = item.Status.ToString();
                                        statusClass = "badge bg-secondary";
                                        break;
                                }

                                <tr>

                                    <!-- Fatura numarası -->
                                    <td>

                                        <span class="name">
                                            @item.InvoiceNumber
                                        </span>

                                    </td>

                                    <!-- İş emri numarası -->
                                    <td>

                                        @if (User.IsInRole("Accountant"))
                                        {
                                            <span class="name">@item.WorkOrderNumber</span>
                                        }
                                        else
                                        {
                                            <a asp-controller="WorkOrder"
                                               asp-action="Details"
                                               asp-route-id="@item.WorkOrderId"
                                               class="name">
                                                @item.WorkOrderNumber
                                            </a>
                                        }

                                    </td>

                                    <!-- Müşteri -->
                                    <td>

                                        <span class="name">
                                            @item.CustomerName
                                        </span>

                                    </td>

                                    <!-- Fatura tarihi -->
                                    <td>

                                        @item.InvoiceDate.ToString("dd.MM.yyyy")

                                    </td>

                                    <!-- Ara toplam -->
                                    <td>

                                        @item.SubTotal.ToString("N2") ₺

                                    </td>

                                    <!-- KDV -->
                                    <td>

                                        @item.VatAmount.ToString("N2") ₺

                                    </td>

                                    <!-- Genel toplam -->
                                    <td>

                                        <strong>
                                            @item.TotalAmount.ToString("N2") ₺
                                        </strong>

                                    </td>

                                    <!-- Fatura durumu -->
                                    <td>

                                        <span class="@statusClass">
                                            @statusText
                                        </span>

                                    </td>

                                    <!-- İşlemler -->
                                    <td>

                                        <div class="table-data-feature">

                                            <!-- Fatura detayını görüntüle -->
                                            <a asp-controller="Invoice"
                                               asp-action="Details"
                                               asp-route-id="@item.InvoiceId"
                                               class="item"
                                               data-bs-toggle="tooltip"
                                               title="Fatura Detayı">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <!-- Sayfalama -->
            <div class="dt-pagination">

                <!-- Gösterilen kayıt bilgisi -->
                <span class="dt-pagination__info">

                    @if (totalCount == 0)
                    {
                        @:Sonuç yok
                    }
                    else
                    {
                        @:@firstItem–@lastItem / @totalCount kayıt
                    }

                </span>

                <!-- Sayfa navigasyonu -->
                <div class="dt-pagination__nav">

                    <!-- Önceki sayfa -->
                    @if (page > 1)
                    {
                        <a asp-controller="Invoice"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page - 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-left"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                disabled>

                            <i class="fa-solid fa-chevron-left"></i>

                        </button>
                    }

                    <!-- Sayfa numaraları -->
                    @if (totalPages > 0)
                    {
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            @if (i == page)
                            {
                                <button type="button"
                                        class="is-active"
                                        disabled>

                                    @i

                                </button>
                            }
                            else
                            {
                                <a asp-controller="Invoice"
                                   asp-action="Index"
                                   asp-route-search="@search"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@pageSize">

                                    @i

                                </a>
                            }
                        }
                    }

                    <!-- Sonraki sayfa -->
                    @if (totalPages > 0 && page < totalPages)
                    {
                        <a asp-controller="Invoice"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page + 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                disabled>

                            <i class="fa-solid fa-chevron-right"></i>

                        </button>
                    }

                </div>

            </div>

        </section>

    </div>
</div>
