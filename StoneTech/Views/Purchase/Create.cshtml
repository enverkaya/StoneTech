@using StoneTech.Models.Purchase
@model PurchaseCreateViewModel

@{
    ViewData["Title"] = "Yeni Alım";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <div class="page-header">
            <div>
                <h1>Yeni Alım</h1>
                <p class="subtitle">
                    Tedarikçiden yapılan taş alımını ve stok girişini kaydedin.
                </p>
            </div>
        </div>

        <form asp-controller="Purchase"
              asp-action="Create"
              method="post"
              id="purchaseForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Alım Bilgileri -->
            <div class="card">

                <div class="card-header">
                    Alım Bilgileri
                </div>

                <div class="card-body">

                    <div class="row">

                        <!-- Tedarikçi -->
                        <div class="col-md-6">

                            <div class="mb-3">

                                <label asp-for="SupplierId"
                                       class="form-control-label">
                                    Tedarikçi
                                </label>

                                <select asp-for="SupplierId"
                                        class="form-select">

                                    <option value="0">
                                        Tedarikçi seçiniz
                                    </option>

                                    @foreach (var supplier in ViewBag.Suppliers)
                                    {
                                        <option value="@supplier.SupplierId">
                                            @supplier.SupplierName
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="SupplierId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <!-- Alım Tarihi -->
                        <div class="col-md-6">

                            <div class="mb-3">

                                <label asp-for="PurchaseDate"
                                       class="form-control-label">
                                    Alım Tarihi
                                </label>

                                <input asp-for="PurchaseDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="PurchaseDate"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                    <!-- Açıklama -->
                    <div class="mb-3">

                        <label asp-for="Description"
                               class="form-control-label">
                            Açıklama
                        </label>

                        <textarea asp-for="Description"
                                  rows="3"
                                  class="form-control"
                                  placeholder="Alımla ilgili açıklama..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

            <!-- Alınan Taşlar -->
            <div class="card">

                <div class="card-header">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            Alınan Taşlar
                        </div>

                        <button type="button"
                                id="addStoneButton"
                                class="btn btn-primary btn-sm">

                            <i class="fa-solid fa-plus"></i>
                            Taş Ekle

                        </button>

                    </div>

                </div>

                <div class="card-body">

                    <span asp-validation-for="Details"
                          class="text-danger d-block mb-3">
                    </span>

                    <div id="purchaseDetailsBody">

                        @for (int i = 0; i < Model.Details.Count; i++)
                        {
                            <div class="purchase-detail-row">

                                <div class="row mb-3">

                                    <!-- Taş -->
                                    <div class="col-md-4">

                                        <label class="form-control-label">
                                            Taş
                                        </label>

                                        <select name="Details[@i].StoneId"
                                                class="form-select stone-select">

                                            <option value="0">
                                                Taş seçiniz
                                            </option>

                                            @foreach (var stone in ViewBag.Stones)
                                            {
                                                if (Model.Details[i].StoneId == stone.StoneId)
                                                {
                                                    <option value="@stone.StoneId"
                                                            data-price="@stone.PurchasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                            selected>
                                                        @stone.StoneName
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@stone.StoneId"
                                                            data-price="@stone.PurchasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                        @stone.StoneName
                                                    </option>
                                                }
                                            }

                                        </select>

                                        <span class="text-danger field-validation-valid"
                                              data-valmsg-for="Details[@i].StoneId"
                                              data-valmsg-replace="true">
                                        </span>

                                    </div>

                                    <!-- Plaka Adedi -->
                                    <div class="col-md-2">

                                        <label class="form-control-label">
                                            Plaka Adedi
                                        </label>

                                        <input name="Details[@i].Quantity"
                                               value="@(Model.Details[i].Quantity > 0 ? Model.Details[i].Quantity.ToString() : "")"
                                               type="number"
                                               min="1"
                                               step="1"
                                               class="form-control quantity-input"
                                               placeholder="Adet" />

                                        <span class="text-danger field-validation-valid"
                                              data-valmsg-for="Details[@i].Quantity"
                                              data-valmsg-replace="true">
                                        </span>

                                    </div>

                                    <!-- Birim Alış Fiyatı -->
                                    <div class="col-md-3">

                                        <label class="form-control-label">
                                            Birim Alış Fiyatı
                                        </label>

                                        <input name="Details[@i].UnitPrice"
                                               value="@(Model.Details[i].UnitPrice > 0 ? Model.Details[i].UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                               type="number"
                                               min="0.01"
                                               step="0.01"
                                               class="form-control price-input"
                                               placeholder="0,00" />

                                        <span class="text-danger field-validation-valid"
                                              data-valmsg-for="Details[@i].UnitPrice"
                                              data-valmsg-replace="true">
                                        </span>

                                    </div>

                                    <!-- Satır Toplamı -->
                                    <div class="col-md-2">

                                        <label class="form-control-label">
                                            Satır Toplamı
                                        </label>

                                        <input type="text"
                                               class="form-control line-total"
                                               value="0,00 ₺"
                                               readonly />

                                    </div>

                                    <!-- Sil -->
                                    <div class="col-md-1">

                                        <label class="form-control-label">
                                            &nbsp;
                                        </label>

                                        <div class="d-grid">

                                            <button type="button"
                                                    class="btn btn-danger remove-detail-button"
                                                    title="Taşı kaldır">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </div>

                                    </div>

                                </div>

                                <hr />

                            </div>
                        }

                    </div>

                </div>

                <!-- Genel Toplam -->
                <div class="card-footer">

                    <div class="row">

                        <div class="col-md-8">
                        </div>

                        <div class="col-md-4">

                            <label class="form-control-label">
                                Genel Toplam
                            </label>

                            <input type="text"
                                   id="grandTotal"
                                   class="form-control"
                                   value="0,00 ₺"
                                   readonly />

                        </div>

                    </div>

                </div>

            </div>

            <!-- Form İşlemleri -->
            <div class="card">

                <div class="card-footer">

                    <button type="submit"
                            class="btn btn-success">

                        <i class="fa-solid fa-floppy-disk"></i>
                        Alımı Kaydet

                    </button>

                    <a asp-controller="Purchase"
                       asp-action="Index"
                       class="btn btn-secondary">

                        <i class="fa-solid fa-arrow-left"></i>
                        İptal

                    </a>

                </div>

            </div>

        </form>

    </div>
</div>

<!-- Dinamik olarak eklenecek taş satırı -->
<template id="purchaseDetailTemplate">

    <div class="purchase-detail-row">

        <div class="row mb-3">

            <!-- Taş -->
            <div class="col-md-4">

                <label class="form-control-label">
                    Taş
                </label>

                <select name="Details[__index__].StoneId"
                        class="form-select stone-select">

                    <option value="0">
                        Taş seçiniz
                    </option>

                    @foreach (var stone in ViewBag.Stones)
                    {
                        <option value="@stone.StoneId"
                                data-price="@stone.PurchasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            @stone.StoneName
                        </option>
                    }

                </select>

                <span class="text-danger field-validation-valid"
                      data-valmsg-for="Details[__index__].StoneId"
                      data-valmsg-replace="true">
                </span>

            </div>

            <!-- Plaka Adedi -->
            <div class="col-md-2">

                <label class="form-control-label">
                    Plaka Adedi
                </label>

                <input name="Details[__index__].Quantity"
                       type="number"
                       min="1"
                       step="1"
                       class="form-control quantity-input"
                       placeholder="Adet" />

                <span class="text-danger field-validation-valid"
                      data-valmsg-for="Details[__index__].Quantity"
                      data-valmsg-replace="true">
                </span>

            </div>

            <!-- Birim Alış Fiyatı -->
            <div class="col-md-3">

                <label class="form-control-label">
                    Birim Alış Fiyatı
                </label>

                <input name="Details[__index__].UnitPrice"
                       type="number"
                       min="0.01"
                       step="0.01"
                       class="form-control price-input"
                       placeholder="0,00" />

                <span class="text-danger field-validation-valid"
                      data-valmsg-for="Details[__index__].UnitPrice"
                      data-valmsg-replace="true">
                </span>

            </div>

            <!-- Satır Toplamı -->
            <div class="col-md-2">

                <label class="form-control-label">
                    Satır Toplamı
                </label>

                <input type="text"
                       class="form-control line-total"
                       value="0,00 ₺"
                       readonly />

            </div>

            <!-- Sil -->
            <div class="col-md-1">

                <label class="form-control-label">
                    &nbsp;
                </label>

                <div class="d-grid">

                    <button type="button"
                            class="btn btn-danger remove-detail-button"
                            title="Taşı kaldır">

                        <i class="fa-solid fa-trash"></i>

                    </button>

                </div>

            </div>

        </div>

        <hr />

    </div>

</template>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const detailsBody =
                document.getElementById("purchaseDetailsBody");

            const addStoneButton =
                document.getElementById("addStoneButton");

            const detailTemplate =
                document.getElementById("purchaseDetailTemplate");

            const grandTotal =
                document.getElementById("grandTotal");

            // Para değerini Türk Lirası biçiminde gösterir
            function formatMoney(value) {

                return new Intl.NumberFormat("tr-TR", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(value) + " ₺";
            }

            // Satır indexlerini ASP.NET Core Model Binding'e uygun şekilde yeniler
            function reindexRows() {

                const rows =
                    detailsBody.querySelectorAll(".purchase-detail-row");

                rows.forEach(function (row, index) {

                    const controls =
                        row.querySelectorAll("[name]");

                    controls.forEach(function (control) {

                        control.name =
                            control.name.replace(
                                /Details\[\d+\]/g,
                                "Details[" + index + "]"
                            );
                    });

                    const validationMessages =
                        row.querySelectorAll("[data-valmsg-for]");

                    validationMessages.forEach(function (validation) {

                        const currentName =
                            validation.getAttribute("data-valmsg-for");

                        if (!currentName) {
                            return;
                        }

                        validation.setAttribute(
                            "data-valmsg-for",
                            currentName.replace(
                                /Details\[\d+\]/g,
                                "Details[" + index + "]"
                            )
                        );
                    });
                });
            }

            // Tek satırın toplamını hesaplar
            function calculateRow(row) {

                const quantityInput =
                    row.querySelector(".quantity-input");

                const priceInput =
                    row.querySelector(".price-input");

                const lineTotal =
                    row.querySelector(".line-total");

                const quantity =
                    parseInt(quantityInput.value) || 0;

                const price =
                    parseFloat(priceInput.value) || 0;

                const total =
                    quantity * price;

                lineTotal.value =
                    formatMoney(total);

                return total;
            }

            // Genel toplamı hesaplar
            function calculateGrandTotal() {

                let total = 0;

                const rows =
                    detailsBody.querySelectorAll(".purchase-detail-row");

                rows.forEach(function (row) {

                    total += calculateRow(row);
                });

                grandTotal.value =
                    formatMoney(total);
            }

            // Taş seçildiğinde kayıtlı alış fiyatını getirir
            function handleStoneChange(select) {

                const row =
                    select.closest(".purchase-detail-row");

                const priceInput =
                    row.querySelector(".price-input");

                const selectedOption =
                    select.options[select.selectedIndex];

                if (!selectedOption ||
                    selectedOption.value === "0") {

                    priceInput.value = "";

                    calculateGrandTotal();

                    return;
                }

                const purchasePrice =
                    selectedOption.dataset.price;

                if (purchasePrice) {

                    priceInput.value =
                        purchasePrice;
                }

                calculateGrandTotal();
            }

            // Yeni taş satırı ekler
            function addDetailRow() {

                const currentCount =
                    detailsBody.querySelectorAll(
                        ".purchase-detail-row"
                    ).length;

                const html =
                    detailTemplate.innerHTML.replaceAll(
                        "__index__",
                        currentCount
                    );

                detailsBody.insertAdjacentHTML(
                    "beforeend",
                    html
                );

                reindexRows();

                calculateGrandTotal();
            }

            // Taş Ekle butonu
            addStoneButton.addEventListener(
                "click",
                function () {

                    addDetailRow();
                }
            );

            // Select değişikliklerini yakalar
            detailsBody.addEventListener(
                "change",
                function (event) {

                    if (
                        event.target.classList.contains(
                            "stone-select"
                        )
                    ) {

                        handleStoneChange(
                            event.target
                        );
                    }

                    if (
                        event.target.classList.contains(
                            "quantity-input"
                        ) ||
                        event.target.classList.contains(
                            "price-input"
                        )
                    ) {

                        calculateGrandTotal();
                    }
                }
            );

            // Adet veya fiyat yazılırken toplamı anlık hesaplar
            detailsBody.addEventListener(
                "input",
                function (event) {

                    if (
                        event.target.classList.contains(
                            "quantity-input"
                        ) ||
                        event.target.classList.contains(
                            "price-input"
                        )
                    ) {

                        calculateGrandTotal();
                    }
                }
            );

            // Taş satırını kaldırır
            detailsBody.addEventListener(
                "click",
                function (event) {

                    const removeButton =
                        event.target.closest(
                            ".remove-detail-button"
                        );

                    if (!removeButton) {
                        return;
                    }

                    const rows =
                        detailsBody.querySelectorAll(
                            ".purchase-detail-row"
                        );

                    // En az bir taş satırı bırakılır
                    if (rows.length <= 1) {
                        return;
                    }

                    const row =
                        removeButton.closest(
                            ".purchase-detail-row"
                        );

                    row.remove();

                    reindexRows();

                    calculateGrandTotal();
                }
            );

            // Sayfa açıldığında mevcut değerleri hesaplar
            calculateGrandTotal();

        });
    </script>
}