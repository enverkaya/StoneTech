@using StoneTech.Models.Purchase
@model PurchaseEditViewModel

@{
    ViewData["Title"] = "Alım Düzenle";

    var suppliers = ViewBag.Suppliers;
    var stones = ViewBag.Stones;
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <div class="page-header">
            <div>
                <h1>Alım Düzenle</h1>

                <p class="subtitle">
                    @Model.PurchaseNumber numaralı alım kaydındaki hatalı bilgileri düzeltin.
                </p>
            </div>

            <div class="page-header__actions">

                <a asp-controller="Purchase"
                   asp-action="Details"
                   asp-route-id="@Model.PurchaseId"
                   class="btn btn-secondary">

                    <i class="fa-solid fa-arrow-left"></i>
                    Detaya Dön

                </a>

            </div>
        </div>

        <form asp-controller="Purchase"
              asp-action="Edit"
              asp-route-id="@Model.PurchaseId"
              method="post"
              id="purchaseEditForm">

            @Html.AntiForgeryToken()

            <input asp-for="PurchaseId" type="hidden" />
            <input asp-for="PurchaseNumber" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Alım Bilgileri -->
            <div class="card">

                <div class="card-header">
                    Alım Bilgileri
                </div>

                <div class="card-body">

                    <div class="row">

                        <!-- Alım No -->
                        <div class="col-md-4">

                            <div class="mb-3">

                                <label class="form-control-label">
                                    Alım No
                                </label>

                                <input type="text"
                                       class="form-control"
                                       value="@Model.PurchaseNumber"
                                       readonly />

                                <small class="form-text text-muted">
                                    Alım numarası değiştirilemez.
                                </small>

                            </div>

                        </div>

                        <!-- Tedarikçi -->
                        <div class="col-md-4">

                            <div class="mb-3">

                                <label asp-for="SupplierId"
                                       class="form-control-label">
                                    Tedarikçi
                                </label>

                                <select asp-for="SupplierId"
                                        class="form-select">

                                    <option value="">
                                        Tedarikçi seçiniz
                                    </option>

                                    @foreach (var supplier in suppliers)
                                    {
                                        <option value="@supplier.SupplierId">
                                            @supplier.SupplierName
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="SupplierId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <!-- Alım Tarihi -->
                        <div class="col-md-4">

                            <div class="mb-3">

                                <label asp-for="PurchaseDate"
                                       class="form-control-label">
                                    Alım Tarihi
                                </label>

                                <input asp-for="PurchaseDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="PurchaseDate"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                    <!-- Açıklama -->
                    <div class="mb-3">

                        <label asp-for="Description"
                               class="form-control-label">
                            Açıklama
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Alımla ilgili açıklama..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

            <!-- Alınan Taşlar -->
            <div class="card">

                <div class="card-header">
                    Alınan Taşlar
                </div>

                <div class="card-body">

                    <div asp-validation-for="Details"
                         class="text-danger mb-3">
                    </div>

                    <div class="table-responsive">

                        <table class="table table-bordered"
                               id="purchaseDetailsTable">

                            <thead>
                                <tr>
                                    <th>Taş</th>
                                    <th style="width: 160px;">
                                        Plaka Adedi
                                    </th>
                                    <th style="width: 200px;">
                                        Birim Alış Fiyatı
                                    </th>
                                    <th style="width: 200px;">
                                        Satır Toplamı
                                    </th>
                                    <th style="width: 70px;"></th>
                                </tr>
                            </thead>

                            <tbody id="purchaseDetailsBody">

                                @for (int i = 0; i < Model.Details.Count; i++)
                                {
                                    <tr class="detail-row">

                                        <td>

                                            <input asp-for="Details[i].PurchaseDetailId"
                                                   type="hidden" />

                                            <select asp-for="Details[i].StoneId"
                                                    class="form-select stone-select">

                                                <option value="">
                                                    Taş seçiniz
                                                </option>

                                                @foreach (var stone in stones)
                                                {
                                                    <option value="@stone.StoneId"
                                                            data-price="@stone.PurchasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                                        @stone.StoneName
                                                    </option>
                                                }

                                            </select>

                                            <span asp-validation-for="Details[i].StoneId"
                                                  class="text-danger">
                                            </span>

                                        </td>

                                        <td>

                                            <input asp-for="Details[i].Quantity"
                                                   type="number"
                                                   min="1"
                                                   class="form-control quantity-input" />

                                            <span asp-validation-for="Details[i].Quantity"
                                                  class="text-danger">
                                            </span>

                                        </td>

                                        <td>

                                            <input asp-for="Details[i].UnitPrice"
                                                   type="number"
                                                   min="0.01"
                                                   step="0.01"
                                                   class="form-control price-input" />

                                            <span asp-validation-for="Details[i].UnitPrice"
                                                  class="text-danger">
                                            </span>

                                        </td>

                                        <td>

                                            <input type="text"
                                                   class="form-control line-total"
                                                   readonly />

                                        </td>

                                        <td class="text-center">

                                            <button type="button"
                                                    class="btn btn-danger remove-row">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    <button type="button"
                            id="addStoneRow"
                            class="btn btn-secondary">

                        <i class="fa-solid fa-plus"></i>
                        Taş Ekle

                    </button>

                </div>

                <div class="card-footer">

                    <div class="row">

                        <div class="col-md-8">
                        </div>

                        <div class="col-md-4">

                            <label class="form-control-label">
                                Genel Toplam
                            </label>

                            <input type="text"
                                   id="grandTotal"
                                   class="form-control"
                                   readonly />

                        </div>

                    </div>

                </div>

            </div>

            <!-- Kaydet -->
            <div class="card">

                <div class="card-footer">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-floppy-disk"></i>
                        Değişiklikleri Kaydet

                    </button>

                    <a asp-controller="Purchase"
                       asp-action="Details"
                       asp-route-id="@Model.PurchaseId"
                       class="btn btn-secondary">

                        İptal

                    </a>

                </div>

            </div>

        </form>

    </div>
</div>

<!-- Yeni satır şablonu -->
<template id="detailRowTemplate">

    <tr class="detail-row">

        <td>

            <input type="hidden"
                   name="Details[__index__].PurchaseDetailId"
                   value="0" />

            <select name="Details[__index__].StoneId"
                    class="form-select stone-select">

                <option value="">
                    Taş seçiniz
                </option>

                @foreach (var stone in stones)
                {
                    <option value="@stone.StoneId"
                            data-price="@stone.PurchasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        @stone.StoneName
                    </option>
                }

            </select>

        </td>

        <td>

            <input type="number"
                   name="Details[__index__].Quantity"
                   value="1"
                   min="1"
                   class="form-control quantity-input" />

        </td>

        <td>

            <input type="number"
                   name="Details[__index__].UnitPrice"
                   value="0"
                   min="0.01"
                   step="0.01"
                   class="form-control price-input" />

        </td>

        <td>

            <input type="text"
                   class="form-control line-total"
                   readonly />

        </td>

        <td class="text-center">

            <button type="button"
                    class="btn btn-danger remove-row">

                <i class="fa-solid fa-trash"></i>

            </button>

        </td>

    </tr>

</template>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const body =
                document.getElementById("purchaseDetailsBody");

            const addButton =
                document.getElementById("addStoneRow");

            const template =
                document.getElementById("detailRowTemplate");

            const grandTotal =
                document.getElementById("grandTotal");


            // Para değerini Türk Lirası görünümünde gösterir.
            function formatCurrency(value) {

                return new Intl.NumberFormat("tr-TR", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(value) + " ₺";
            }


            // Bir satırın toplam tutarını hesaplar.
            function calculateRow(row) {

                const quantityInput =
                    row.querySelector(".quantity-input");

                const priceInput =
                    row.querySelector(".price-input");

                const lineTotalInput =
                    row.querySelector(".line-total");

                const quantity =
                    parseFloat(quantityInput?.value) || 0;

                const price =
                    parseFloat(priceInput?.value) || 0;

                const total =
                    quantity * price;

                if (lineTotalInput) {
                    lineTotalInput.value =
                        formatCurrency(total);
                }

                return total;
            }


            // Bütün satırların toplamını hesaplar.
            function calculateGrandTotal() {

                let total = 0;

                body.querySelectorAll(".detail-row")
                    .forEach(function (row) {

                        total += calculateRow(row);

                    });

                grandTotal.value =
                    formatCurrency(total);
            }


            // Satır indekslerini yeniden düzenler.
            // ASP.NET Core model binding için Details[0], Details[1]
            // şeklinde kesintisiz indeks gerekir.
            function reindexRows() {

                const rows =
                    body.querySelectorAll(".detail-row");

                rows.forEach(function (row, index) {

                    row.querySelectorAll(
                        "input[name], select[name]"
                    ).forEach(function (element) {

                        element.name =
                            element.name.replace(
                                /Details\[\d+\]/g,
                                "Details[" + index + "]"
                            );
                    });

                });
            }


            // Yeni taş satırı ekler.
            addButton.addEventListener(
                "click",
                function () {

                    const index =
                        body.querySelectorAll(
                            ".detail-row"
                        ).length;

                    const html =
                        template.innerHTML.replaceAll(
                            "__index__",
                            index
                        );

                    body.insertAdjacentHTML(
                        "beforeend",
                        html
                    );

                    calculateGrandTotal();
                }
            );


            // Satır silme, adet/fiyat değişikliği ve
            // taş seçimi olaylarını yönetir.
            body.addEventListener(
                "click",
                function (event) {

                    const removeButton =
                        event.target.closest(
                            ".remove-row"
                        );

                    if (!removeButton) {
                        return;
                    }

                    const rows =
                        body.querySelectorAll(
                            ".detail-row"
                        );

                    // Alımda en az bir taş satırı kalmalıdır.
                    if (rows.length <= 1) {
                        return;
                    }

                    removeButton
                        .closest(".detail-row")
                        .remove();

                    reindexRows();
                    calculateGrandTotal();
                }
            );


            body.addEventListener(
                "input",
                function (event) {

                    if (
                        event.target.classList.contains(
                            "quantity-input"
                        ) ||
                        event.target.classList.contains(
                            "price-input"
                        )
                    ) {
                        calculateGrandTotal();
                    }
                }
            );


            // Yeni bir taş seçildiğinde o taşın mevcut
            // alış maliyetini fiyat alanına otomatik getirir.
            //
            // Mevcut satırdaki taş değiştirilmediği sürece
            // kayıtlı eski UnitPrice değerine dokunulmaz.
            body.addEventListener(
                "change",
                function (event) {

                    if (!event.target.classList.contains(
                        "stone-select"
                    )) {
                        return;
                    }

                    const row =
                        event.target.closest(
                            ".detail-row"
                        );

                    const selectedOption =
                        event.target.options[
                            event.target.selectedIndex
                        ];

                    const price =
                        selectedOption?.dataset.price;

                    const priceInput =
                        row.querySelector(
                            ".price-input"
                        );

                    if (priceInput && price) {
                        priceInput.value = price;
                    }

                    calculateGrandTotal();
                }
            );


            // Sayfa ilk açıldığında mevcut kayıtların
            // satır ve genel toplamlarını hesaplar.
            calculateGrandTotal();

        });
    </script>
}