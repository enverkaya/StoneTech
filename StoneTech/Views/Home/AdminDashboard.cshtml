@using StoneTech.Enums
@model StoneTech.Models.Dashboard.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        @* Sayfa başlığı *@
        <div class="page-header">

            <div>
                <h1>
                    Hoş Geldiniz, @Model.CurrentUserFullName
                </h1>

                <p class="subtitle">
                    İşletmenin finansal, operasyonel ve stok durumunu tek ekrandan takip edin.
                </p>
            </div>

            <div class="page-header__actions">

                <span class="date-chip">
                    <i class="fa-regular fa-calendar"></i>
                    <span id="dashboardDate"></span>
                </span>

                <span class="date-chip">
                    <i class="fa-regular fa-clock"></i>
                    <span id="dashboardClock"></span>
                </span>

                <a asp-controller="Report"
                   asp-action="Index"
                   class="m-btn m-btn--ghost">
                    <i class="fa-solid fa-chart-column"></i>
                    Rapor Merkezi
                </a>

            </div>

        </div>


        @* Birinci sıra - Finansal özet *@
        <div class="row row-tight">

            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Aylık Ciro
                        </p>

                        <span class="stat-card__icon stat-card__icon--c1">
                            <i class="fa-solid fa-turkish-lira-sign"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.MonthlyRevenue.ToString("N2") ₺
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-regular fa-calendar"></i>

                        <span class="stat-card__delta-period">
                            Bu ay tamamlanan işler
                        </span>
                    </p>

                </article>
            </div>


            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Aylık Tahsilat
                        </p>

                        <span class="stat-card__icon stat-card__icon--c2">
                            <i class="fa-solid fa-wallet"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.MonthlyCollection.ToString("N2") ₺
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-solid fa-arrow-trend-up"></i>

                        <span class="stat-card__delta-period">
                            Bu ay alınan ödemeler
                        </span>
                    </p>

                </article>
            </div>


            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Toplam Alacak
                        </p>

                        <span class="stat-card__icon stat-card__icon--c3">
                            <i class="fa-solid fa-hand-holding-dollar"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.TotalReceivable.ToString("N2") ₺
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-solid fa-clock"></i>

                        <span class="stat-card__delta-period">
                            Tahsil edilmemiş bakiye
                        </span>
                    </p>

                </article>
            </div>


            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Toplam Stok
                        </p>

                        <span class="stat-card__icon stat-card__icon--c4">
                            <i class="fa-solid fa-layer-group"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.TotalStock.ToString("N0")
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-solid fa-boxes-stacked"></i>

                        <span class="stat-card__delta-period">
                            Mevcut plaka
                        </span>
                    </p>

                </article>
            </div>

        </div>


        @* İkinci sıra - Operasyon özeti *@
        <div class="row row-tight mt-3">

            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Onay Bekleyen
                        </p>

                        <span class="stat-card__icon stat-card__icon--c1">
                            <i class="fa-solid fa-hourglass-half"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.PendingApprovalCount
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-solid fa-file-circle-question"></i>

                        <span class="stat-card__delta-period">
                            İş emri
                        </span>
                    </p>

                </article>
            </div>


            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Atölyede
                        </p>

                        <span class="stat-card__icon stat-card__icon--c2">
                            <i class="fa-solid fa-hammer"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.InWorkshopCount
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-solid fa-gears"></i>

                        <span class="stat-card__delta-period">
                            Devam eden iş
                        </span>
                    </p>

                </article>
            </div>


            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Bu Ay Tamamlanan
                        </p>

                        <span class="stat-card__icon stat-card__icon--c3">
                            <i class="fa-solid fa-circle-check"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.MonthlyCompletedCount
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-solid fa-check"></i>

                        <span class="stat-card__delta-period">
                            Tamamlanan iş
                        </span>
                    </p>

                </article>
            </div>


            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Kritik Stok
                        </p>

                        <span class="stat-card__icon stat-card__icon--c4">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.CriticalStockCount
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-solid fa-layer-group"></i>

                        <span class="stat-card__delta-period">
                            5 plaka veya altındaki taş
                        </span>
                    </p>

                </article>
            </div>

        </div>


        @* Üçüncü sıra - İşletme özeti *@
        <div class="row row-tight mt-3">

            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Bu Ay Satın Alma
                        </p>

                        <span class="stat-card__icon stat-card__icon--c1">
                            <i class="fa-solid fa-truck"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.MonthlyPurchaseAmount.ToString("N2") ₺
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-solid fa-cart-flatbed"></i>

                        <span class="stat-card__delta-period">
                            Toplam alım tutarı
                        </span>
                    </p>

                </article>
            </div>


            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Bu Ay Fatura
                        </p>

                        <span class="stat-card__icon stat-card__icon--c2">
                            <i class="fa-solid fa-file-invoice"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.MonthlyInvoiceCount
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-solid fa-file-lines"></i>

                        <span class="stat-card__delta-period">
                            Oluşturulan fatura
                        </span>
                    </p>

                </article>
            </div>


            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Aktif Müşteri
                        </p>

                        <span class="stat-card__icon stat-card__icon--c3">
                            <i class="fa-solid fa-users"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.ActiveCustomerCount
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-solid fa-user-check"></i>

                        <span class="stat-card__delta-period">
                            Aktif müşteri
                        </span>
                    </p>

                </article>
            </div>


            <div class="col-sm-6 col-lg-3">
                <article class="stat-card">

                    <div class="stat-card__head">

                        <p class="stat-card__label">
                            Aktif Tedarikçi
                        </p>

                        <span class="stat-card__icon stat-card__icon--c4">
                            <i class="fa-solid fa-building"></i>
                        </span>

                    </div>

                    <p class="stat-card__value">
                        @Model.ActiveSupplierCount
                    </p>

                    <p class="stat-card__delta">
                        <i class="fa-solid fa-truck-field"></i>

                        <span class="stat-card__delta-period">
                            Aktif tedarikçi
                        </span>
                    </p>

                </article>
            </div>

        </div>


        @* Son iş emirleri ve son tahsilatlar *@
        <div class="row row-tight mt-3">

            <div class="col-xl-7">

                <section class="m-card">

                    <header class="m-card__header">

                        <div>
                            <h2 class="m-card__title">
                                Son İş Emirleri
                            </h2>

                            <p class="m-card__subtitle">
                                Sisteme eklenen son 5 iş emri.
                            </p>
                        </div>

                        <a asp-controller="WorkOrder"
                           asp-action="Index"
                           class="m-btn m-btn--ghost">
                            Tümünü Gör
                        </a>

                    </header>


                    <div class="table-responsive">

                        <table class="m-table">

                            <thead>
                                <tr>
                                    <th>İş Emri</th>
                                    <th>Müşteri</th>
                                    <th>Tarih</th>
                                    <th>Durum</th>
                                    <th class="num">Tutar</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (Model.RecentWorkOrders.Any())
                                {
                                    foreach (var item in Model.RecentWorkOrders)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @item.WorkOrderNumber
                                                </strong>
                                            </td>

                                            <td>
                                                @item.CustomerName
                                            </td>

                                            <td>
                                                @item.CreatedDate.ToString("dd.MM.yyyy")
                                            </td>

                                            <td>
                                                @switch (item.Status)
                                                {
                                                    case WorkOrderStatus.PendingApproval:
                                                        <span class="status--process">
                                                            Onay Bekliyor
                                                        </span>
                                                        break;

                                                    case WorkOrderStatus.Approved:
                                                        <span class="status--approved">
                                                            Onaylandı
                                                        </span>
                                                        break;

                                                    case WorkOrderStatus.InWorkshop:
                                                        <span class="status--process">
                                                            Atölyede
                                                        </span>
                                                        break;

                                                    case WorkOrderStatus.Completed:
                                                        <span class="badge bg-success">
                                                            Tamamlandı
                                                        </span>
                                                        break;

                                                    case WorkOrderStatus.Rejected:
                                                        <span class="badge bg-danger">
                                                            Reddedildi
                                                        </span>
                                                        break;

                                                    case WorkOrderStatus.Cancelled:
                                                        <span class="badge bg-secondary">
                                                            İptal Edildi
                                                        </span>
                                                        break;
                                                }
                                            </td>

                                            <td class="num">
                                                @item.TotalAmount.ToString("N2") ₺
                                            </td>

                                            <td class="num">

                                                <a asp-controller="WorkOrder"
                                                   asp-action="Details"
                                                   asp-route-id="@item.WorkOrderId"
                                                   class="m-btn m-btn--ghost"
                                                   title="İş emrini görüntüle">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6"
                                            class="text-center">
                                            Henüz iş emri bulunmuyor.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </section>

            </div>


            <div class="col-xl-5">

                <section class="m-card">

                    <header class="m-card__header">

                        <div>
                            <h2 class="m-card__title">
                                Son Tahsilatlar
                            </h2>

                            <p class="m-card__subtitle">
                                Sisteme girilen son 5 ödeme.
                            </p>
                        </div>

                        <a asp-controller="Payment"
                           asp-action="Index"
                           class="m-btn m-btn--ghost">
                            Tümünü Gör
                        </a>

                    </header>


                    <div class="table-responsive">

                        <table class="m-table">

                            <thead>
                                <tr>
                                    <th>Müşteri</th>
                                    <th>İş Emri</th>
                                    <th>Tarih</th>
                                    <th class="num">Tutar</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (Model.RecentPayments.Any())
                                {
                                    foreach (var item in Model.RecentPayments)
                                    {
                                        <tr>

                                            <td>
                                                @item.CustomerName
                                            </td>

                                            <td>
                                                <a asp-controller="WorkOrder"
                                                   asp-action="Details"
                                                   asp-route-id="@item.WorkOrderId">
                                                    @item.WorkOrderNumber
                                                </a>
                                            </td>

                                            <td>
                                                @item.PaymentDate.ToString("dd.MM.yyyy")
                                            </td>

                                            <td class="num">
                                                <strong>
                                                    @item.Amount.ToString("N2") ₺
                                                </strong>
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4"
                                            class="text-center">
                                            Henüz tahsilat bulunmuyor.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </section>

            </div>

        </div>


        @* Son kullanıcılar ve son personeller *@
        <div class="row row-tight mt-3">

            <div class="col-xl-6">

                <section class="m-card">

                    <header class="m-card__header">

                        <div>
                            <h2 class="m-card__title">
                                Kullanıcılar
                            </h2>

                            <p class="m-card__subtitle">
                                Sistemdeki son 5 kullanıcı hesabı.
                            </p>
                        </div>

                        <a asp-controller="User"
                           asp-action="Index"
                           class="m-btn m-btn--ghost">
                            Tümünü Gör
                        </a>

                    </header>


                    <div class="table-responsive">

                        <table class="m-table">

                            <thead>
                                <tr>
                                    <th>Personel</th>
                                    <th>Kullanıcı Adı</th>
                                    <th>Rol</th>
                                    <th>Son Giriş</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (Model.RecentUsers.Any())
                                {
                                    foreach (var item in Model.RecentUsers)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @item.EmployeeFullName
                                                </strong>
                                            </td>

                                            <td>
                                                @item.Username
                                            </td>

                                            <td>
                                                @switch (item.Role)
                                                {
                                                    case UserRole.Admin:
                                                        <span class="badge bg-danger">
                                                            Admin
                                                        </span>
                                                        break;

                                                    case UserRole.Manager:
                                                        <span class="badge bg-primary">
                                                            Yönetici
                                                        </span>
                                                        break;

                                                    case UserRole.Sales:
                                                        <span class="badge bg-info">
                                                            Satış
                                                        </span>
                                                        break;

                                                    case UserRole.Accountant:
                                                        <span class="badge bg-warning">
                                                            Muhasebe
                                                        </span>
                                                        break;

                                                    case UserRole.Workshop:
                                                        <span class="badge bg-secondary">
                                                            Atölye
                                                        </span>
                                                        break;
                                                }
                                            </td>

                                            <td>
                                                @if (item.LastLoginDate.HasValue)
                                                {
                                                    @item.LastLoginDate.Value.ToString("dd.MM.yyyy HH:mm")
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </td>

                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">
                                                        Aktif
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        Pasif
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5"
                                            class="text-center">
                                            Kullanıcı hesabı bulunmuyor.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </section>

            </div>


            <div class="col-xl-6">

                <section class="m-card">

                    <header class="m-card__header">

                        <div>
                            <h2 class="m-card__title">
                                Personeller
                            </h2>

                            <p class="m-card__subtitle">
                                Sisteme eklenen son 5 personel.
                            </p>
                        </div>

                        <a asp-controller="Employee"
                           asp-action="Index"
                           class="m-btn m-btn--ghost">
                            Tümünü Gör
                        </a>

                    </header>


                    <div class="table-responsive">

                        <table class="m-table">

                            <thead>
                                <tr>
                                    <th>Personel</th>
                                    <th>Pozisyon</th>
                                    <th>İşe Giriş</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (Model.RecentEmployees.Any())
                                {
                                    foreach (var item in Model.RecentEmployees)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @item.FullName
                                                </strong>
                                            </td>

                                            <td>
                                                @item.Position
                                            </td>

                                            <td>
                                                @item.HireDate.ToString("dd.MM.yyyy")
                                            </td>

                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">
                                                        Aktif
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        Pasif
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4"
                                            class="text-center">
                                            Personel bulunmuyor.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </section>

            </div>

        </div>

    </div>
</div>


@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Dashboard üzerindeki tarih ve saati günceller
            function updateDashboardDateTime() {

                const now = new Date();

                const dateElement =
                    document.getElementById("dashboardDate");

                const clockElement =
                    document.getElementById("dashboardClock");

                if (dateElement) {

                    dateElement.textContent =
                        now.toLocaleDateString("tr-TR", {
                            day: "2-digit",
                            month: "long",
                            year: "numeric",
                            weekday: "long"
                        });
                }

                if (clockElement) {

                    clockElement.textContent =
                        now.toLocaleTimeString("tr-TR", {
                            hour: "2-digit",
                            minute: "2-digit",
                            second: "2-digit"
                        });
                }
            }

            // Sayfa açıldığında tarih ve saati hemen gösterir
            updateDashboardDateTime();

            // Saati her saniye günceller
            setInterval(
                updateDashboardDateTime,
                1000);
        });
    </script>
}