@using StoneTech.Models.Stone
@model IEnumerable<StoneListViewModel>

@{
    ViewData["Title"] = "Taşlar";

    string search = ViewBag.Search ?? "";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalCount = ViewBag.TotalCount ?? 0;

    int firstItem = totalCount == 0
        ? 0
        : ((page - 1) * pageSize) + 1;

    int lastItem = Math.Min(page * pageSize, totalCount);
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>
                <h1>Taşlar</h1>

                <p class="subtitle">
                    Kayıtlı taşları, fiyatlarını, stoklarını ve web sitesi görünürlüğünü görüntüleyin.
                </p>
            </div>

            <div class="page-header__actions">

                @if (User.IsInRole("Admin") ||
                     User.IsInRole("Manager") ||
                     User.IsInRole("Sales"))
                {
                    <a asp-controller="Stone"
                       asp-action="Create"
                       class="m-btn m-btn--primary">

                        <i class="fa-solid fa-plus"></i>
                        Taş Ekle

                    </a>
                }

            </div>

        </div>

        <!-- Taş listesi -->
        <section class="m-card" style="padding: 20px;">

            <!-- Arama ve sayfa boyutu -->
            <form asp-controller="Stone"
                  asp-action="Index"
                  method="get">

                <div class="dt-toolbar">

                    <!-- Arama -->
                    <div class="dt-search">

                        <i class="fa-solid fa-magnifying-glass"
                           aria-hidden="true"></i>

                        <input type="search"
                               name="search"
                               value="@search"
                               placeholder="Taş adı veya renk ara..."
                               aria-label="Taş ara">

                    </div>

                    <!-- Sayfa başına kayıt -->
                    <div style="display: flex; gap: 8px; align-items: center;">

                        <label style="font-size: 12.5px;
                            color: var(--m-text-muted);
                            display: inline-flex;
                            align-items: center;
                            gap: 8px;">

                            Göster

                            <select name="pageSize"
                                    class="form-select"
                                    style="width: 80px;
                                height: 32px;
                                padding: 0 24px 0 10px;
                                font-size: 12.5px;"
                                    onchange="this.form.submit()">

                                <option value="5" selected="@(pageSize == 5)">5</option>
                                <option value="10" selected="@(pageSize == 10)">10</option>
                                <option value="20" selected="@(pageSize == 20)">20</option>
                                <option value="50" selected="@(pageSize == 50)">50</option>

                            </select>

                            kayıt

                        </label>

                    </div>

                </div>

            </form>

            <!-- Tablo -->
            <div class="table-responsive">

                <table class="m-table dt-table" id="dt-table">

                    <thead>
                        <tr>
                            <th>Görsel</th>
                            <th>Taş Adı</th>
                            <th>Renk</th>
                            <th>Alış Fiyatı</th>
                            <th>Satış Fiyatı</th>
                            <th>Stok</th>
                            <th>Durum</th>
                            <th>Web Sitesi</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9">

                                    <div class="empty-state">

                                        <span class="empty-state__icon">
                                            <i class="fa-solid fa-gem"></i>
                                        </span>

                                        <h3 class="empty-state__title">
                                            Taş bulunamadı
                                        </h3>

                                        <p class="empty-state__text">

                                            @if (!string.IsNullOrWhiteSpace(search))
                                            {
                                                @:Aramanızla eşleşen taş bulunamadı.
                                            }
                                            else
                                            {
                                                @:Henüz sisteme taş eklenmemiş.
                                            }

                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(search))
                                        {
                                            <div class="empty-state__actions">

                                                <a asp-controller="Stone"
                                                   asp-action="Index"
                                                   class="m-btn m-btn--ghost">

                                                    Aramayı temizle

                                                </a>

                                            </div>
                                        }

                                    </div>

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var stone in Model)
                            {
                                <tr>

                                    <!-- Görsel -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(stone.ImageUrl))
                                        {
                                            <img src="@stone.ImageUrl"
                                                 alt="@stone.StoneName"
                                                 style="width: 64px;
                                            height: 64px;
                                            object-fit: cover;
                                            border-radius: 8px;
                                            display: block;" />
                                        }
                                        else
                                        {
                                            <div style="width: 64px;
                                                height: 64px;
                                                border-radius: 8px;
                                                display: flex;
                                                align-items: center;
                                                justify-content: center;
                                                background: var(--m-bg-soft, #f3f4f6);
                                                color: var(--m-text-muted);">

                                                <i class="fa-regular fa-image"></i>

                                            </div>
                                        }

                                    </td>

                                    <!-- Taş adı -->
                                    <td>

                                        <span class="name">
                                            @stone.StoneName
                                        </span>

                                    </td>

                                    <!-- Renk -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(stone.Color))
                                        {
                                            @stone.Color
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }

                                    </td>

                                    <!-- Alış fiyatı -->
                                    <td>
                                        @stone.PurchasePrice.ToString("N2") ₺
                                    </td>

                                    <!-- Satış fiyatı -->
                                    <td>
                                        @stone.SalePrice.ToString("N2") ₺
                                    </td>

                                    <!-- Stok -->
                                    <td>

                                        <strong>
                                            @stone.StockQuantity
                                        </strong>

                                        <span class="text-muted">
                                            plaka
                                        </span>

                                    </td>

                                    <!-- Sistem durumu -->
                                    <td>

                                        @if (stone.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Pasif
                                            </span>
                                        }

                                    </td>

                                    <!-- Web sitesi görünürlüğü -->
                                    <td>

                                        @if (stone.ShowOnWeb)
                                        {
                                            <span class="badge bg-success">
                                                Yayında
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Yayında Değil
                                            </span>
                                        }

                                    </td>

                                    <!-- İşlemler -->
                                    <td>

                                        <div class="table-data-feature">

                                            @if (User.IsInRole("Admin") ||
                                                 User.IsInRole("Manager"))
                                            {
                                                <!-- Düzenle -->
                                                <a asp-controller="Stone"
                                                   asp-action="Edit"
                                                   asp-route-id="@stone.StoneId"
                                                   class="item"
                                                   data-bs-toggle="tooltip"
                                                   title="Düzenle">

                                                    <i class="fa-solid fa-pen-to-square"></i>

                                                </a>

                                                @if (stone.IsActive)
                                                {
                                                    <!-- Pasif yap -->
                                                    <form asp-controller="Stone"
                                                          asp-action="Deactivate"
                                                          asp-route-id="@stone.StoneId"
                                                          method="post"
                                                          style="display: contents;">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="item"
                                                                title="Pasif Yap"
                                                                onclick="return confirm('Bu taşı pasif hale getirmek istediğinize emin misiniz?');">

                                                            <i class="fa-solid fa-ban"></i>

                                                        </button>

                                                    </form>
                                                }
                                                else
                                                {
                                                    <!-- Aktif yap -->
                                                    <form asp-controller="Stone"
                                                          asp-action="Activate"
                                                          asp-route-id="@stone.StoneId"
                                                          method="post"
                                                          style="display: contents;">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="item"
                                                                title="Aktif Yap"
                                                                onclick="return confirm('Bu taşı tekrar aktif hale getirmek istediğinize emin misiniz?');">

                                                            <i class="fa-solid fa-circle-check"></i>

                                                        </button>

                                                    </form>
                                                }
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <!-- Sayfalama -->
            <div class="dt-pagination">

                <!-- Kayıt bilgisi -->
                <span class="dt-pagination__info">

                    @if (totalCount == 0)
                    {
                        @:Sonuç yok
                    }
                    else
                    {
                        @:@firstItem–@lastItem / @totalCount kayıt
                    }

                </span>

                <!-- Sayfa navigasyonu -->
                <div class="dt-pagination__nav">

                    <!-- Önceki -->
                    @if (page > 1)
                    {
                        <a asp-controller="Stone"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page - 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-left"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button" disabled>
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                    }

                    <!-- Sayfa numaraları -->
                    @if (totalPages > 0)
                    {
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            @if (i == page)
                            {
                                <button type="button"
                                        class="is-active"
                                        disabled>
                                    @i
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Stone"
                                   asp-action="Index"
                                   asp-route-search="@search"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@pageSize">

                                    @i

                                </a>
                            }
                        }
                    }

                    <!-- Sonraki -->
                    @if (totalPages > 0 && page < totalPages)
                    {
                        <a asp-controller="Stone"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page + 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button" disabled>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    }

                </div>

            </div>

        </section>

    </div>
</div>
