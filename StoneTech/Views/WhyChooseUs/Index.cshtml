@model IEnumerable<StoneTech.Entities.WhyChooseUs>

@{
    ViewData["Title"] = "Neden Biz Yönetimi";

    string search = ViewBag.Search ?? "";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalCount = ViewBag.TotalCount ?? 0;

    bool canCreate = ViewBag.CanCreate ?? false;

    int firstItem = totalCount == 0
        ? 0
        : ((page - 1) * pageSize) + 1;

    int lastItem = Math.Min(
        page * pageSize,
        totalCount
    );
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>
                <h1>Neden Biz Yönetimi</h1>

                <p class="subtitle">
                    Web sitesinde gösterilecek Neden Biz özelliklerini yönetin.
                    En fazla 6 özellik ekleyebilirsiniz.
                </p>
            </div>

            <div class="page-header__actions">

                @if (canCreate &&
                     (User.IsInRole("Admin") || User.IsInRole("Manager")))
                {
                    <a asp-controller="WhyChooseUs"
                       asp-action="Create"
                       class="m-btn m-btn--primary">

                        <i class="fa-solid fa-plus"></i>
                        Özellik Ekle

                    </a>
                }

            </div>

        </div>

        <!-- Data Table -->
        <section class="m-card" style="padding: 20px;">

            <!-- Toolbar -->
            <form asp-controller="WhyChooseUs"
                  asp-action="Index"
                  method="get">

                <div class="dt-toolbar">

                    <!-- Arama -->
                    <div class="dt-search">

                        <i class="fa-solid fa-magnifying-glass"
                           aria-hidden="true"></i>

                        <input type="search"
                               name="search"
                               value="@search"
                               placeholder="Özellik başlığı veya açıklama ara..."
                               aria-label="Özellik ara" />

                    </div>

                    <!-- Sayfa başına kayıt -->
                    <div style="display: flex;
                        gap: 8px;
                        align-items: center;">

                        <label style="font-size: 12.5px;
                            color: var(--m-text-muted);
                            display: inline-flex;
                            align-items: center;
                            gap: 8px;">

                            Göster

                            <select name="pageSize"
                                    class="form-select"
                                    style="width: 80px;
                                height: 32px;
                                padding: 0 24px 0 10px;
                                font-size: 12.5px;"
                                    onchange="this.form.submit()">

                                <option value="5"
                                        selected="@(pageSize == 5)">
                                    5
                                </option>

                                <option value="10"
                                        selected="@(pageSize == 10)">
                                    10
                                </option>

                                <option value="20"
                                        selected="@(pageSize == 20)">
                                    20
                                </option>

                                <option value="50"
                                        selected="@(pageSize == 50)">
                                    50
                                </option>

                            </select>

                            kayıt

                        </label>

                    </div>

                </div>

            </form>

            <!-- Tablo -->
            <div class="table-responsive">

                <table class="m-table dt-table"
                       id="dt-table">

                    <thead>
                        <tr>
                            <th>İkon</th>
                            <th>Başlık</th>
                            <th>Açıklama</th>
                            <th>Sıralama</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6">

                                    <div class="empty-state">

                                        <span class="empty-state__icon">
                                            <i class="fa-solid fa-award"></i>
                                        </span>

                                        <h3 class="empty-state__title">
                                            Özellik bulunamadı
                                        </h3>

                                        <p class="empty-state__text">

                                            @if (!string.IsNullOrWhiteSpace(search))
                                            {
                                                @:Aramanızla eşleşen özellik bulunamadı.
                                            }
                                            else
                                            {
                                                @:Henüz sisteme Neden Biz özelliği eklenmemiş.
                                            }

                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(search))
                                        {
                                            <div class="empty-state__actions">

                                                <a asp-controller="WhyChooseUs"
                                                   asp-action="Index"
                                                   class="m-btn m-btn--ghost">

                                                    Aramayı temizle

                                                </a>

                                            </div>
                                        }
                                        else if (canCreate &&
                                                 (User.IsInRole("Admin") ||
                                                  User.IsInRole("Manager")))
                                        {
                                            <div class="empty-state__actions">

                                                <a asp-controller="WhyChooseUs"
                                                   asp-action="Create"
                                                   class="m-btn m-btn--primary">

                                                    <i class="fa-solid fa-plus"></i>
                                                    Özellik Ekle

                                                </a>

                                            </div>
                                        }

                                    </div>

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- İkon -->
                                    <td>

                                        <div style="width: 56px;
                                            height: 56px;
                                            border-radius: 10px;
                                            display: flex;
                                            align-items: center;
                                            justify-content: center;
                                            background: var(--m-bg-soft, #f3f4f6);
                                            color: var(--m-text-muted);">

                                            @if (!string.IsNullOrWhiteSpace(item.IconClass))
                                            {
                                                <i class="@item.IconClass"
                                                   style="font-size: 24px;"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-regular fa-star"
                                                   style="font-size: 24px;"></i>
                                            }

                                        </div>

                                    </td>

                                    <!-- Başlık -->
                                    <td>

                                        <span class="name">
                                            @item.Title
                                        </span>

                                    </td>

                                    <!-- Açıklama -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <span title="@item.Description">

                                                @(item.Description.Length > 80
                                                    ? item.Description[..80] + "..."
                                                    : item.Description)

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                    <!-- Sıralama -->
                                    <td>

                                        <strong>
                                            @item.DisplayOrder
                                        </strong>

                                    </td>

                                    <!-- Durum -->
                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Pasif
                                            </span>
                                        }

                                    </td>

                                    <!-- İşlemler -->
                                    <td>

                                        <div class="table-data-feature">

                                            <!-- Detay -->
                                            <a asp-controller="WhyChooseUs"
                                               asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="item"
                                               data-bs-toggle="tooltip"
                                               title="Detay">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                            @if (User.IsInRole("Admin") ||
                                                 User.IsInRole("Manager"))
                                            {
                                                <!-- Düzenle -->
                                                <a asp-controller="WhyChooseUs"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="item"
                                                   data-bs-toggle="tooltip"
                                                   title="Düzenle">

                                                    <i class="fa-solid fa-pen-to-square"></i>

                                                </a>

                                                <!-- Sil -->
                                                <form asp-controller="WhyChooseUs"
                                                      asp-action="Delete"
                                                      asp-route-id="@item.Id"
                                                      method="post"
                                                      style="display: inline;"
                                                      onsubmit="return confirm('Bu özelliği silmek istediğinize emin misiniz?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="item"
                                                            data-bs-toggle="tooltip"
                                                            title="Sil">

                                                        <i class="fa-solid fa-trash"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <!-- Pagination -->
            <div class="dt-pagination">

                <!-- Kayıt bilgisi -->
                <span class="dt-pagination__info">

                    @if (totalCount == 0)
                    {
                        @:Sonuç yok
                    }
                    else
                    {
                        @:@firstItem–@lastItem / @totalCount kayıt
                    }

                </span>

                <!-- Sayfa navigasyonu -->
                <div class="dt-pagination__nav">

                    <!-- Önceki -->
                    @if (page > 1)
                    {
                        <a asp-controller="WhyChooseUs"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page - 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-left"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                disabled>

                            <i class="fa-solid fa-chevron-left"></i>

                        </button>
                    }

                    <!-- Sayfa numaraları -->
                    @if (totalPages > 0)
                    {
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            @if (i == page)
                            {
                                <button type="button"
                                        class="is-active"
                                        disabled>

                                    @i

                                </button>
                            }
                            else
                            {
                                <a asp-controller="WhyChooseUs"
                                   asp-action="Index"
                                   asp-route-search="@search"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@pageSize">

                                    @i

                                </a>
                            }
                        }
                    }

                    <!-- Sonraki -->
                    @if (totalPages > 0 && page < totalPages)
                    {
                        <a asp-controller="WhyChooseUs"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page + 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                disabled>

                            <i class="fa-solid fa-chevron-right"></i>

                        </button>
                    }

                </div>

            </div>

        </section>

    </div>
</div>
