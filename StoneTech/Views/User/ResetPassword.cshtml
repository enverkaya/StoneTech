@using StoneTech.Models.User
@model UserResetPasswordViewModel

@{
    ViewData["Title"] = "Şifreyi Sıfırla";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>
                <h1>Şifreyi Sıfırla</h1>

                <p class="subtitle">
                    Kullanıcı hesabı için yeni bir giriş şifresi belirleyin.
                </p>
            </div>

            <div class="page-header__actions">

                <a asp-controller="User"
                   asp-action="Details"
                   asp-route-id="@Model.UserId"
                   class="m-btn m-btn--ghost">

                    <i class="fa-solid fa-arrow-left"></i>
                    Kullanıcı Detayına Dön

                </a>

            </div>

        </div>

        <div class="row justify-content-center">

            <div class="col-lg-7">

                <!-- Kullanıcı bilgileri -->
                <section class="m-card"
                         style="padding: 20px; margin-bottom: 20px;">

                    <div style="margin-bottom: 20px;">

                        <h4 style="margin-bottom: 5px;">
                            Kullanıcı Bilgileri
                        </h4>

                        <p class="text-muted"
                           style="margin: 0;">
                            Şifresini sıfırladığınız kullanıcıyı kontrol edin.
                        </p>

                    </div>

                    <div class="row">

                        <!-- Personel -->
                        <div class="col-md-6"
                             style="margin-bottom: 15px;">

                            <small class="text-muted">
                                Personel
                            </small>

                            <div style="margin-top: 5px;">
                                <strong>@Model.FullName</strong>
                            </div>

                        </div>

                        <!-- Kullanıcı adı -->
                        <div class="col-md-6"
                             style="margin-bottom: 15px;">

                            <small class="text-muted">
                                Kullanıcı Adı
                            </small>

                            <div style="margin-top: 5px;">
                                <strong>@Model.Username</strong>
                            </div>

                        </div>

                    </div>

                </section>

                <!-- Şifre sıfırlama formu -->
                <form asp-controller="User"
                      asp-action="ResetPassword"
                      asp-route-id="@Model.UserId"
                      method="post">

                    @Html.AntiForgeryToken()

                    <!-- Kullanıcı Id bilgisi yalnızca işlem için tutulur -->
                    <input asp-for="UserId"
                           type="hidden">

                    <!-- Genel validasyon hataları -->
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger"
                         style="margin-bottom: 15px;">
                    </div>

                    <section class="m-card"
                             style="padding: 20px; margin-bottom: 20px;">

                        <div style="margin-bottom: 20px;">

                            <h4 style="margin-bottom: 5px;">
                                Yeni Şifre
                            </h4>

                            <p class="text-muted"
                               style="margin: 0;">
                                Kullanıcının bundan sonra sisteme giriş yapacağı yeni şifreyi belirleyin.
                            </p>

                        </div>

                        <!-- Yeni şifre -->
                        <div class="form-group"
                             style="margin-bottom: 20px;">

                            <label asp-for="NewPassword"
                                   class="control-label">
                                Yeni Şifre
                            </label>

                            <div style="position: relative;">

                                <input asp-for="NewPassword"
                                       id="NewPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="En az 8 karakter">

                                <button type="button"
                                        id="toggleNewPassword"
                                        tabindex="-1"
                                        aria-label="Şifreyi göster veya gizle"
                                        style="position: absolute;
                                               right: 10px;
                                               top: 50%;
                                               transform: translateY(-50%);
                                               border: 0;
                                               background: transparent;
                                               color: #8b95a1;
                                               cursor: pointer;">

                                    <i class="fa-solid fa-eye"></i>

                                </button>

                            </div>

                            <span asp-validation-for="NewPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Yeni şifre tekrar -->
                        <div class="form-group">

                            <label asp-for="ConfirmPassword"
                                   class="control-label">
                                Yeni Şifre Tekrar
                            </label>

                            <div style="position: relative;">

                                <input asp-for="ConfirmPassword"
                                       id="ConfirmPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Yeni şifreyi tekrar girin">

                                <button type="button"
                                        id="toggleConfirmPassword"
                                        tabindex="-1"
                                        aria-label="Şifreyi göster veya gizle"
                                        style="position: absolute;
                                               right: 10px;
                                               top: 50%;
                                               transform: translateY(-50%);
                                               border: 0;
                                               background: transparent;
                                               color: #8b95a1;
                                               cursor: pointer;">

                                    <i class="fa-solid fa-eye"></i>

                                </button>

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>

                    </section>

                    <!-- İşlem butonları -->
                    <section class="m-card"
                             style="padding: 20px;">

                        <div style="display: flex;
                                    justify-content: flex-end;
                                    align-items: center;
                                    gap: 10px;">

                            <a asp-controller="User"
                               asp-action="Details"
                               asp-route-id="@Model.UserId"
                               class="m-btn m-btn--ghost">

                                Vazgeç

                            </a>

                            <button type="submit"
                                    class="m-btn m-btn--primary">

                                <i class="fa-solid fa-key"></i>
                                Şifreyi Sıfırla

                            </button>

                        </div>

                    </section>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Yeni şifre alanını gösterir veya gizler
            const newPasswordInput =
                document.getElementById("NewPassword");

            const toggleNewPassword =
                document.getElementById("toggleNewPassword");

            if (newPasswordInput && toggleNewPassword) {

                toggleNewPassword.addEventListener("click", function () {

                    const isPassword =
                        newPasswordInput.type === "password";

                    newPasswordInput.type =
                        isPassword ? "text" : "password";

                    const icon =
                        toggleNewPassword.querySelector("i");

                    if (icon) {
                        icon.className = isPassword
                            ? "fa-solid fa-eye-slash"
                            : "fa-solid fa-eye";
                    }
                });
            }

            // Şifre tekrar alanını gösterir veya gizler
            const confirmPasswordInput =
                document.getElementById("ConfirmPassword");

            const toggleConfirmPassword =
                document.getElementById("toggleConfirmPassword");

            if (confirmPasswordInput && toggleConfirmPassword) {

                toggleConfirmPassword.addEventListener("click", function () {

                    const isPassword =
                        confirmPasswordInput.type === "password";

                    confirmPasswordInput.type =
                        isPassword ? "text" : "password";

                    const icon =
                        toggleConfirmPassword.querySelector("i");

                    if (icon) {
                        icon.className = isPassword
                            ? "fa-solid fa-eye-slash"
                            : "fa-solid fa-eye";
                    }
                });
            }
        });
    </script>
}