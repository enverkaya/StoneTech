@using StoneTech.Models.User
@model UserResetPasswordViewModel

@{
    ViewData["Title"] = "Şifreyi Sıfırla";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>
                <h1>Şifreyi Sıfırla</h1>

                <p class="subtitle">
                    Kullanıcı hesabı için yeni bir giriş şifresi belirleyin.
                </p>
            </div>

            <div class="page-header__actions">

                <a asp-controller="User"
                   asp-action="Details"
                   asp-route-id="@Model.UserId"
                   class="m-btn m-btn--ghost">

                    <i class="fa-solid fa-arrow-left"></i>
                    Kullanıcı Detayına Dön

                </a>

            </div>

        </div>

        <div class="row justify-content-center">

            <div class="col-lg-7">

                <!-- Kullanıcı bilgileri -->
                <section class="m-card"
                         style="padding: 20px; margin-bottom: 20px;">

                    <div style="margin-bottom: 20px;">

                        <h4 style="margin-bottom: 5px;">
                            Kullanıcı Bilgileri
                        </h4>

                        <p class="text-muted"
                           style="margin: 0;">
                            Şifresini sıfırladığınız kullanıcıyı kontrol edin.
                        </p>

                    </div>

                    <div class="row">

                        <!-- Personel -->
                        <div class="col-md-6"
                             style="margin-bottom: 15px;">

                            <small class="text-muted">
                                Personel
                            </small>

                            <div style="margin-top: 5px;">
                                <strong>@Model.FullName</strong>
                            </div>

                        </div>

                        <!-- Kullanıcı adı -->
                        <div class="col-md-6"
                             style="margin-bottom: 15px;">

                            <small class="text-muted">
                                Kullanıcı Adı
                            </small>

                            <div style="margin-top: 5px;">
                                <strong>@Model.Username</strong>
                            </div>

                        </div>

                    </div>

                </section>

                <!-- Şifre sıfırlama formu -->
                <form asp-controller="User"
                      asp-action="ResetPassword"
                      asp-route-id="@Model.UserId"
                      method="post">

                    @Html.AntiForgeryToken()

                    <!-- Kullanıcı Id bilgisi -->
                    <input asp-for="UserId"
                           type="hidden">

                    <!-- Genel validasyon hataları -->
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger"
                         style="margin-bottom: 15px;">
                    </div>

                    <!-- Admin kimlik doğrulaması -->
                    <section class="m-card"
                             style="padding: 20px; margin-bottom: 20px;">

                        <div style="margin-bottom: 20px;">

                            <h4 style="margin-bottom: 5px;">
                                Admin Kimlik Doğrulaması
                            </h4>

                            <p class="text-muted"
                               style="margin: 0;">
                                Güvenliğiniz için şifre sıfırlama işleminden önce
                                kendi Admin şifrenizi doğrulayın.
                            </p>

                        </div>

                        <!-- Admin mevcut şifresi -->
                        <div class="form-group">

                            <label asp-for="CurrentAdminPassword"
                                   class="control-label">
                                Mevcut Admin Şifreniz
                            </label>

                            <div style="position: relative;">

                                <input asp-for="CurrentAdminPassword"
                                       id="CurrentAdminPassword"
                                       type="password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       placeholder="Kendi Admin şifrenizi girin">

                                <button type="button"
                                        id="toggleCurrentAdminPassword"
                                        tabindex="-1"
                                        aria-label="Şifreyi göster veya gizle"
                                        style="position: absolute;
                                    right: 10px;
                                    top: 50%;
                                    transform: translateY(-50%);
                                    border: 0;
                                    background: transparent;
                                    color: #8b95a1;
                                    cursor: pointer;">

                                    <i class="fa-solid fa-eye"></i>

                                </button>

                            </div>

                            <span asp-validation-for="CurrentAdminPassword"
                                  class="text-danger">
                            </span>

                        </div>

                    </section>

                    <!-- Yeni şifre bilgileri -->
                    <section class="m-card"
                             style="padding: 20px; margin-bottom: 20px;">

                        <div style="margin-bottom: 20px;">

                            <h4 style="margin-bottom: 5px;">
                                Yeni Şifre
                            </h4>

                            <p class="text-muted"
                               style="margin: 0;">
                                Kullanıcının bundan sonra sisteme giriş yapacağı
                                yeni şifreyi belirleyin.
                            </p>

                        </div>

                        <!-- Yeni şifre -->
                        <div class="form-group"
                             style="margin-bottom: 20px;">

                            <label asp-for="NewPassword"
                                   class="control-label">
                                Yeni Şifre
                            </label>

                            <div style="position: relative;">

                                <input asp-for="NewPassword"
                                       id="NewPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="En az 8 karakter">

                                <button type="button"
                                        id="toggleNewPassword"
                                        tabindex="-1"
                                        aria-label="Şifreyi göster veya gizle"
                                        style="position: absolute;
                                    right: 10px;
                                    top: 50%;
                                    transform: translateY(-50%);
                                    border: 0;
                                    background: transparent;
                                    color: #8b95a1;
                                    cursor: pointer;">

                                    <i class="fa-solid fa-eye"></i>

                                </button>

                            </div>

                            <span asp-validation-for="NewPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Yeni şifre tekrar -->
                        <div class="form-group">

                            <label asp-for="ConfirmPassword"
                                   class="control-label">
                                Yeni Şifre Tekrar
                            </label>

                            <div style="position: relative;">

                                <input asp-for="ConfirmPassword"
                                       id="ConfirmPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Yeni şifreyi tekrar girin">

                                <button type="button"
                                        id="toggleConfirmPassword"
                                        tabindex="-1"
                                        aria-label="Şifreyi göster veya gizle"
                                        style="position: absolute;
                                    right: 10px;
                                    top: 50%;
                                    transform: translateY(-50%);
                                    border: 0;
                                    background: transparent;
                                    color: #8b95a1;
                                    cursor: pointer;">

                                    <i class="fa-solid fa-eye"></i>

                                </button>

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>

                    </section>

                    <!-- İşlem butonları -->
                    <section class="m-card"
                             style="padding: 20px;">

                        <div style="display: flex;
                            justify-content: flex-end;
                            align-items: center;
                            gap: 10px;">

                            <a asp-controller="User"
                               asp-action="Details"
                               asp-route-id="@Model.UserId"
                               class="m-btn m-btn--ghost">

                                Vazgeç

                            </a>

                            <button type="submit"
                                    class="m-btn m-btn--primary">

                                <i class="fa-solid fa-key"></i>
                                Şifreyi Sıfırla

                            </button>

                        </div>

                    </section>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // Şifre alanını gösterir veya gizler
            function setupPasswordToggle(inputId, buttonId) {

                const input = document.getElementById(inputId);
                const button = document.getElementById(buttonId);

                if (!input || !button) {
                    return;
                }

                button.addEventListener("click", function() {

                    const isPassword = input.type === "password";

                    input.type = isPassword ? "text" : "password";

                    const icon = button.querySelector("i");

                    if (icon) {
                        icon.className = isPassword
                            ? "fa-solid fa-eye-slash"
                            : "fa-solid fa-eye";
                    }
                });
            }

            // Admin şifresi gösterme ve gizleme
            setupPasswordToggle(
                "CurrentAdminPassword",
                "toggleCurrentAdminPassword");

            // Yeni şifre gösterme ve gizleme
            setupPasswordToggle(
                "NewPassword",
                "toggleNewPassword");

            // Yeni şifre tekrarı gösterme ve gizleme
            setupPasswordToggle(
                "ConfirmPassword",
                "toggleConfirmPassword");
        });
    </script>
}
