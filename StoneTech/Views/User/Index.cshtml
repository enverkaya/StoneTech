@using StoneTech.Models.User
@using StoneTech.Enums
@model IEnumerable<UserListViewModel>

@{
    ViewData["Title"] = "Kullanıcılar";

    string search = ViewBag.Search ?? "";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalCount = ViewBag.TotalCount ?? 0;

    int firstItem = totalCount == 0
        ? 0
        : ((page - 1) * pageSize) + 1;

    int lastItem = Math.Min(
        page * pageSize,
        totalCount
    );
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>

                <h1>Kullanıcılar</h1>

                <p class="subtitle">
                    Sistem kullanıcı hesaplarını ve yetkilerini yönetin.
                </p>

            </div>

            <div class="page-header__actions">

                <a asp-controller="User"
                   asp-action="Create"
                   class="m-btn m-btn--primary">

                    <i class="fa-solid fa-plus"></i>
                    Yeni Kullanıcı

                </a>

            </div>

        </div>

        <!-- Başarı mesajı -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Hata mesajı -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Kullanıcı listesi -->
        <section class="m-card" style="padding: 20px;">

            <!-- Arama ve sayfa başına kayıt -->
            <form asp-controller="User"
                  asp-action="Index"
                  method="get">

                <div class="dt-toolbar">

                    <!-- Kullanıcı arama -->
                    <div class="dt-search">

                        <i class="fa-solid fa-magnifying-glass"
                           aria-hidden="true"></i>

                        <input type="search"
                               name="search"
                               value="@search"
                               placeholder="Personel, kullanıcı adı, görev, telefon veya e-posta ara..."
                               aria-label="Kullanıcı ara">

                    </div>

                    <!-- Sayfa başına kayıt seçimi -->
                    <div style="display: flex;
                                gap: 8px;
                                align-items: center;">

                        <label style="font-size: 12.5px;
                                      color: var(--m-text-muted);
                                      display: inline-flex;
                                      align-items: center;
                                      gap: 8px;">

                            Göster

                            <select name="pageSize"
                                    class="form-select"
                                    style="width: 80px;
                                           height: 32px;
                                           padding: 0 24px 0 10px;
                                           font-size: 12.5px;"
                                    onchange="this.form.submit()">

                                <option value="5"
                                        selected="@(pageSize == 5)">
                                    5
                                </option>

                                <option value="10"
                                        selected="@(pageSize == 10)">
                                    10
                                </option>

                                <option value="20"
                                        selected="@(pageSize == 20)">
                                    20
                                </option>

                                <option value="50"
                                        selected="@(pageSize == 50)">
                                    50
                                </option>

                            </select>

                            kayıt

                        </label>

                    </div>

                </div>

            </form>

            <!-- Kullanıcı tablosu -->
            <div class="table-responsive">

                <table class="m-table dt-table">

                    <thead>

                        <tr>
                            <th>Personel</th>
                            <th>Kullanıcı Adı</th>
                            <th>Görev</th>
                            <th>Rol</th>
                            <th>Son Giriş</th>
                            <th>Personel Durumu</th>
                            <th>Hesap Durumu</th>
                            <th></th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="8">

                                    <div class="empty-state">

                                        <span class="empty-state__icon">

                                            <i class="fa-solid fa-users-gear"></i>

                                        </span>

                                        <h3 class="empty-state__title">
                                            Kullanıcı bulunamadı
                                        </h3>

                                        <p class="empty-state__text">

                                            @if (!string.IsNullOrWhiteSpace(search))
                                            {
                                                @:Aramanızla eşleşen kullanıcı bulunamadı.
                                            }
                                            else
                                            {
                                                @:Henüz sistem kullanıcı hesabı oluşturulmamış.
                                            }

                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(search))
                                        {
                                            <div class="empty-state__actions">

                                                <a asp-controller="User"
                                                   asp-action="Index"
                                                   class="m-btn m-btn--ghost">

                                                    Aramayı temizle

                                                </a>

                                            </div>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var user in Model)
                            {
                                <tr>

                                    <!-- Personel -->
                                    <td>

                                        <div style="display: flex;
                                                            align-items: center;
                                                            gap: 10px;">

                                            @if (!string.IsNullOrWhiteSpace(user.ImageUrl))
                                            {
                                                <img src="@user.ImageUrl"
                                                     alt="@user.FullName"
                                                     style="width: 38px;
                                                                        height: 38px;
                                                                        border-radius: 50%;
                                                                        object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div style="width: 38px;
                                                                        height: 38px;
                                                                        border-radius: 50%;
                                                                        background: #f1f3f5;
                                                                        display: flex;
                                                                        align-items: center;
                                                                        justify-content: center;
                                                                        color: #8b95a1;">

                                                    <i class="fa-solid fa-user"></i>

                                                </div>
                                            }

                                            <span class="name">
                                                @user.FullName
                                            </span>

                                        </div>

                                    </td>

                                    <!-- Kullanıcı adı -->
                                    <td>

                                        @user.Username

                                    </td>

                                    <!-- Görev -->
                                    <td>

                                        @user.Position

                                    </td>

                                    <!-- Sistem rolü -->
                                    <td>

                                        @switch (user.Role)
                                        {
                                            case UserRole.Admin:
                                                <span class="badge bg-danger">
                                                    Admin
                                                </span>
                                                break;

                                            case UserRole.Manager:
                                                <span class="badge bg-primary">
                                                    Yönetici
                                                </span>
                                                break;

                                            case UserRole.Sales:
                                                <span class="badge bg-info">
                                                    Satış
                                                </span>
                                                break;

                                            case UserRole.Accountant:
                                                <span class="badge bg-warning">
                                                    Muhasebe
                                                </span>
                                                break;

                                            case UserRole.Workshop:
                                                <span class="badge bg-secondary">
                                                    Atölye
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <!-- Son giriş -->
                                    <td>

                                        @if (user.LastLoginDate.HasValue)
                                        {
                                            <div>
                                                @user.LastLoginDate.Value.ToString("dd.MM.yyyy")
                                            </div>

                                            <small class="text-muted">
                                                @user.LastLoginDate.Value.ToString("HH:mm")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Henüz giriş yapmadı
                                            </span>
                                        }

                                    </td>

                                    <!-- Personel durumu -->
                                    <td>

                                        @if (user.IsEmployeeActive)
                                        {
                                            <span class="badge bg-success">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Pasif
                                            </span>
                                        }

                                    </td>

                                    <!-- Kullanıcı hesabı durumu -->
                                    <td>

                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Pasif
                                            </span>
                                        }

                                    </td>

                                    <!-- İşlemler -->
                                    <td>

                                        <div class="table-data-feature"
                                             style="justify-content: flex-start; gap: 6px;">

                                            <!-- Kullanıcı detayları -->
                                            <a asp-controller="User"
                                               asp-action="Details"
                                               asp-route-id="@user.UserId"
                                               class="item"
                                               data-bs-toggle="tooltip"
                                               title="Detay">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                            <!-- Kullanıcı düzenleme -->
                                            <a asp-controller="User"
                                               asp-action="Edit"
                                               asp-route-id="@user.UserId"
                                               class="item"
                                               data-bs-toggle="tooltip"
                                               title="Düzenle">

                                                <i class="fa-solid fa-pen-to-square"></i>

                                            </a>

                                            <!-- Kullanıcı hesabının aktiflik durumunu değiştirir -->
                                            <form asp-controller="User"
                                                  asp-action="ToggleStatus"
                                                  asp-route-id="@user.UserId"
                                                  method="post"
                                                  style="display: inline-flex; margin: 0;">

                                                @Html.AntiForgeryToken()

                                                @if (user.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="item"
                                                            data-bs-toggle="tooltip"
                                                            title="Pasife Al">

                                                        <i class="fa-solid fa-ban"></i>

                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="item"
                                                            data-bs-toggle="tooltip"
                                                            title="Aktifleştir">

                                                        <i class="fa-solid fa-check"></i>

                                                    </button>
                                                }

                                            </form>

                                            <!-- Kullanıcı hesabını ve bağlı personeli siler -->
                                            <form asp-controller="User"
                                                  asp-action="Delete"
                                                  asp-route-id="@user.UserId"
                                                  method="post"
                                                  style="display: inline-flex; margin: 0;"
                                                  onsubmit="return confirm('Bu kullanıcının sistem hesabı silinecek. Personel kaydı korunacaktır. Devam etmek istediğinize emin misiniz?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="item"
                                                        data-bs-toggle="tooltip"
                                                        title="Kullanıcıyı Sil">

                                                    <i class="fa-solid fa-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <!-- Sayfalama -->
            <div class="dt-pagination">

                <!-- Gösterilen kayıt bilgisi -->
                <span class="dt-pagination__info">

                    @if (totalCount == 0)
                    {
                        @:Sonuç yok
                    }
                    else
                    {
                        @:@firstItem–@lastItem / @totalCount kayıt
                    }

                </span>

                <!-- Sayfa navigasyonu -->
                <div class="dt-pagination__nav">

                    <!-- Önceki sayfa -->
                    @if (page > 1)
                    {
                        <a asp-controller="User"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page - 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-left"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                disabled>

                            <i class="fa-solid fa-chevron-left"></i>

                        </button>
                    }

                    <!-- Sayfa numaraları -->
                    @if (totalPages > 0)
                    {
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == page)
                            {
                                <button type="button"
                                        class="is-active"
                                        disabled>

                                    @i

                                </button>
                            }
                            else
                            {
                                <a asp-controller="User"
                                   asp-action="Index"
                                   asp-route-search="@search"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@pageSize">

                                    @i

                                </a>
                            }
                        }
                    }

                    <!-- Sonraki sayfa -->
                    @if (totalPages > 0 && page < totalPages)
                    {
                        <a asp-controller="User"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page + 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                disabled>

                            <i class="fa-solid fa-chevron-right"></i>

                        </button>
                    }

                </div>

            </div>

        </section>

    </div>
</div>
