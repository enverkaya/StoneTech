                    <div class="container-fluid">

                        <div class="header-wrap">

                            <!-- Sidebar Toggle -->
                            <button class="sidebar-toggle js-sidebar-toggle"
                                    type="button"
                                    aria-label="Menüyü aç/kapat"
                                    aria-expanded="false"
                                    aria-controls="main-sidebar">

                                <i class="fa-solid fa-bars"
                                   aria-hidden="true"></i>

                            </button>


                            <!-- HEADER RIGHT -->
                            <div class="header-button">

                               


                                <!-- ACCOUNT -->
                                <div class="account-wrap">

                                    <div class="account-item clearfix js-item-menu"
                                         role="button"
                                         tabindex="0"
                                         aria-haspopup="true"
                                         aria-label="Hesap menüsü">

                                        <!-- Kullanıcı adı -->
                                        <div class="content">

                                            <a class="js-acc-btn"
                                               href="#">
                                                @fullName
                                            </a>

                                        </div>


                                        <!-- Hesap menüsü -->
                                        <div class="account-dropdown js-dropdown">

                                            <!-- Kullanıcı bilgileri -->
                                            <div class="info clearfix">

                                                <div class="content">

                                                    <h5 class="name">
                                                        @fullName
                                                    </h5>

                                                    <span class="email">
                                                        @roleDisplayName
                                                    </span>

                                                </div>

                                            </div>


                                            <!-- Menü -->
                                            <div class="account-dropdown__body">

                                                <!-- Profil -->
                                                @if (int.TryParse(employeeId, out var profileEmployeeId))
                                                {
                                                    <div class="account-dropdown__item">

                                                        <a asp-controller="Employee"
                                                           asp-action="Details"
                                                           asp-route-id="@profileEmployeeId">

                                                            <i class="fa-solid fa-user"></i>
                                                            Profilim

                                                        </a>

                                                    </div>
                                                }


                                                <!-- Kullanıcı yönetimi -->
