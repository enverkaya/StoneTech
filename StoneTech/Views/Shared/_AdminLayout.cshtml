                                                {
                                                    <div class="account-dropdown__item">

                                                        <a asp-controller="User"
                                                           asp-action="Index">

                                                            <i class="fa-solid fa-user-shield"></i>
                                                            Kullanıcı Yönetimi

                                                        </a>

                                                    </div>
                                                }


                                                <!-- Çıkış -->
                                                <div class="account-dropdown__item">

                                                    <a href="#"
                                                       class="text-danger"
                                                       id="logoutButton">

                                                        <i class="fa-solid fa-power-off"></i>
                                                        Çıkış Yap

                                                    </a>

                                                </div>

                                            </div>


                                            <!-- Gizli çıkış formu -->
                                            <form id="logoutForm"
                                                  asp-controller="Account"
                                                  asp-action="Logout"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                            </form>

                                        </div>

                                    </div>

                                </div>

                            </div>
                            <!-- HEADER RIGHT SONU -->

                        </div>

