@using System.Security.Claims
@using StoneTech.Enums

@{
    // Giriş yapan kullanıcının kimlik ve rol bilgilerini hazırlar
    var fullName = User.Identity?.Name ?? "Kullanıcı";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
    var employeeId = User.FindFirst("EmployeeId")?.Value;
    var isAdmin = User.IsInRole(nameof(UserRole.Admin));
    var isManager = User.IsInRole(nameof(UserRole.Manager));
    var isSales = User.IsInRole(nameof(UserRole.Sales));
    var isAccountant = User.IsInRole(nameof(UserRole.Accountant));
    var isWorkshop = User.IsInRole(nameof(UserRole.Workshop));

    // Rol adını Türkçe olarak ekranda gösterir
    var roleDisplayName = role switch
    {
        nameof(UserRole.Admin) => "Admin",
        nameof(UserRole.Manager) => "Yönetici",
        nameof(UserRole.Sales) => "Satış",
        nameof(UserRole.Accountant) => "Muhasebe",
        nameof(UserRole.Workshop) => "Atölye",
        _ => role
    };
}

