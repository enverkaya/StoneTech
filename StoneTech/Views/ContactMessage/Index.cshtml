@using StoneTech.Models.ContactMessage
@model IEnumerable<ContactMessageIndexViewModel>

@{
    ViewData["Title"] = "Gelen Mesajlar";

    string search = ViewBag.Search ?? "";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalCount = ViewBag.TotalCount ?? 0;

    int firstItem = totalCount == 0
        ? 0
        : ((page - 1) * pageSize) + 1;

    int lastItem = Math.Min(
        page * pageSize,
        totalCount
    );
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>

                <h1>Gelen Mesajlar</h1>

                <p class="subtitle">
                    Web sitesinden gönderilen iletişim mesajlarını görüntüleyin ve müşterilere e-posta ile cevap verin.
                </p>

            </div>

        </div>

        <!-- Başarı mesajı -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        <!-- Hata mesajı -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <!-- Gelen mesajlar listesi -->
        <section class="m-card" style="padding: 20px;">

            <!-- Arama ve sayfa başına kayıt -->
            <form asp-controller="ContactMessage"
                  asp-action="Index"
                  method="get">

                <div class="dt-toolbar">

                    <!-- Mesaj arama -->
                    <div class="dt-search">

                        <i class="fa-solid fa-magnifying-glass"
                           aria-hidden="true"></i>

                        <input type="search"
                               name="search"
                               value="@search"
                               placeholder="Ad soyad, e-posta veya konu ara..."
                               aria-label="Mesaj ara">

                    </div>

                    <!-- Sayfa başına kayıt seçimi -->
                    <div style="display: flex;
                        gap: 8px;
                        align-items: center;">

                        <label style="font-size: 12.5px;
                            color: var(--m-text-muted);
                            display: inline-flex;
                            align-items: center;
                            gap: 8px;">

                            Göster

                            <select name="pageSize"
                                    class="form-select"
                                    style="width: 80px;
                                height: 32px;
                                padding: 0 24px 0 10px;
                                font-size: 12.5px;"
                                    onchange="this.form.submit()">

                                <option value="5"
                                        selected="@(pageSize == 5)">
                                    5
                                </option>

                                <option value="10"
                                        selected="@(pageSize == 10)">
                                    10
                                </option>

                                <option value="20"
                                        selected="@(pageSize == 20)">
                                    20
                                </option>

                                <option value="50"
                                        selected="@(pageSize == 50)">
                                    50
                                </option>

                            </select>

                            kayıt

                        </label>

                    </div>

                </div>

            </form>

            <!-- Mesaj tablosu -->
            <div class="table-responsive">

                <table class="m-table dt-table">

                    <thead>

                        <tr>
                            <th>Gönderen</th>
                            <th>E-posta</th>
                            <th>Konu</th>
                            <th>Gönderim Tarihi</th>
                            <th>Okunma Durumu</th>
                            <th>Cevap Durumu</th>
                            <th></th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="7">

                                    <div class="empty-state">

                                        <span class="empty-state__icon">

                                            <i class="fa-solid fa-envelope-open-text"></i>

                                        </span>

                                        <h3 class="empty-state__title">
                                            Mesaj bulunamadı
                                        </h3>

                                        <p class="empty-state__text">

                                            @if (!string.IsNullOrWhiteSpace(search))
                                            {
                                                @:Aramanızla eşleşen mesaj bulunamadı.
                                            }
                                            else
                                            {
                                                @:Henüz web sitesinden iletişim mesajı gönderilmemiş.
                                            }

                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(search))
                                        {
                                            <div class="empty-state__actions">

                                                <a asp-controller="ContactMessage"
                                                   asp-action="Index"
                                                   class="m-btn m-btn--ghost">

                                                    Aramayı temizle

                                                </a>

                                            </div>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var message in Model)
                            {
                                <tr>

                                    <!-- Gönderen kişi -->
                                    <td>

                                        <span class="name">
                                            @message.FullName
                                        </span>

                                    </td>

                                    <!-- E-posta adresi -->
                                    <td>

                                        @message.Email

                                    </td>

                                    <!-- Mesaj konusu -->
                                    <td>

                                        @message.Subject

                                    </td>

                                    <!-- Gönderim tarihi -->
                                    <td>

                                        @message.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")

                                    </td>

                                    <!-- Okunma durumu -->
                                    <td>

                                        @if (message.IsRead)
                                        {
                                            <span class="badge bg-success">
                                                Okundu
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Okunmadı
                                            </span>
                                        }

                                    </td>

                                    <!-- Cevap durumu -->
                                    <td>

                                        @if (message.IsReplied)
                                        {
                                            <span class="badge bg-success">
                                                Cevaplandı
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Cevap Bekliyor
                                            </span>
                                        }

                                    </td>

                                    <!-- İşlemler -->
                                    <td>

                                        <div class="table-data-feature"
                                             style="justify-content: flex-start; gap: 6px;">

                                            <!-- Mesaj detaylarını görüntüle -->
                                            <a asp-controller="ContactMessage"
                                               asp-action="Details"
                                               asp-route-id="@message.Id"
                                               class="item"
                                               data-bs-toggle="tooltip"
                                               title="Mesajı Görüntüle">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <!-- Sayfalama -->
            <div class="dt-pagination">

                <!-- Gösterilen kayıt bilgisi -->
                <span class="dt-pagination__info">

                    @if (totalCount == 0)
                    {
                        @:Sonuç yok
                    }
                    else
                    {
                        @:@firstItem–@lastItem / @totalCount kayıt
                    }

                </span>

                <!-- Sayfa navigasyonu -->
                <div class="dt-pagination__nav">

                    <!-- Önceki sayfa -->
                    @if (page > 1)
                    {
                        <a asp-controller="ContactMessage"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page - 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-left"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button" disabled>

                            <i class="fa-solid fa-chevron-left"></i>

                        </button>
                    }

                    <!-- Sayfa numaraları -->
                    @if (totalPages > 0)
                    {
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == page)
                            {
                                <button type="button"
                                        class="is-active"
                                        disabled>

                                    @i

                                </button>
                            }
                            else
                            {
                                <a asp-controller="ContactMessage"
                                   asp-action="Index"
                                   asp-route-search="@search"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@pageSize">

                                    @i

                                </a>
                            }
                        }
                    }

                    <!-- Sonraki sayfa -->
                    @if (totalPages > 0 && page < totalPages)
                    {
                        <a asp-controller="ContactMessage"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page + 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button" disabled>

                            <i class="fa-solid fa-chevron-right"></i>

                        </button>
                    }

                </div>

            </div>

        </section>

    </div>
</div>
