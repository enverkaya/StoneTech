@using StoneTech.Models.Customer
@using StoneTech.Enums
@model IEnumerable<CustomerDebtorViewModel>

@{
    ViewData["Title"] = "Borçlu Müşteriler";
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>
                <h1>Borçlu Müşteriler</h1>

                <p class="subtitle">
                    Açık bakiyesi bulunan müşterileri ve borçlu iş emirlerini takip edin.
                </p>
            </div>

        </div>

        <!-- Başarı mesajı -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Hata mesajı -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Borçlu müşteri listesi -->
        <section class="m-card" style="padding: 20px;">

            <div class="table-responsive">

                <table class="m-table dt-table">

                    <thead>
                        <tr>
                            <th>Müşteri</th>
                            <th>Telefon</th>
                            <th>Borçlu İş</th>
                            <th>Toplam Tutar</th>
                            <th>Toplam Ödenen</th>
                            <th>Kalan Borç</th>
                            <th style="text-align: right;">İşlem</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7">

                                    <div class="empty-state">

                                        <span class="empty-state__icon">
                                            <i class="fa-solid fa-circle-check"></i>
                                        </span>

                                        <h3 class="empty-state__title">
                                            Borçlu müşteri bulunmuyor
                                        </h3>

                                        <p class="empty-state__text">
                                            Sistemde açık bakiyesi bulunan müşteri bulunmamaktadır.
                                        </p>

                                    </div>

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var customer in Model)
                            {
                                <tr>

                                    <!-- Müşteri -->
                                    <td>
                                        <strong>
                                            @customer.CustomerName
                                        </strong>
                                    </td>

                                    <!-- Telefon -->
                                    <td>
                                        @customer.Phone
                                    </td>

                                    <!-- Borçlu iş emri sayısı -->
                                    <td>
                                        @customer.WorkOrders.Count
                                    </td>

                                    <!-- Toplam iş tutarı -->
                                    <td>
                                        <strong>
                                            @customer.TotalAmount.ToString("N2") ₺
                                        </strong>
                                    </td>

                                    <!-- Toplam ödenen -->
                                    <td>

                                        @if (customer.TotalPaid > 0)
                                        {
                                            <strong class="text-success">
                                                @customer.TotalPaid.ToString("N2") ₺
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                0,00 ₺
                                            </span>
                                        }

                                    </td>

                                    <!-- Kalan toplam borç -->
                                    <td>
                                        <strong class="text-danger">
                                            @customer.RemainingDebt.ToString("N2") ₺
                                        </strong>
                                    </td>

                                    <!-- İşlemler -->
                                    <td style="text-align: right;">

                                        <div class="table-data-feature"
                                             style="justify-content: flex-start; gap: 6px;">

                                            <!-- Borçlu iş emirlerini sayfa içinde açar -->
                                            <button type="button"
                                                    class="item"
                                                    title="Borçlu İşleri Göster"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#debtor-@customer.CustomerId"
                                                    aria-expanded="false"
                                                    aria-controls="debtor-@customer.CustomerId">

                                                <i class="fa-solid fa-eye"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>

                                <!-- Müşterinin borçlu iş emirleri -->
                                <tr class="collapse"
                                    id="debtor-@customer.CustomerId">

                                    <td colspan="7">

                                        <div class="table-responsive">

                                            <table class="m-table">

                                                <thead>
                                                    <tr>
                                                        <th>Tarih</th>
                                                        <th>İş Emri No</th>
                                                        <th>Durum</th>
                                                        <th>Toplam</th>
                                                        <th>Ödenen</th>
                                                        <th>Kalan</th>
                                                        <th style="text-align: right;">
                                                            İşlem
                                                        </th>
                                                    </tr>
                                                </thead>

                                                <tbody>

                                                    @foreach (var workOrder in customer.WorkOrders)
                                                    {
                                                        <tr>

                                                            <!-- İş emri tarihi -->
                                                            <td>
                                                                @workOrder.CreatedDate.ToString("dd.MM.yyyy")
                                                            </td>

                                                            <!-- İş emri numarası -->
                                                            <td>
                                                                <strong>
                                                                    @workOrder.WorkOrderNumber
                                                                </strong>
                                                            </td>

                                                            <!-- İş emri durumu -->
                                                            <td>

                                                                @switch (workOrder.Status)
                                                                {
                                                                    case WorkOrderStatus.PendingApproval:

                                                                        <span class="badge bg-warning text-dark">
                                                                            Onay Bekliyor
                                                                        </span>

                                                                        break;

                                                                    case WorkOrderStatus.Approved:

                                                                        <span class="badge bg-primary">
                                                                            Onaylandı
                                                                        </span>

                                                                        break;

                                                                    case WorkOrderStatus.InWorkshop:

                                                                        <span class="badge bg-info text-dark">
                                                                            Atölyede
                                                                        </span>

                                                                        break;

                                                                    case WorkOrderStatus.Completed:

                                                                        <span class="badge bg-success">
                                                                            Tamamlandı
                                                                        </span>

                                                                        break;

                                                                    default:

                                                                        <span class="badge bg-secondary">
                                                                            @workOrder.Status
                                                                        </span>

                                                                        break;
                                                                }

                                                            </td>

                                                            <!-- İş emri toplamı -->
                                                            <td>
                                                                <strong>
                                                                    @workOrder.TotalAmount.ToString("N2") ₺
                                                                </strong>
                                                            </td>

                                                            <!-- İş emrine yapılan ödeme -->
                                                            <td>

                                                                @if (workOrder.TotalPaid > 0)
                                                                {
                                                                    <strong class="text-success">
                                                                        @workOrder.TotalPaid.ToString("N2") ₺
                                                                    </strong>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">
                                                                        0,00 ₺
                                                                    </span>
                                                                }

                                                            </td>

                                                            <!-- İş emrinin kalan borcu -->
                                                            <td>
                                                                <strong class="text-danger">
                                                                    @workOrder.RemainingAmount.ToString("N2") ₺
                                                                </strong>
                                                            </td>

                                                            <!-- Ödeme işlemi -->
                                                            <td style="text-align: right;">

                                                                <div class="table-data-feature"
                                                                     style="justify-content: flex-start; gap: 6px;">

                                                                    <a asp-controller="Payment"
                                                                       asp-action="Create"
                                                                       asp-route-workOrderId="@workOrder.WorkOrderId"
                                                                       class="item"
                                                                       title="Ödeme Al">

                                                                        <i class="fa-solid fa-money-bill-wave"></i>

                                                                    </a>

                                                                </div>

                                                            </td>

                                                        </tr>
                                                    }

                                                </tbody>

                                            </table>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </section>

    </div>
</div>