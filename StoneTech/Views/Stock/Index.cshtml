@using StoneTech.Models.Stock
@model IEnumerable<StockListViewModel>

@{
    ViewData["Title"] = "Stok Yönetimi";

    string search = ViewBag.Search ?? "";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalCount = ViewBag.TotalCount ?? 0;

    int firstItem = totalCount == 0
        ? 0
        : ((page - 1) * pageSize) + 1;

    int lastItem = Math.Min(
        page * pageSize,
        totalCount
    );
}

<div class="section__content section__content--p30">
    <div class="container-fluid">

        <!-- Sayfa başlığı -->
        <div class="page-header">

            <div>

                <h1>Stok Yönetimi</h1>

                <p class="subtitle">
                    Taşların güncel plaka stoklarını ve stok değerlerini görüntüleyin.
                </p>

            </div>

        </div>

        <!-- Başarı mesajı -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Hata mesajı -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Stok tablosu -->
        <section class="m-card" style="padding: 20px;">

            <!-- Arama ve sayfa başına kayıt -->
            <form asp-controller="Stock"
                  asp-action="Index"
                  method="get">

                <div class="dt-toolbar">

                    <!-- Arama -->
                    <div class="dt-search">

                        <i class="fa-solid fa-magnifying-glass"
                           aria-hidden="true"></i>

                        <input type="search"
                               name="search"
                               value="@search"
                               placeholder="Taş adı veya renk ara..."
                               aria-label="Stok ara">

                    </div>

                    <!-- Sayfa başına kayıt -->
                    <div style="display: flex;
                                gap: 8px;
                                align-items: center;">

                        <label style="font-size: 12.5px;
                                      color: var(--m-text-muted);
                                      display: inline-flex;
                                      align-items: center;
                                      gap: 8px;">

                            Göster

                            <select name="pageSize"
                                    class="form-select"
                                    style="width: 80px;
                                           height: 32px;
                                           padding: 0 24px 0 10px;
                                           font-size: 12.5px;"
                                    onchange="this.form.submit()">

                                <option value="5"
                                        selected="@(pageSize == 5)">
                                    5
                                </option>

                                <option value="10"
                                        selected="@(pageSize == 10)">
                                    10
                                </option>

                                <option value="20"
                                        selected="@(pageSize == 20)">
                                    20
                                </option>

                                <option value="50"
                                        selected="@(pageSize == 50)">
                                    50
                                </option>

                            </select>

                            kayıt

                        </label>

                    </div>

                </div>

            </form>

            <!-- Tablo -->
            <div class="table-responsive">

                <table class="m-table dt-table"
                       id="dt-table">

                    <thead>

                        <tr>

                            <th>Görsel</th>
                            <th>Taş Adı</th>
                            <th>Renk</th>
                            <th>Mevcut Stok</th>
                            <th>Ort. Alış Maliyeti</th>
                            <th>Stok Değeri</th>
                            <th>Durum</th>
                            <th></th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="8">

                                    <div class="empty-state">

                                        <span class="empty-state__icon">

                                            <i class="fa-solid fa-boxes-stacked"></i>

                                        </span>

                                        <h3 class="empty-state__title">
                                            Stok kaydı bulunamadı
                                        </h3>

                                        <p class="empty-state__text">

                                            @if (!string.IsNullOrWhiteSpace(search))
                                            {
                                                @:Aramanızla eşleşen taş bulunamadı.
                                            }
                                            else
                                            {
                                                @:Henüz sistemde görüntülenecek taş bulunmuyor.
                                            }

                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(search))
                                        {
                                            <div class="empty-state__actions">

                                                <a asp-controller="Stock"
                                                   asp-action="Index"
                                                   class="m-btn m-btn--ghost">

                                                    Aramayı temizle

                                                </a>

                                            </div>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var stock in Model)
                            {
                                <tr>

                                    <!-- Görsel -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(stock.ImageUrl))
                                        {
                                            <img src="@stock.ImageUrl"
                                                 alt="@stock.StoneName"
                                                 style="width: 64px;
                                                                    height: 64px;
                                                                    object-fit: cover;
                                                                    border-radius: 8px;
                                                                    display: block;" />
                                        }
                                        else
                                        {
                                            <div style="width: 64px;
                                                                    height: 64px;
                                                                    border-radius: 8px;
                                                                    display: flex;
                                                                    align-items: center;
                                                                    justify-content: center;
                                                                    background: var(--m-bg-soft, #f3f4f6);
                                                                    color: var(--m-text-muted);">

                                                <i class="fa-regular fa-image"></i>

                                            </div>
                                        }

                                    </td>

                                    <!-- Taş adı -->
                                    <td>

                                        <span class="name">
                                            @stock.StoneName
                                        </span>

                                    </td>

                                    <!-- Renk -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(stock.Color))
                                        {
                                            @stock.Color
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                    <!-- Mevcut stok -->
                                    <td>

                                        @if (stock.CurrentStock > 0)
                                        {
                                            <strong>
                                                @stock.CurrentStock
                                            </strong>

                                            <span class="text-muted">
                                                plaka
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">
                                                0 plaka
                                            </span>
                                        }

                                    </td>

                                    <!-- Ortalama alış maliyeti -->
                                    <td>

                                        @stock.AveragePurchasePrice.ToString("N2") ₺

                                    </td>

                                    <!-- Toplam stok değeri -->
                                    <td>

                                        <strong>
                                            @stock.StockValue.ToString("N2") ₺
                                        </strong>

                                    </td>

                                    <!-- Durum -->
                                    <td>

                                        @if (stock.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Pasif
                                            </span>
                                        }

                                    </td>

                                    <!-- İşlemler -->
                                    <td>

                                        <div class="table-data-feature">

                                            <!-- Stok hareketlerini görüntüle -->
                                            <a asp-controller="Stock"
                                               asp-action="Movements"
                                               asp-route-id="@stock.StoneId"
                                               class="item"
                                               data-bs-toggle="tooltip"
                                               title="Stok Hareketleri">

                                                <i class="fa-solid fa-clock-rotate-left"></i>

                                            </a>

                                            @if (stock.IsActive &&
                                                            (User.IsInRole("Admin") ||
                                                             User.IsInRole("Manager")))
                                            {
                                                <!-- Manuel stok düzeltme -->
                                                <a asp-controller="Stock"
                                                   asp-action="Adjustment"
                                                   asp-route-id="@stock.StoneId"
                                                   class="item"
                                                   data-bs-toggle="tooltip"
                                                   title="Stok Düzelt">

                                                    <i class="fa-solid fa-pen-to-square"></i>

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <!-- Sayfalama -->
            <div class="dt-pagination">

                <!-- Gösterilen kayıt bilgisi -->
                <span class="dt-pagination__info">

                    @if (totalCount == 0)
                    {
                        @:Sonuç yok
                    }
                    else
                    {
                        @:@firstItem–@lastItem / @totalCount kayıt
                    }

                </span>

                <!-- Sayfa navigasyonu -->
                <div class="dt-pagination__nav">

                    <!-- Önceki sayfa -->
                    @if (page > 1)
                    {
                        <a asp-controller="Stock"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page - 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-left"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                disabled>

                            <i class="fa-solid fa-chevron-left"></i>

                        </button>
                    }

                    <!-- Sayfa numaraları -->
                    @if (totalPages > 0)
                    {
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            @if (i == page)
                            {
                                <button type="button"
                                        class="is-active"
                                        disabled>

                                    @i

                                </button>
                            }
                            else
                            {
                                <a asp-controller="Stock"
                                   asp-action="Index"
                                   asp-route-search="@search"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@pageSize">

                                    @i

                                </a>
                            }
                        }
                    }

                    <!-- Sonraki sayfa -->
                    @if (totalPages > 0 && page < totalPages)
                    {
                        <a asp-controller="Stock"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@(page + 1)"
                           asp-route-pageSize="@pageSize">

                            <i class="fa-solid fa-chevron-right"></i>

                        </a>
                    }
                    else
                    {
                        <button type="button"
                                disabled>

                            <i class="fa-solid fa-chevron-right"></i>

                        </button>
                    }

                </div>

            </div>

        </section>

    </div>
</div>
